  "sources": [
    {
      "board": "brd_uno",
      "content": "const int LED_PIN = 12;\n\nvoid setup() {\n  pinMode(LED_PIN, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(LED_PIN, HIGH);\n  delay(500);\n  digitalWrite(LED_PIN, LOW);\n  delay(500);\n}\n",
      "id": "src_blink",
      "language": "arduino-cpp",
      "path": "blink.ino",
      "role": "firmware"
    }
  ],
