  "behaviour": {
    "summary": {
      "en": "An active sensor that drives its output from its own supply, valid between 2.7 V and 7 V. The output is held at the default temperature's voltage."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "PLUS_VS",
          "VOUT",
          "GND"
        ],
        "summary": {
          "en": "A supply draw, and an output pulled to the held voltage through 20 ohms while the supply is in range."
        },
        "model": {
          "kind": "element",
          "element": "sensor",
          "terminals": {
            "supply_pos": "PLUS_VS",
            "supply_neg": "GND",
            "out": "VOUT"
          },
          "params": {
            "out_volts": {
              "from_rating": "output_default",
              "pick": "value"
            },
            "vmin": {
              "from_rating": "supply_min",
              "pick": "value"
            },
            "vabs": {
              "from_rating": "supply_abs_max",
              "pick": "value"
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "reverse_supply",
      "name": {
        "en": "Destroyed by a reversed supply"
      },
      "cause_id": "reverse-polarity",
      "symptom_ids": [
        "part-dead",
        "part-hot"
      ],
      "when": [
        {
          "measure": "pin_voltage_reverse",
          "target": "PLUS_VS",
          "op": ">",
          "threshold": {
            "literal": {
              "unit": "V",
              "value": 0.5
            }
          },
          "for": {
            "unit": "s",
            "value": 3
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "The sensor gets hot and stops working."
        }
      },
      "derivation": {
        "en": "The solver counts the seconds the supply is more than 0.5 V negative and burns the part after 3 s. The 0.5 V and 3 s are iynk choices; the fact sheet only says it gets very hot within seconds."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:372"
      },
      "implemented_as": "threshold"
    },
    {
      "id": "overvoltage",
      "name": {
        "en": "Destroyed by too high a supply"
      },
      "cause_id": "x-supply-overvoltage",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_voltage",
          "target": "PLUS_VS",
          "op": ">",
          "threshold": {
            "rating": "supply_abs_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "The solver burns the sensor when the supply is above 7 V."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:372"
      },
      "implemented_as": "threshold"
    }
  ],
