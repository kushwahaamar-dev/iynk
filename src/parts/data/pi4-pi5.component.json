    "summary": {
      "i18n_key": "parts.pi4-pi5.summary",
      "en": "The board runs the user's program in the iynk interpreter, in Python with gpiozero. It is a Python API model, not Raspberry Pi OS. Pins, PWM, I2C and timing follow the pi4-pi5 board profile."
    },
    "layers": [
      {
        "id": "mcu",
        "domain": "digital",
        "summary": {
          "i18n_key": "parts.pi4-pi5.layer",
          "en": "Firmware runtime."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The firmware runtime (iynk-interp, profile pi4-pi5 in src/lib/interp/profiles.ts) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T0",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "i18n_key": "parts.pi4-pi5.models.1",
        "en": "Python subset run by the interpreter with the Raspberry Pi BCM pin numbers (GPIO17 is physical pin 11)."
      },
      {
        "i18n_key": "parts.pi4-pi5.models.2",
        "en": "Digital I/O, PWM and edge callbacks on GPIO0 to GPIO27 through gpiozero, and RPi.GPIO on the Pi 4."
      },
      {
        "i18n_key": "parts.pi4-pi5.models.3",
        "en": "I2C master on GPIO2 and GPIO3 and serial output. The Pi 4 and the Pi 5 differ only in clock speed."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.pi4-pi5.not.1",
        "en": "Linux, the desktop and Raspberry Pi OS: this is a Python API model, not an operating system."
      },
      {
        "i18n_key": "parts.pi4-pi5.not.2",
        "en": "The camera, display, network, USB and PCI Express stacks."
      },
      {
        "i18n_key": "parts.pi4-pi5.not.3",
        "en": "Analog inputs: the board has none, so an ADC chip such as the MCP3008 is needed."
      }
    ],
