    "description": {
      "i18n_key": "parts.buzzer-piezo.description",
      "en": "A 12 mm round buzzer. The passive kind plays the pitch of tone(); the active kind makes its own tone from a steady HIGH."
    },
    "primary_source": "factsheet",
    "legacy_ids": [
      "piezo-buzzer"
    ],
    "tags": [
      "buzzer",
      "piezo",
      "sound",
