  "parameters": [
    {
      "id": "demo",
      "name": {
        "en": "Show"
      },
      "kind": "environment",
      "type": "enum",
      "default": "stopped",
      "values": [
        "stopped",
        "half",
        "full",
        "reversed",
        "burnt"
      ]
    }
  ],
  "behaviour": {
    "summary": {
      "en": "A brushless fan as a motor element with start and stop voltages and a burn-out limit."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "PLUS",
          "MINUS"
        ],
        "summary": {
          "en": "A motor element with the resistance of 5 V over the nominal current, a start and stop voltage and a burn-out limit."
        },
        "model": {
          "kind": "element",
          "element": "motor",
          "terminals": {
            "a": "PLUS",
            "b": "MINUS"
          },
          "params": {
            "ohms": {
              "from_rating": "equivalent_resistance",
              "pick": "value",
              "unit": "ohm"
            },
            "vstart": {
              "from_rating": "start_voltage",
              "pick": "value",
              "unit": "V"
            },
            "vstop": {
              "from_rating": "stop_voltage",
              "pick": "value",
              "unit": "V"
            },
            "vmax": {
              "from_rating": "max_voltage",
              "pick": "value",
              "unit": "V"
            },
            "inductive": {
              "value": true,
              "rationale": {
                "en": "The stator coils are inductive, so a transistor that switches the fan off makes a spike."
              },
              "source": {
                "src": "figurejs",
                "loc": "figures/parts/fan.js:54"
              }
            }
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "en": "A brushless fan as a motor element that stalls below 2.5 V average and runs above it."
      },
      {
        "en": "A driver chip that fails above 6.5 V."
      },
      {
        "en": "A switch-off spike when no flyback diode is across the fan."
      }
    ],
    "not_modelled": [
      {
        "en": "Speed as a function of voltage inside the solver: the figure draws it, the element reads no speed."
      },
      {
        "en": "Airflow, noise and the Hall sensor."
      }
    ],
    "validity": [
      {
        "measure": "average voltage",
        "min": 1.8,
        "max": 6.5,
        "unit": "V"
      }
    ],
    "known_gaps": [
      {
        "id": "constants_unsourced",
        "text": {
          "en": "Every number is a figure constant with no source. The ratings the figure cites came from distributor listings that nobody read for this file, so all sit in the simulation slot."
        }
      },
      {
        "id": "reverse_polarity_not_in_model",
        "text": {
          "en": "The figure sets polar: true and draws a fan that does not spin when reversed, but the motor element has no polarity rule, so this part lists no reverse-polarity failure mode."
        },
        "evidence": "figures/parts/fan.js:54"
      },
      {
        "id": "no_numeric_test",
        "text": {
          "en": "No test checks a number. Motors, servos and steppers have no golden-trace shape, so the one fixture only checks that the layers resolve and every pin and rating is wired."
        }
      }
    ],
    "solver_requires": [
      "motor"
    ],
    "tests": [
      {
        "id": "conformance",
        "kind": "conformance",
        "file": "src/parts/data/tests/fan.conformance.json",
        "note": "Layers resolve, terminals are pins, every rating has its slot."
      }
    ]
  },
