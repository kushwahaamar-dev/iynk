  "behaviour": {
    "summary": {
      "i18n_key": "parts.nodemcu.summary",
      "en": "The board runs the user's sketch in the iynk interpreter. Pins, PWM, I2C, serial and timing follow the nodemcu board profile. It is not the ESP8266 chip."
    },
    "layers": [
      {
        "id": "mcu",
        "domain": "digital",
        "summary": {
          "i18n_key": "parts.nodemcu.layer",
          "en": "Firmware runtime."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The firmware runtime (iynk-interp, profile nodemcu in src/lib/interp/profiles.ts) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "i18n_key": "parts.nodemcu.models.1",
        "en": "Arduino-C++ subset run by the interpreter with the NodeMCU pin map, where D4 is GPIO2."
      },
      {
        "i18n_key": "parts.nodemcu.models.2",
        "en": "Digital I/O on D0 to D8, TX, RX, SD2 and SD3, PWM on every GPIO, interrupts on every GPIO except GPIO16 (D0)."
      },
      {
        "i18n_key": "parts.nodemcu.models.3",
        "en": "10-bit analog read on A0 through the board divider, I2C master on D2 and D1, serial output, and the two active-low LEDs on GPIO2 and GPIO16."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.nodemcu.not.1",
        "en": "The Xtensa L106 core, the Wi-Fi stack and flash behaviour. The request stub for web-server lessons is not a radio."
      },
      {
        "i18n_key": "parts.nodemcu.not.2",
        "en": "The boot-mode pins GPIO0, GPIO2 and GPIO15."
      },
      {
        "i18n_key": "parts.nodemcu.not.3",
        "en": "The CP2102 bridge and the 3.3 V regulator limits."
      }
    ],
    "known_gaps": [
      {
        "id": "no_ratings",
        "text": {
          "i18n_key": "parts.nodemcu.gap",
          "en": "The on-board LEDs are active low: digitalWrite(LED_BUILTIN, LOW) turns them on. D-numbers are not GPIO numbers: D4 is GPIO2. A0 reads 0 to 3.3 V through a divider, and GPIO16 has no interrupt. No electrical ratings are listed yet, so no pin-overload check exists for this board."
        }
      }
    ],
    "tests": [
      {
        "id": "profile_run",
        "kind": "conformance",
        "file": "src/lib/interp/headless.test.ts",
        "state": "present",
        "note": "Runs a sketch on the nodemcu profile."
      }
    ]
  },
