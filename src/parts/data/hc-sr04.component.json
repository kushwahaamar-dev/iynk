  "behaviour": {
    "summary": {
      "en": "A trigger pulse of 10 microseconds or more makes the board send eight cycles at 40 kHz. About 200 microseconds later Echo goes HIGH and stays HIGH for the round trip, 58 microseconds per centimetre from 2 cm to 4 m, or 38 ms when nothing returns."
    },
    "layers": [
      {
        "id": "ranger",
        "domain": "protocol",
        "reads": [
          "TRIG",
          "VCC"
        ],
        "summary": {
          "en": "Pulse-width ranging on two pins."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The ping and echo timing is class HcSr04 in src/lib/interp/devices.ts, which the sketch interpreter wires to two pins by its class name. It is not a registered device, so the Studio does not bind it to this descriptor yet."
          }
        },
        "drives": [
          "ECHO"
        ]
      }
    ]
  },
