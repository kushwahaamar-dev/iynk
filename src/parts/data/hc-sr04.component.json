    "tier": "none",
    "status": "not-modelled-yet",
    "what_it_models": [
      {
        "en": "Nothing in the Studio yet. The sketch interpreter runs class HcSr04: a 10 microsecond trigger starts a ping and Echo is HIGH for 58.3 microseconds per centimetre."
      }
    ],
    "not_modelled": [
      {
        "en": "The transmit driver, the receive amplifier and the comparator: the board is treated as two pins."
      },
      {
        "en": "Soft and angled targets, the 15 degree beam and the speed of sound changing with temperature."
      },
      {
        "en": "A clone whose Echo stays HIGH after a missed ping, and the HC-SR04P 3.3 V variant."
      },
      {
        "en": "Damage from reversed or too high a supply."
      }
    ],
