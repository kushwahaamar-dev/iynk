        ],
        "drives": [
          "OUT1A",
          "OUT1B",
          "OUT2A",
          "OUT2B"
        ],
        "summary": {
          "en": "Step translator, current limit and two H-bridges driving two coils."
        },
        "model": {
          "kind": "none",
