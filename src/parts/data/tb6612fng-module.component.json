  "behaviour": {
    "summary": {
      "en": "Per channel, IN1 and IN2 pick forward, reverse, short brake or stop, and PWM high drives while PWM low short-brakes, so speed follows duty. STBY low turns every output off. The Studio does not run this yet."
    },
    "layers": [
      {
        "id": "bridges",
        "domain": "analog",
        "reads": [
          "AIN1",
          "AIN2",
          "PWMA",
          "BIN1",
          "BIN2",
          "PWMB",
          "STBY",
          "VM",
          "VCC"
        ],
        "drives": [
          "A01",
          "A02",
          "B01",
          "B02"
        ],
        "summary": {
          "en": "Two H-bridges as a function of the input levels."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The bridge model is a function in the figure page, and the Studio solver has no bridge element yet."
          }
        }
      }
    ]
  },
