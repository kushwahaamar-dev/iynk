  "behaviour": {
    "summary": {
      "i18n_key": "parts.esp32-devkitc.summary",
      "en": "The board runs the user's sketch in the iynk interpreter. Pins, PWM, I2C, serial and timing follow the esp32-devkitc board profile. It is not the ESP32 chip."
    },
    "layers": [
      {
        "id": "mcu",
        "domain": "digital",
        "summary": {
          "i18n_key": "parts.esp32-devkitc.layer",
          "en": "Firmware runtime."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The firmware runtime (iynk-interp, profile esp32-devkitc in src/lib/interp/profiles.ts) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T0",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "i18n_key": "parts.esp32-devkitc.models.1",
        "en": "Arduino-C++ subset run by the interpreter with the ESP32-DevKitC pin map."
      },
      {
        "i18n_key": "parts.esp32-devkitc.models.2",
        "en": "Digital I/O on the GPIO pins the board exposes, PWM and interrupts on every output-capable pin."
      },
      {
        "i18n_key": "parts.esp32-devkitc.models.3",
        "en": "12-bit analog reads against 3.3 V, I2C master on GPIO21 and GPIO22, serial output, and the BOOT button on GPIO0."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.esp32-devkitc.not.1",
        "en": "The two Xtensa cores and FreeRTOS tasks."
      },
      {
        "i18n_key": "parts.esp32-devkitc.not.2",
        "en": "Wi-Fi, Bluetooth and flash behaviour. The request stub for web-server lessons is not a radio."
      },
      {
        "i18n_key": "parts.esp32-devkitc.not.3",
        "en": "The strapping-pin traps such as GPIO12 high at reset."
      },
      {
        "i18n_key": "parts.esp32-devkitc.not.4",
        "en": "The 3.3 V regulator limits and the USB-UART bridge."
      }
    ],
    "known_gaps": [
      {
        "id": "no_ratings",
        "text": {
          "i18n_key": "parts.esp32-devkitc.gap",
          "en": "The board has no user LED and no LED_BUILTIN: the starter wires an external LED and resistor to GPIO23. GPIO34 to GPIO39 are inputs only, and ADC2 pins cannot be read while Wi-Fi is on. No electrical ratings are listed yet, so no pin-overload check exists for this board."
        }
      }
    ],
    "tests": [
      {
        "id": "profile_run",
        "kind": "conformance",
        "file": "src/lib/interp/headless.test.ts",
        "state": "present",
        "note": "Runs a sketch on the esp32-devkitc profile."
      }
    ]
  },
