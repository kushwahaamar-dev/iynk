        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The firmware runtime (iynk-interp, profile esp32-s3-devkitc-1 in src/lib/interp/profiles.ts) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
