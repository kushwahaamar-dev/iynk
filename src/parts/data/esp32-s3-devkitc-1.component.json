    "summary": {
      "i18n_key": "parts.esp32-s3-devkitc-1.summary",
      "en": "The board runs the user's sketch in the iynk interpreter. Pins, PWM, I2C, serial and timing follow the esp32-s3-devkitc-1 board profile. It is not the ESP32-S3 chip."
    },
