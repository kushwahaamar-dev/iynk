  "simulation": {
    "tier": "T0",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.models.1",
        "en": "Arduino-C++ subset run by the interpreter with the ESP32-S3-DevKitC-1 pin map."
      },
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.models.2",
        "en": "Digital I/O on GPIO0 to GPIO21 and GPIO35 to GPIO48, PWM and interrupts on every output-capable pin."
      },
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.models.3",
        "en": "12-bit analog reads on GPIO1 to GPIO20, I2C master on GPIO8 and GPIO9, serial output, rgbLedWrite on the RGB LED (GPIO38 on v1.1, GPIO48 on v1.0) and the BOOT button on GPIO0."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.not.1",
        "en": "The two Xtensa LX7 cores and FreeRTOS tasks."
      },
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.not.2",
        "en": "Wi-Fi, Bluetooth and flash behaviour. The request stub for web-server lessons is not a radio."
      },
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.not.3",
        "en": "The strapping-pin traps and the native USB port."
      },
      {
        "i18n_key": "parts.esp32-s3-devkitc-1.not.4",
        "en": "The 3.3 V regulator limits."
      }
    ],
    "known_gaps": [
      {
        "id": "no_ratings",
        "text": {
          "i18n_key": "parts.esp32-s3-devkitc-1.gap",
          "en": "The RGB LED is a WS2812 that sits on GPIO38 on v1.1 and on GPIO48 on v1.0; pick the variant that matches your board. ADC2 pins (GPIO11 to GPIO20) cannot be read while Wi-Fi is on. No electrical ratings are listed yet, so no pin-overload check exists for this board."
        }
      }
    ],
