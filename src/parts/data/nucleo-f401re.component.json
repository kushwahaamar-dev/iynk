      },
      {
        "i18n_key": "parts.nucleo-f401re.models.2",
        "en": "Digital I/O on D0 to D15 and A0 to A5, PWM on D3, D5, D6, D9, D10 and D11, interrupts on every pin."
      },
      {
        "i18n_key": "parts.nucleo-f401re.models.3",
        "en": "10-bit analog reads, or 12-bit after analogReadResolution(12), I2C master on D14 and D15, serial output, LD2 on D13 and the B1 USER button on PC13."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.nucleo-f401re.not.1",
        "en": "The ST-LINK debugger and the USB virtual serial port."
      },
