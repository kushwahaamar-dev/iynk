  "behaviour": {
    "summary": {
      "en": "A switch that closes when base current flows. It saturates when the load needs less current than the gain times the base current allows."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "B",
          "C",
          "E"
        ],
        "summary": {
          "en": "Bipolar transistor: the base-emitter junction drops a fixed voltage, the collector current is the gain times the base current until the collector-emitter drop reaches its saturation value."
        },
        "model": {
          "kind": "element",
          "element": "npn",
          "terminals": {
            "b": "B",
            "c": "C",
            "e": "E"
          },
          "params": {
            "hfe": {
              "from_rating": "current_gain",
              "pick": "value"
            },
            "hfr": {
              "from_rating": "current_gain_reverse",
              "pick": "value"
            },
            "vbe": {
              "from_rating": "base_emitter_voltage",
              "pick": "value"
            },
            "vcesat": {
              "from_rating": "collector_emitter_saturation",
              "pick": "value"
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "overtemperature",
      "name": {
        "en": "Fails open when the junction gets too hot"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-hot",
        "part-dead"
      ],
      "when": [
        {
          "measure": "junction_temperature",
          "target": "part",
          "op": ">",
          "threshold": {
            "rating": "junction_temperature_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "open_circuit",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "The transistor stops conducting and stays open."
        }
      },
      "derivation": {
        "en": "The junction temperature is 25 degC plus the thermal resistance times the power. The rule is the simulator's own and has not been tested against hardware."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:341"
      },
      "implemented_as": "threshold"
    },
    {
      "id": "overcurrent",
      "name": {
        "en": "Fails open when the collector current is far too high"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_current_peak",
          "target": "C",
          "op": ">",
          "threshold": {
            "rating": "collector_current_max",
            "pick": "value",
            "factor": 1.5
          }
        }
      ],
      "effect": {
        "state": "open_circuit",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "The transistor stops conducting and stays open."
        }
      },
      "derivation": {
        "en": "The solver fails the part when the peak collector current is above 1.5 times the continuous rating. The factor is iynk's own teaching rule and has no source."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:341"
      },
      "implemented_as": "threshold"
    }
  ],
