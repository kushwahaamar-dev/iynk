      "id": "humidity",
      "name": {
        "en": "Relative humidity"
      },
      "unit": "percent",
      "axes": 1,
      "range": {
        "min": 0,
        "max": 100
      },
      "world_channel": "environment.humidity"
    }
  ],
  "behaviour": {
    "summary": {
      "en": "A register-level I2C slave at 0x76 (SDO low) or 0x77 (SDO high) with chip ID 0x60. It answers only with CSB high and VCC from 1.71 to 3.6 V, and returns raw words made from the temperature, pressure and humidity inputs."
    },
    "layers": [
      {
        "id": "sensor",
        "domain": "protocol",
        "reads": [
          "SCL",
          "SDA",
          "SDO",
          "CSB",
          "temperature",
          "pressure",
          "humidity"
        ],
        "drives": [
          "SDA"
        ],
        "summary": {
          "en": "I2C data-only device."
        },
        "model": {
          "kind": "builtin",
          "ref": "device:i2c/bme280@1",
          "params": {},
          "implementation": {
            "note": "src/sim/devices/bme280.ts with the descriptor src/sim/devices/data/bme280.device.json."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "en": "The I2C slave answers at its address and returns raw temperature, pressure and humidity words that the Bosch integer compensation turns back into the inputs."
      },
      {
        "en": "Conversion time, forced and normal mode, standby time, soft reset, and CTRL_HUM taking effect at the next CTRL_MEAS write."
      }
    ],
    "not_modelled": [
      {
        "en": "SPI mode (CSB low), the IIR filter, self-heating, sleep current, and sensor thermal lag."
      },
      {
        "en": "Damage above the 4.25 V maximum."
      },
      {
        "en": "A BMP280 look-alike board that reads chip ID 0x58 and has no humidity."
      },
      {
        "en": "The calibration words are a synthetic set, not a dump from a physical chip."
      }
    ],
    "tests": [
      {
        "id": "chip_id",
        "kind": "datasheet-point",
        "file": "src/sim/devices/bme280.test.ts",
        "state": "to-write",
        "note": "Chip ID register 0xD0 reads 0x60."
      }
    ]
  },
  "software": {
    "environments": [
      {
        "language": "arduino-cpp",
        "libraries": [
          {
            "name": "Adafruit BME280 Library",
            "version": "2.2.4",
            "install": "Adafruit BME280 Library",
            "iynk_support": "supported",
            "note": {
              "en": "Modelled: begin, readTemperature, readHumidity, readPressure, readAltitude and sensorID. setSampling and the Adafruit_Sensor event interface are not."
            }
          },
          {
            "name": "Wire",
            "install": "built in",
            "iynk_support": "supported"
          }
        ]
      }
    ]
  },
  "compatibility": {
    "rules": [
      {
        "id": "supply_window",
        "kind": "voltage_window",
        "severity": "error",
        "params": {
          "pin": "VCC",
          "rating": "supply_abs_max"
        },
        "message": {
          "en": "This breakout has no regulator. Above 3.6 V is out of range and 4.25 V is the absolute maximum."
        }
      }
    ]
  },
