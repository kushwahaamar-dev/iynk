  "behaviour": {
    "summary": {
      "en": "Three LEDs sharing one cathode lead. Each colour conducts above its own forward voltage with a small series resistance."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "R",
          "COM",
          "G",
          "B"
        ],
        "summary": {
          "en": "Three piecewise-linear diodes from each colour lead to the common lead."
        },
        "model": {
          "kind": "subcircuit",
          "instances": [
            {
              "id": "led_r",
              "element": "led",
              "params": {
                "vf": {
                  "from_rating": "forward_voltage_red",
                  "pick": "typ"
                },
                "rd": {
                  "from_rating": "dynamic_resistance",
                  "pick": "value"
                },
                "imax": {
                  "from_rating": "forward_current_continuous",
                  "pick": "value"
                }
              }
            },
            {
              "id": "led_g",
              "element": "led",
              "params": {
                "vf": {
                  "from_rating": "forward_voltage_green",
                  "pick": "typ"
                },
                "rd": {
                  "from_rating": "dynamic_resistance",
                  "pick": "value"
                },
                "imax": {
                  "from_rating": "forward_current_continuous",
                  "pick": "value"
                }
              }
            },
            {
              "id": "led_b",
              "element": "led",
              "params": {
                "vf": {
                  "from_rating": "forward_voltage_blue",
                  "pick": "typ"
                },
                "rd": {
                  "from_rating": "dynamic_resistance",
                  "pick": "value"
                },
                "imax": {
                  "from_rating": "forward_current_continuous",
                  "pick": "value"
                }
              }
            }
          ],
          "nets": [
            {
              "id": "red",
              "nodes": [
                "pin:R",
                "led_r.anode"
              ]
            },
            {
              "id": "green",
              "nodes": [
                "pin:G",
                "led_g.anode"
              ]
            },
            {
              "id": "blue",
              "nodes": [
                "pin:B",
                "led_b.anode"
              ]
            },
            {
              "id": "common",
              "nodes": [
                "pin:COM",
                "led_r.cathode",
                "led_g.cathode",
                "led_b.cathode"
              ]
            }
          ]
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "red_overcurrent_burn",
      "name": {
        "en": "Red die burned out by too much current"
      },
      "cause_id": "led-no-series-resistor",
      "symptom_ids": [
        "led-burnt"
      ],
      "when": [
        {
          "measure": "pin_current_peak",
          "target": "R",
          "op": ">",
          "threshold": {
            "rating": "forward_current_continuous",
            "pick": "value",
            "factor": 2.5
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "The colour goes dark and stays open."
        }
      },
      "derivation": {
        "en": "The solver burns a die when its peak current is more than 2.5 times its rated current. The factor is an iynk teaching rule, not a datasheet figure."
