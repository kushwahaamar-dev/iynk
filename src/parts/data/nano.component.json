  "behaviour": {
    "summary": {
      "i18n_key": "parts.nano.summary",
      "en": "The board runs the user's sketch in the iynk interpreter. Pins, PWM, I2C, serial and timing follow the nano board profile. It is not the ATmega328P chip."
    },
    "layers": [
      {
        "id": "mcu",
        "domain": "digital",
        "summary": {
          "i18n_key": "parts.nano.layer",
          "en": "Firmware runtime."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The firmware runtime (iynk-interp, profile nano in src/lib/interp/profiles.ts) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "i18n_key": "parts.nano.models.1",
        "en": "Arduino-C++ subset run by the interpreter with the Nano pin map."
      },
      {
        "i18n_key": "parts.nano.models.2",
        "en": "Digital I/O on D0 to D13 and A0 to A5, PWM on D3, D5, D6, D9, D10 and D11, interrupts on D2 and D3."
      },
      {
        "i18n_key": "parts.nano.models.3",
        "en": "10-bit analog reads against a 5 V reference on A0 to A7, I2C master on SDA and SCL, serial output, and the L LED on D13."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.nano.not.1",
        "en": "The AVR core, timers, bootloader and flash behaviour."
      },
      {
        "i18n_key": "parts.nano.not.2",
        "en": "The FT232RNL USB-serial bridge and the auto-reset circuit."
      },
      {
        "i18n_key": "parts.nano.not.3",
        "en": "The 5 V and 3.3 V regulators, the VIN limits and the brown-out level."
      },
      {
        "i18n_key": "parts.nano.not.4",
        "en": "EEPROM wear and the ICSP header."
      }
    ],
    "known_gaps": [
      {
        "id": "no_ratings",
        "text": {
          "i18n_key": "parts.nano.gap",
          "en": "A6 and A7 are analog inputs only: digitalRead and pinMode do not work on them. No electrical ratings are listed yet, so no pin-overload check exists for this board."
        }
      }
    ],
    "tests": [
      {
        "id": "profile_run",
        "kind": "conformance",
        "file": "src/lib/interp/headless.test.ts",
        "state": "present",
        "note": "Runs a sketch on the nano profile."
      }
    ]
  },
