  "behaviour": {
    "summary": {
      "en": "A resistor whose value is fixed at the default light level. The resistance does not follow the light in this model."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "P1",
          "P2"
        ],
        "summary": {
          "en": "Linear conductance between the two leads at the default 300 lux."
        },
        "model": {
          "kind": "element",
          "element": "res",
          "terminals": {
            "a": "P1",
            "b": "P2"
          },
          "params": {
            "ohms": {
              "from_rating": "resistance_default",
              "pick": "value"
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "overpower",
      "name": {
        "en": "Overheated by too much power"
      },
      "cause_id": "x-ldr-overpower",
      "symptom_ids": [
        "part-hot"
      ],
      "when": [
        {
          "measure": "part_power",
          "target": "part",
          "op": ">",
          "threshold": {
            "rating": "power_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "The figure states 100 mW as the limit and says a bare LDR across 5 V in daylight is over it. The solver stamps the resistor and checks no power, so nothing acts on this."
      },
      "basis": "manufacturer",
      "source": {
        "src": "factsheet",
        "loc": "section 8"
      },
      "implemented_as": "not-implemented"
    }
