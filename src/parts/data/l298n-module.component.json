  "behaviour": {
    "summary": {
      "en": "Per channel: enable high and IN1 different from IN2 drives the motor, equal inputs brake, enable low lets it coast. The motor sees the supply minus the switch drop. A regulator makes 5 V from the supply when its jumper is fitted."
    },
    "layers": [
      {
        "id": "bridges",
        "domain": "analog",
        "reads": [
          "IN1",
          "IN2",
          "IN3",
          "IN4",
          "ENA",
          "ENB",
          "VS",
          "ena_jumper",
          "enb_jumper"
        ],
        "drives": [
          "OUT1",
          "OUT2",
          "OUT3",
          "OUT4"
        ],
        "summary": {
          "en": "Two bipolar H-bridges as a closed-form function of the input levels and the supply."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The bridge is a function in the figure page. The Studio has no bridge model yet, so the outputs do not move."
          }
        }
      },
      {
        "id": "regulator",
        "domain": "power",
        "reads": [
          "VS",
          "reg_jumper"
        ],
        "drives": [
          "P5V"
        ],
        "summary": {
          "en": "78M05: output is 5 V, or the input minus the dropout when the input is too low."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The regulator rule lives in the figure engine's power tree. The solver has no regulator element yet."
          }
        }
      },
      {
        "id": "heat",
        "domain": "thermal",
        "reads": [
          "bridges"
        ],
        "summary": {
          "en": "Steady-state temperature: ambient plus dissipated power times the series thermal resistance."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The temperature is computed in the figure page only, and nothing in the Studio reads it."
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "overtemperature_cutout",
      "name": {
        "en": "Overtemperature cut-out on a stalled motor"
      },
      "cause_id": "motor-stall",
      "symptom_ids": [
        "x-motor-stutters",
        "part-hot"
      ],
      "when": [
        {
          "measure": "junction_temperature",
          "target": "part",
          "op": ">",
          "threshold": {
            "rating": "tj_max",
            "pick": "max"
          }
        }
      ],
      "effect": {
        "state": "thermal_cutout",
        "latched": false,
        "recovers_when": "the chip cools",
        "detail": {
          "en": "The outputs switch off, the motor coasts, and it restarts as the chip cools."
        }
      },
      "derivation": {
        "en": "The datasheet names overtemperature protection but gives no trip temperature, so the operating junction maximum of 130 C stands in for it. Today the cut-out is not evaluated from the computed junction temperature: it is a timer."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "figurejs",
        "loc": "figures/modules/l298n.js:56"
      },
      "implemented_as": "scripted",
      "hints": [
        {
          "level": 1,
          "text": {
            "en": "The motor runs, then stutters. Touch nothing yet: what is the motor being asked to do?"
          }
        },
        {
          "level": 2,
          "text": {
            "en": "Is the wheel blocked? A blocked motor draws its stall current."
          }
        },
        {
          "level": 3,
          "text": {
            "en": "The motor is stalled, the chip overheats and cuts out until it cools. Free the wheel or use a stronger driver."
          }
        }
      ]
    },
    {
      "id": "reversed_supply_burn",
      "name": {
        "en": "Burned by a reversed supply"
      },
      "cause_id": "reverse-polarity",
      "symptom_ids": [
        "part-dead",
        "part-hot"
      ],
      "when": [
        {
          "measure": "pin_voltage_reverse",
          "target": "VS",
          "op": ">",
          "threshold": {
            "literal": {
              "unit": "V",
              "value": 1.4
            }
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the module is replaced",
        "detail": {
          "en": "The regulator, which the supply reaches first, fails."
        }
      },
      "derivation": {
        "en": "Reverse voltage forward-biases two series diodes, D5-D8 then D1-D4, so it conducts above about two diode drops. The 1.4 V value is two drops of 0.7 V, an iynk estimate. In the engine the burn is triggered by the injected fault flag, not by this voltage."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "facts",
        "loc": "section 6, reverse polarity"
      },
      "implemented_as": "scripted"
    },
    {
      "id": "supply_too_high",
      "name": {
        "en": "Regulator and capacitor over-voltage"
      },
      "cause_id": "x-l298n-supply-too-high",
      "symptom_ids": [
        "part-hot",
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_voltage",
          "target": "VS",
          "op": ">",
          "threshold": {
            "rating": "vs_module_max",
            "pick": "max"
          }
        }
      ],
      "effect": {
        "state": "burnt",
        "latched": true,
        "recovers_when": "the module is replaced",
        "detail": {
          "en": "The 78M05 fails, often short, and can put the motor supply onto the +5V rail."
        }
      },
      "derivation": {
        "en": "The 78M05 takes 35 V at most and the capacitor on VS is a 35 V part. The rule applies while the 5V-EN jumper is fitted; with it removed the L298 limit of 46 V applies."
      },
      "basis": "manufacturer",
      "source": {
        "src": "facts",
        "loc": "Features: input voltage"
      },
      "implemented_as": "not-implemented"
    },
    {
      "id": "supply_too_low",
      "name": {
        "en": "Logic starved by a low supply"
      },
      "cause_id": "x-l298n-supply-too-low",
      "symptom_ids": [
        "x-motors-dead",
        "mcu-resets"
      ],
      "when": [
        {
          "measure": "pin_voltage",
          "target": "VS",
          "op": "<",
          "threshold": {
            "rating": "vs_min_for_logic",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "reset",
        "latched": false,
        "recovers_when": "the supply rises above the threshold",
        "detail": {
          "en": "The logic supply falls below 4.5 V, so the module and a controller powered from it stop."
        }
      },
      "derivation": {
        "en": "VSS minimum 4.5 V plus a 2 V regulator dropout, 6.5 V. See vs_min_for_logic."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "figurejs",
        "loc": "figures/modules/l298n.js: power.mcu min"
      },
      "implemented_as": "not-implemented"
    }
  ],
