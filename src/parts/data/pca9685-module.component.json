  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "en": "An I2C slave at 0x40 with the register map the libraries use: MODE1 with its sleep and auto-increment bits, PRE_SCALE and sixteen on and off counts."
      },
      {
        "en": "PRE_SCALE is ignored unless MODE1 SLEEP is set, and the chip powers up asleep at 200 Hz with every output off."
      },
      {
        "en": "The duty and pulse width of each channel, worked out from the counts and the 25 MHz oscillator, with the full-on and full-off bits."
      }
    ],
    "not_modelled": [
      {
        "en": "The oscillator error: the clock is a fixed 25 MHz, where a board runs between 23 and 27 MHz."
      },
      {
        "en": "The All Call address 0x70 and the software reset call."
      },
      {
        "en": "The OE pin, MODE2 and the output drive mode, and the voltage on the outputs."
      },
      {
        "en": "The servo supply, the reverse-polarity MOSFET, the power LED and the jumpers on the address pins."
      }
    ],
    "known_gaps": [
      {
        "id": "ideal_oscillator",
        "text": {
          "en": "The model's oscillator is 25 MHz with no error, so a program that calibrates it sees no effect."
        },
        "evidence": "src/lib/interp/devices.ts:104-176"
      },
      {
        "id": "no_numeric_test",
        "text": {
          "en": "There is no numeric test of the pulse width or the frequency; only the conformance checks run."
        },
        "evidence": "src/parts/data/tests/pca9685-module.conformance.json"
      }
    ],
    "solver_requires": [],
    "tests": [
      {
        "id": "conformance",
        "kind": "conformance",
        "file": "src/parts/data/tests/pca9685-module.conformance.json",
        "state": "present",
        "note": "device:pca9685@1 resolves to a registered hook and every rating a layer reads has its slot."
      }
    ]
  },
