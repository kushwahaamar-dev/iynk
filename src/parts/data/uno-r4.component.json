  "behaviour": {
    "summary": {
      "i18n_key": "parts.uno-r4.summary",
      "en": "The board runs the user's sketch in the iynk interpreter. Pins, PWM, I2C, serial and timing follow the uno-r4 board profile. It is not the Renesas RA4M1 chip."
    },
    "layers": [
      {
        "id": "mcu",
        "domain": "digital",
        "summary": {
          "i18n_key": "parts.uno-r4.layer",
          "en": "Firmware runtime."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The firmware runtime (iynk-interp, profile uno-r4 in src/lib/interp/profiles.ts) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T0",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "i18n_key": "parts.uno-r4.models.1",
        "en": "Arduino-C++ subset run by the interpreter with the UNO R4 pin map, 32-bit int and 64-bit double."
      },
      {
        "i18n_key": "parts.uno-r4.models.2",
        "en": "Digital I/O on D0 to D13 and A0 to A5, PWM on D3, D5, D6, D9, D10 and D11, interrupts on D2 and D3."
      },
      {
        "i18n_key": "parts.uno-r4.models.3",
        "en": "Analog reads up to 14 bits with analogReadResolution, I2C master on SDA and SCL, serial output, and the L LED on D13."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.uno-r4.not.1",
        "en": "Renesas peripherals other than digital I/O, I2C and serial."
      },
      {
        "i18n_key": "parts.uno-r4.not.2",
        "en": "The 12x8 LED matrix library and the ESP32-S3 radio of the WiFi variant."
      },
      {
        "i18n_key": "parts.uno-r4.not.3",
        "en": "The DAC on A0 as an analog output value."
      },
      {
        "i18n_key": "parts.uno-r4.not.4",
        "en": "The 8 mA pin source limit is not enforced."
      }
    ],
    "known_gaps": [
      {
        "id": "wifi_variant",
        "text": {
          "i18n_key": "parts.uno-r4.gap",
          "en": "The WiFi variant is modelled as the Minima: the LED matrix and the radio do nothing. No electrical ratings are listed yet, so no pin-overload check exists for this board."
        }
      }
    ],
    "tests": [
      {
        "id": "profile_run",
        "kind": "conformance",
        "file": "src/lib/interp/headless.test.ts",
        "state": "present",
        "note": "Runs a sketch on the uno-r4 profile."
      }
    ]
  },
  "software": {
    "environments": [
      {
        "language": "arduino-cpp",
        "libraries": [
