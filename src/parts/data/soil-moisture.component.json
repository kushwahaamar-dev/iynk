  "behaviour": {
    "summary": {
      "en": "A 555 timer at about 1.5 MHz drives the probe pad, which is one plate of a capacitor with the soil as the other. Wetter soil lowers the amplitude, and a peak detector turns it into a DC level on AOUT: about 2.6 V in dry air and 1.4 V in water."
    },
    "layers": [
      {
        "id": "probe",
        "domain": "analog",
        "reads": [
          "moisture",
          "VCC"
        ],
        "summary": {
          "en": "A capacitive probe read through a peak detector."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The output comes from a 555 oscillator, a probe capacitance and a peak detector. The figure page maps the moisture setting to a voltage; the solver has no element for that mapping."
          }
        },
        "drives": [
          "AOUT"
        ]
      }
    ]
  },
  "simulation": {
    "tier": "none",
    "status": "not-modelled-yet",
    "what_it_models": [
      {
        "en": "Nothing in the Studio yet. The figure page maps the moisture setting to an output voltage between the dry and wet levels."
      }
    ],
    "not_modelled": [
      {
        "en": "The 555 oscillator, the probe capacitance and the peak detector."
      },
      {
        "en": "The NE555 clone that needs 4.5 V and sticks on a 3.3 V rail, which the figure offers as a variant."
      },
      {
        "en": "A missing bleed resistor, which makes the reading stick at the driest value."
      },
      {
        "en": "Damage from water on the electronics."
      }
    ],
