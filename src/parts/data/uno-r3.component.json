          "reason": {
            "en": "The firmware runtime (iynk-interp, profile uno-r3 in src/lib/interp/profiles.ts:102) is attached to the board by the project's simulation.runtimes, not by a solver layer."
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "en": "Arduino-C++ subset run by the interpreter with the Uno pin map."
      },
      {
        "en": "Digital I/O on D0 to D13 and A0 to A5, PWM on D3, D5, D6, D9, D10 and D11, interrupts on D2 and D3."
      },
      {
        "en": "10-bit analog reads against a 5 V reference, I2C master on SDA and SCL, serial output, and the L LED on D13."
      }
    ],
    "not_modelled": [
      {
        "en": "The AVR core, timers, bootloader and flash behaviour."
      },
      {
        "en": "The 5 V and 3.3 V regulators, the USB power switch and the brown-out level."
      },
      {
        "en": "Pin current limits and the ICSP headers."
      }
    ],
    "known_gaps": [
