  "behaviour": {
    "summary": {
      "en": "An NPN Darlington switch: off below 1.3 V of base drive, saturated at 0.9 V when the base drives it hard enough, otherwise a current gain of 1000."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "B",
          "C",
          "E"
        ],
        "summary": {
          "en": "Piecewise-linear transistor with the Darlington drops."
        },
        "model": {
          "kind": "element",
          "element": "npn",
          "terminals": {
            "b": "B",
            "c": "C",
            "e": "E"
          },
          "params": {
            "hfe": {
              "from_rating": "current_gain",
              "pick": "value"
            },
            "hfr": {
              "from_rating": "reverse_gain",
              "pick": "value"
            },
            "vbe": {
              "from_rating": "base_emitter_voltage",
              "pick": "typ"
            },
            "vcesat": {
              "from_rating": "saturation_voltage",
              "pick": "typ"
            },
            "darlington": {
              "value": true,
              "rationale": {
                "en": "Only matters after burn-out: a burnt Darlington fails short C-E (bench-solve.js:232)."
              },
              "source": {
                "src": "solverjs",
                "loc": "figures/engine/bench-solve.js:232"
              }
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "overheat",
      "name": {
        "en": "Burned out by heat"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-hot"
      ],
      "when": [
        {
          "measure": "junction_temperature",
          "target": "part",
          "op": ">",
          "threshold": {
            "rating": "junction_temperature_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "short_circuit",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "A burnt Darlington fails short from collector to emitter."
        }
      },
      "derivation": {
        "en": "The solver works the junction temperature from power and 62.5 degrees C per watt and burns the part past 150 degrees C."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:341"
      },
      "implemented_as": "threshold"
    },
    {
      "id": "overcurrent",
      "name": {
        "en": "Burned out by too much collector current"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-hot"
      ],
      "when": [
        {
          "measure": "pin_current_peak",
          "target": "C",
          "op": ">",
          "threshold": {
            "rating": "collector_current_max",
            "pick": "value",
            "factor": 1.5
          }
        }
      ],
      "effect": {
        "state": "short_circuit",
        "latched": true,
        "recovers_when": "the part is replaced"
      },
      "derivation": {
        "en": "The solver burns the part when the peak collector current is more than 1.5 times the 5 A rating. The factor is an iynk teaching rule."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:341"
      },
      "implemented_as": "threshold"
    },
    {
      "id": "hot_in_free_air",
      "name": {
        "en": "Running hot without a heatsink"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-hot"
      ],
      "when": [
        {
          "measure": "part_power",
          "target": "part",
          "op": ">",
          "threshold": {
            "rating": "power_max",
            "pick": "value",
            "factor": 0.75
          }
        }
      ],
      "effect": {
        "state": "derated",
        "latched": false,
        "detail": {
          "en": "The part is flagged hot; nothing else changes."
        }
      },
      "derivation": {
        "en": "The solver flags the part hot above 75 percent of the free-air rating, 1.5 W. It is a label, not a burn-out; the 75 percent is an iynk choice."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:342"
      },
      "implemented_as": "scripted"
    }
  ],
