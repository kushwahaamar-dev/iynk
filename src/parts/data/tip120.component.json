  "behaviour": {
    "summary": {
      "en": "A Darlington switch: a small base current turns on a large collector current. The base needs about 1.3 V and the collector keeps about 0.9 V when fully on."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "B",
          "C",
          "E"
        ],
        "summary": {
          "en": "Bipolar transistor: the base-emitter junction drops a fixed voltage, the collector current is the gain times the base current until the collector-emitter drop reaches its saturation value."
        },
        "model": {
          "kind": "element",
          "element": "npn",
          "terminals": {
            "b": "B",
            "c": "C",
            "e": "E"
          },
          "params": {
            "hfe": {
              "from_rating": "current_gain",
              "pick": "value"
            },
            "hfr": {
              "from_rating": "current_gain_reverse",
              "pick": "value"
            },
            "vbe": {
              "from_rating": "base_emitter_voltage",
              "pick": "typ"
            },
            "vcesat": {
              "from_rating": "collector_emitter_saturation",
              "pick": "typ"
            }
          }
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "overtemperature",
      "name": {
        "en": "Fails short when the junction gets too hot"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-hot",
        "part-dead"
      ],
      "when": [
        {
          "measure": "junction_temperature",
          "target": "part",
          "op": ">",
          "threshold": {
            "rating": "junction_temperature_max",
            "pick": "value"
          }
        }
      ],
      "effect": {
        "state": "short_circuit",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "A burnt Darlington conducts from collector to emitter at about 0.1 ohm."
        }
      },
      "derivation": {
        "en": "The junction temperature is 25 degC plus 62.5 degC per watt times the power. The rule is the simulator's own and has not been tested against hardware."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:341"
      },
      "implemented_as": "threshold"
    },
    {
      "id": "overcurrent",
      "name": {
        "en": "Fails short when the collector current is far too high"
      },
      "cause_id": "x-npn-overheat",
      "symptom_ids": [
        "part-dead"
      ],
      "when": [
        {
          "measure": "pin_current_peak",
          "target": "C",
          "op": ">",
          "threshold": {
            "rating": "collector_current_max",
            "pick": "value",
            "factor": 1.5
          }
        }
      ],
      "effect": {
        "state": "short_circuit",
        "latched": true,
        "recovers_when": "the part is replaced",
        "detail": {
          "en": "A burnt Darlington conducts from collector to emitter at about 0.1 ohm."
        }
      },
      "derivation": {
        "en": "The solver fails the part when the peak collector current is above 1.5 times the continuous rating. The factor is iynk's own teaching rule and has no source."
      },
      "basis": "simulation-assumption",
      "source": {
        "src": "solverjs",
        "loc": "figures/engine/bench-solve.js:341"
      },
      "implemented_as": "threshold"
    }
  ],
