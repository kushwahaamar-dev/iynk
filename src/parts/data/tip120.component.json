  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "en": "A saturating Darlington switch with the stated minimum gain of 1000, a 1.3 V base drop and a 0.9 V saturation drop."
      },
      {
        "en": "A transistor fitted backwards, with a gain of 5 from collector to emitter."
      },
      {
        "en": "Failure by heat or by a collector peak above 1.5 times the current rating, with a burnt part shorting collector to emitter."
      },
      {
        "en": "A hot state above 0.75 times the free-air power rating, and an overdriven state above the base current rating."
      }
    ],
    "not_modelled": [
      {
        "en": "The two internal transistors and the 8 kilohm and 120 ohm resistors: the model sees one transistor."
      },
      {
        "en": "The change of base drop and saturation drop with current."
      },
      {
        "en": "The built-in diode some makers show from emitter to collector."
      },
      {
        "en": "A heatsink: the power rating is the free-air one."
      }
    ],
    "validity": [
