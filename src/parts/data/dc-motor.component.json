        "source": {
          "src": "figurejs",
          "loc": "figures/parts/dc-motor.js:66"
        },
        "rationale": {
          "en": "Average volts below which a running shaft stops. no source found; constant in figures/parts/dc-motor.js:66"
        }
      },
      "used_by_model": "simulation"
