      "values": [
        "prop",
        "free",
        "stalled"
      ],
      "affects": [
        "dc"
      ]
    },
    {
      "id": "demo",
      "name": {
        "en": "Show"
      },
      "kind": "environment",
      "type": "enum",
      "default": "stopped",
      "values": [
        "stopped",
        "half",
        "full",
        "reversed",
        "stalled",
        "burnt"
      ]
    }
  ],
  "mechanics": {
    "motor": {
      "r_ohm": 1.43,
      "ke_vs_per_rad": 0.002922,
      "source": {
        "src": "figurejs",
        "loc": "figures/parts/dc-motor.js:66"
      }
    }
  },
  "behaviour": {
    "summary": {
      "en": "A brushed DC motor read as a conductance between two leads, with start and stop voltages and a burn-out limit."
    },
    "layers": [
      {
        "id": "dc",
        "domain": "analog",
        "reads": [
          "PLUS",
          "MINUS",
          "load"
        ],
        "summary": {
          "en": "A conductance between the two leads, set from the current the motor takes at the voltage it sees."
        },
        "model": {
          "kind": "element",
          "element": "motor",
          "terminals": {
            "a": "PLUS",
            "b": "MINUS"
          },
          "params": {
            "ohms": {
              "from_rating": "armature_resistance",
              "pick": "value",
              "unit": "ohm"
            },
            "ke": {
              "from_rating": "back_emf_constant",
              "pick": "value"
            },
            "i0": {
              "from_rating": "no_load_current",
              "pick": "value",
              "unit": "A"
            },
            "iload": {
              "from_rating": "propeller_load_current",
              "pick": "value",
              "unit": "A"
            },
            "vstart": {
              "from_rating": "start_voltage",
              "pick": "value",
              "unit": "V"
            },
            "vstop": {
              "from_rating": "stop_voltage",
              "pick": "value",
              "unit": "V"
            },
            "vmax": {
              "from_rating": "max_voltage",
              "pick": "value",
              "unit": "V"
            },
            "inductive": {
              "value": true,
              "rationale": {
                "en": "The winding is an inductor, so switching it off without a flyback diode makes a spike."
              },
              "source": {
                "src": "figurejs",
                "loc": "figures/parts/dc-motor.js:66"
              }
            }
          }
        }
      }
    ]
  },
  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {
        "en": "A two-lead brushed motor that draws the no-load current plus the propeller current once it spins, starts above one volt average and stops below 0.6 V."
      },
      {
        "en": "Stall current of the supply voltage over the armature resistance when the shaft is held."
      },
      {
        "en": "A winding that burns out above 9 V and a switch-off spike when there is no flyback diode."
      }
    ],
    "not_modelled": [
      {
        "en": "Motor speed against torque beyond the propeller case, and the shaft inertia."
      },
      {
        "en": "Brush noise and the heat of the winding over time."
      }
    ],
    "validity": [
      {
        "measure": "average voltage",
        "min": 0.6,
        "max": 9,
        "unit": "V"
      }
    ],
    "known_gaps": [
      {
        "id": "constants_unsourced",
        "text": {
          "en": "Every number is a constant in the figure with no source. The fact sheet gives FA-130RA values and marks them unverified, so all of them sit in the simulation slot with low confidence."
        }
      },
      {
        "id": "solver_two_nodes",
        "text": {
          "en": "The solver stamps the motor between two nodes and reads only the resistance and a current table, not the back-EMF constant."
        },
        "evidence": "figures/engine/bench-solve.js:110"
      },
      {
        "id": "load_not_wired",
        "text": {
          "en": "The load option (prop, free, stalled) changes the figure and the old solver loop but is not wired to a model parameter here; the propeller current is always used."
        }
      },
      {
        "id": "no_numeric_test",
        "text": {
          "en": "No test checks a number. Motors, servos and steppers have no golden-trace shape, so the one fixture only checks that the layers resolve and every pin and rating is wired."
        }
      }
    ],
    "solver_requires": [
      "motor"
    ],
    "tests": [
      {
        "id": "conformance",
        "kind": "conformance",
        "file": "src/parts/data/tests/dc-motor.conformance.json",
        "note": "Layers resolve, terminals are pins, every rating has its slot."
      }
    ]
  },
