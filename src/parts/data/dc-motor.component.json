          "loc": "figures/parts/dc-motor.js:66"
        },
        "rationale": {
          "en": "Armature resistance of an FA-130 class motor as used by the figure. no source found; constant in figures/parts/dc-motor.js:66"
        }
      },
      "used_by_model": "simulation"
    },
    "back_emf_constant": {
      "measure": "other",
      "role": "characteristic",
      "description": {
        "en": "Back-EMF in volts per rpm."
      },
      "scope": {
        "part": true
      },
      "simulation": {
        "unit": "1",
        "value": 0.000306,
        "confidence": "low",
        "source": {
          "src": "figurejs",
          "loc": "figures/parts/dc-motor.js:12 and 66"
        },
        "rationale": {
          "en": "Volts of back-EMF per rpm, 0.306 mV. The figure quotes FA-130RA sheet values as approximate; the sheet was not read. The unit list has no volts per rpm, so the number is written as a plain ratio."
        }
      },
      "used_by_model": "simulation"
    },
    "no_load_current": {
      "measure": "current",
      "role": "characteristic",
      "description": {
        "en": "Current with the shaft free and no propeller."
      },
      "scope": {
        "pins": [
          "PLUS",
          "MINUS"
        ]
      },
      "simulation": {
        "unit": "A",
        "value": 0.12,
        "confidence": "low",
        "source": {
          "src": "factsheet",
          "loc": "section 13; figures/parts/dc-motor.js:66"
        },
        "rationale": {
          "en": "No-load current. The fact sheet says kit motors vary and assumes 0.1 to 0.25 A at 5 V; the figure picks 0.12 A."
        }
      },
      "used_by_model": "simulation"
    },
    "propeller_load_current": {
      "measure": "current",
      "role": "characteristic",
