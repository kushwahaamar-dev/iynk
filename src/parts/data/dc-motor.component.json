        "source": {
          "src": "figurejs",
          "loc": "figures/parts/dc-motor.js:66"
        },
        "rationale": {
          "en": "Average volts below which brush and bearing stiction hold the shaft. no source found; constant in figures/parts/dc-motor.js:66"
