        "unit": "A",
        "value": 0.08,
        "confidence": "low",
        "source": {
          "src": "figurejs",
          "loc": "figures/parts/dc-motor.js:66"
        },
        "rationale": {
          "en": "no source found; constant in figures/parts/dc-motor.js:66; the propeller adds about 0.08 A at full speed."
        }
      },
      "used_by_model": "simulation"
    },
    "start_voltage": {
      "measure": "voltage",
      "role": "threshold",
      "description": {
        "en": "Lowest average voltage that starts the shaft."
