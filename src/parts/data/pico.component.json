      {
        "i18n_key": "parts.pico.models.1",
        "en": "MicroPython and Arduino-C++ subsets run by the interpreter with the Pico pin map."
      },
      {
        "i18n_key": "parts.pico.models.2",
        "en": "Digital I/O on GP0 to GP22 and GP26 to GP28, PWM and interrupts on every GPIO."
      },
      {
        "i18n_key": "parts.pico.models.3",
        "en": "12-bit analog reads on GP26 to GP28, returned as 0 to 65535 by read_u16(), I2C master on GP4 and GP5, serial output and the on-board LED on GP25."
      }
    ],
    "not_modelled": [
      {
        "i18n_key": "parts.pico.not.1",
        "en": "The PIO state machines and the second core."
      },
      {
        "i18n_key": "parts.pico.not.2",
        "en": "The Wi-Fi and Bluetooth radio of the W boards."
      },
      {
        "i18n_key": "parts.pico.not.3",
        "en": "The RP2350 differences beyond the pin map, and the flash and power-supply behaviour."
      }
    ],
