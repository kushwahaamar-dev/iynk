  "behaviour": {
    "summary": {
      "en": "Each sensor is an infrared LED and a phototransistor side by side. The LEDs run as four series pairs behind a MOSFET switched by LEDON. The host drives an output HIGH, releases it and times the fall: about 120 microseconds over white and the 2500 microsecond library timeout over black."
    },
    "layers": [
      {
        "id": "rc_outputs",
        "domain": "analog",
        "reads": [
          "VCC",
          "LEDON",
          "OUT1",
          "OUT2",
          "OUT3",
          "OUT4",
          "OUT5",
          "OUT6",
          "OUT7",
          "OUT8"
        ],
        "summary": {
          "en": "Eight RC nodes whose fall time follows the reflected light."
        },
        "model": {
          "kind": "none",
          "reason": {
            "en": "The solver has no element for a phototransistor whose current follows the light that comes back, so the fall time is a function in the figure page (read() in figures/modules/qtr-8rc.js)."
          }
        },
        "drives": [
          "OUT1",
          "OUT2",
          "OUT3",
          "OUT4",
          "OUT5",
          "OUT6",
          "OUT7",
          "OUT8"
        ]
      }
    ]
  },
