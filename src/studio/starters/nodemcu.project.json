er":"J2","id":"D2","net":"D2","type":"digital_io"},{"class":"digital","designator":"D3","header":"J2","id":"D3","net":"D3","type":"digital_io"},{"class":"digital","designator":"D4","header":"J2","id":"D4","net":"D4","type":"digital_io"},{"class":"power","designator":"3V3","header":"J2","id":"J2_6","net":"3V3","type":"power_io"},{"class":"ground","designator":"GND","header":"J2","id":"J2_7","net":"GND","type":"ground"},{"class":"digital","designator":"D5","header":"J2","id":"D5","net":"D5","type":"digital_io"},{"class":"digital","designator":"D6","header":"J2","id":"D6","net":"D6","type":"digital_io"},{"class":"digital","designator":"D7","header":"J2","id":"D7","net":"D7","type":"digital_io"},{"class":"digital","designator":"D8","header":"J2","id":"D8","net":"D8","type":"digital_io"},{"class":"digital","designator":"RX","header":"J2","id":"RX","net":"RX","type":"digital_io"},{"class":"digital","designator":"TX","header":"J2","id":"TX","net":"TX","type":"digital_io"},{"class":"ground","designator":"GND","header":"J2","id":"J2_14","net":"GND","type":"ground"},{"class":"power","designator":"3V3","header":"J2","id":"J2_15","net":"3V3","type":"power_io"}],"role":"board"},"origin":"builtin","ref":"core.nodemcu","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"}],"libraries":[]},"format":"iynk.project","guide":{"callouts":[{"target":"LED_MOD","text":{"de":"Eingebaute LED: zwischen 3,3 V und GPIO2, also lässt LOW sie leuchten.","en":"Built-in LED: between 3.3 V and GPIO2, so LOW lights it.","es":"LED integrado: entre 3,3 V y GPIO2, así que LOW lo enciende.","fr":"LED intégrée : entre le 3,3 V et GPIO2, c'est donc LOW qui l'allume.","hi":"बिल्ट-इन LED: 3.3 V और GPIO2 के बीच, इसलिए LOW उसे जलाता है।","zh":"板载 LED：在 3.3 V 和 GPIO2 之间，所以 LOW 点亮它。"}},{"target":"R101","text":{"de":"Strombegrenzung: (3,3 V - 2,0 V) / 220 Ω ≈ 6 mA.","en":"Current limiter: (3.3 V - 2.0 V) / 220 Ω ≈ 6 mA.","es":"Limitador de corriente: (3,3 V - 2,0 V) / 220 Ω ≈ 6 mA.","fr":"Limiteur de courant : (3,3 V - 2,0 V) / 220 Ω ≈ 6 mA.","hi":"करंट सीमित करने वाला: (3.3 V - 2.0 V) / 220 Ω ≈ 6 mA।","zh":"限流电阻：(3.3 V - 2.0 V) / 220 Ω ≈ 6 mA。"}},{"target":"LED101","text":{"de":"Langes Bein (Anode) zum Widerstand.","en":"Long leg (anode) toward the resistor.","es":"Pata larga (ánodo) hacia la resistencia.","fr":"Patte longue (anode) vers la résistance.","hi":"लंबी टाँग (एनोड) रेज़िस्टर की ओर।","zh":"长脚（阳极）朝向电阻。"}}],"features":[{"icon":"bulb","text":{"de":"Zwei LEDs, zwei Logikrichtungen","en":"Two LEDs, two logic senses","es":"Dos LED, dos sentidos lógicos","fr":"Deux LED, deux sens logiques","hi":"दो LED, लॉजिक के दो उल्टे अर्थ","zh":"两颗 LED，两种逻辑方向"}},{"icon":"swap","text":{"de":"D-Namen gegen GPIO-Nummern","en":"D-names versus GPIO numbers","es":"Nombres D frente a números de GPIO","fr":"Noms en D contre numéros de GPIO","hi":"D-नाम बनाम GPIO नंबर","zh":"D 名称和 GPIO 编号的区别"}},{"icon":"pin","text":{"de":"Strom durch einen 3,3-V-Pin","en":"Current through a 3.3 V pin","es":"La corriente a través de un pin de 3,3 V","fr":"Le courant à travers une broche 3,3 V","hi":"3.3 V पिन से करंट","zh":"流过 3.3 V 引脚的电流"}}],"hints":[{"de":"LED_BUILTIN ist GPIO2, den das Board als D4 beschriftet. digitalWrite(4, …) würde stattdessen D2 treiben.","en":"LED_BUILTIN is GPIO2, which the board prints as D4. digitalWrite(4, …) would drive D2 instead.","es":"LED_BUILTIN es GPIO2, que la placa rotula como D4. digitalWrite(4, …) controlaría D2.","fr":"LED_BUILTIN est GPIO2, que la carte imprime D4. digitalWrite(4, …) piloterait D2 à la place.","hi":"LED_BUILTIN, GPIO2 है, जिसे बोर्ड पर D4 छापा गया है। digitalWrite(4, …) इसके बजाय D2 को चलाएगा।","zh":"LED_BUILTIN 是 GPIO2，板子上印的是 D4。digitalWrite(4, …) 驱动的会是 D2。"},{"de":"Bleibt die rote LED dunkel, prüf, ob ihr langes Bein (Anode) in der Spalte des Widerstands steckt.","en":"If the red LED stays dark, check that its long leg (anode) is in the resistor's column.","es":"Si el LED rojo sigue apagado, comprueba que su pata larga (el ánodo) está en la columna de la resistencia.","fr":"Si la LED rouge reste éteinte, vérifiez que sa patte longue (anode) est dans la colonne de la résistance.","hi":"अगर लाल LED बुझी रहे, तो जाँचें कि उसकी लंबी टाँग (एनोड) रेज़िस्टर वाले कॉलम में है।","zh":"如果红色 LED 一直不亮，检查它的长脚（阳极）是否和电阻在同一列。"},{"de":"Der Strom ist (3,3 V - 2,0 V) / R: 220 Ω ergeben etwa 6 mA, weit unter der Grenze des Pins von 12 mA.","en":"The current is (3.3 V - 2.0 V) / R: 220 Ω gives about 6 mA, well under the 12 mA pin limit.","es":"La corriente es (3,3 V - 2,0 V) / R: 220 Ω dan unos 6 mA, muy por debajo del límite de 12 mA del pin.","fr":"Le courant vaut (3,3 V - 2,0 V) / R : 220 Ω donnent environ 6 mA, bien sous la limite de 12 mA par broche.","hi":"करंट है (3.3 V - 2.0 V) / R: 220 Ω लगभग 6 mA देता है, पिन की 12 mA सीमा से काफ़ी नीचे।","zh":"电流是 (3.3 V - 2.0 V) / R：220 Ω 约为 6 mA，远低于 12 mA 的引脚上限。"}],"kind":"lesson","lede":{"de":"Steuer eine LED an D1 und die blaue LED des Moduls an D4 an. Die erste leuchtet bei HIGH, die zweite bei LOW.","en":"Drive an LED on D1 and the module's blue LED on D4. The first lights on HIGH, the second on LOW.","es":"Controla un LED en D1 y el LED azul del módulo en D4. El primero se enciende con HIGH; el segundo, con LOW.","fr":"Pilotez une LED sur D1 et la LED bleue du module sur D4. La première s'allume à HIGH, la seconde à LOW.","hi":"D1 पर एक LED और D4 पर मॉड्यूल की नीली LED चलाएँ। पहली HIGH पर जलती है, दूसरी LOW पर।","zh":"驱动 D1 上的一颗 LED 和 D4 上模组的蓝色 LED。第一颗在 HIGH 时亮，第二颗在 LOW 时亮。"},"legacyFigure":{"circuit":"blink","page":"/figures/boards/nodemcu.html","sheets":["board","breadboard","schematic","power"]},"level":"io","order":1,"pins":[{"color":"orange","pin":"D1","role":{"de":"Ausgang, HIGH = an","en":"output, HIGH = on","es":"salida, HIGH = encendido","fr":"sortie, HIGH = allumée","hi":"आउटपुट, HIGH = जली","zh":"输出，HIGH = 亮"},"to":{"de":"220-Ω-Widerstand, dann die rote LED","en":"220 Ω resistor, then the red LED","es":"resistencia de 220 Ω y luego el LED rojo","fr":"résistance de 220 Ω, puis la LED rouge","hi":"220 Ω रेज़िस्टर, फिर लाल LED","zh":"220 Ω 电阻，再到红色 LED"}},{"color":"blue","pin":"D4","role":{"de":"Ausgang, LOW = an","en":"output, LOW = on","es":"salida, LOW = encendido","fr":"sortie, LOW = allumée","hi":"आउटपुट, LOW = जली","zh":"输出，LOW = 亮"},"to":{"de":"blaue LED auf dem ESP-12E (eingebaut)","en":"blue LED on the ESP-12E (built in)","es":"LED azul del ESP-12E (integrado)","fr":"LED bleue sur l'ESP-12E (intégrée)","hi":"ESP-12E पर नीली LED (बिल्ट-इन)","zh":"ESP-12E 上的蓝色 LED（板载）"}},{"color":"black","pin":"GND","role":{"de":"Masse","en":"ground","es":"tierra","fr":"masse","hi":"ग्राउंड","zh":"地"},"to":{"de":"Kathode der LED (kurzes Bein)","en":"LED cathode (short leg)","es":"cátodo del LED (pata corta)","fr":"cathode de la LED (patte courte)","hi":"LED का कैथोड (छोटी टाँग)","zh":"LED 阴极（短脚）"}}],"quizzes":[{"id":"blink","questions":[{"answer":1,"id":"activelow","options":[{"de":"digitalWrite(LED_BUILTIN, HIGH);","en":"digitalWrite(LED_BUILTIN, HIGH);","es":"digitalWrite(LED_BUILTIN, HIGH);","fr":"digitalWrite(LED_BUILTIN, HIGH);","hi":"digitalWrite(LED_BUILTIN, HIGH);","zh":"digitalWrite(LED_BUILTIN, HIGH);"},{"de":"digitalWrite(LED_BUILTIN, LOW);","en":"digitalWrite(LED_BUILTIN, LOW);","es":"digitalWrite(LED_BUILTIN, LOW);","fr":"digitalWrite(LED_BUILTIN, LOW);","hi":"digitalWrite(LED_BUILTIN, LOW);","zh":"digitalWrite(LED_BUILTIN, LOW);"},{"de":"analogWrite(LED_BUILTIN, 1023);","en":"analogWrite(LED_BUILTIN, 1023);","es":"analogWrite(LED_BUILTIN, 1023);","fr":"analogWrite(LED_BUILTIN, 1023);","hi":"analogWrite(LED_BUILTIN, 1023);","zh":"analogWrite(LED_BUILTIN, 1023);"}],"q":{"de":"Welche Zeile schaltet die eingebaute LED des NodeMCU ein?","en":"Which line turns the NodeMCU's built-in LED on?","es":"¿Qué línea enciende el LED integrado de la NodeMCU?","fr":"Quelle ligne allume la LED intégrée de la NodeMCU ?","hi":"कौन-सी लाइन NodeMCU की बिल्ट-इन LED जलाती है?","zh":"哪一行能点亮 NodeMCU 的板载 LED？"},"why":{"de":"Die LED sitzt zwischen 3,3 V und GPIO2, also fließt nur Strom, wenn der Pin auf LOW gezogen wird.","en":"The LED sits between 3.3 V and GPIO2, so current flows only when the pin is pulled LOW.","es":"El LED está entre 3,3 V y GPIO2, así que la corriente solo pasa cuando el pin se lleva a LOW.","fr":"La LED est placée entre le 3,3 V et GPIO2 : le courant ne passe que quand la broche est mise à LOW.","hi":"LED, 3.3 V और GPIO2 के बीच लगी है, इसलिए करंट सिर्फ़ तभी बहता है जब पिन LOW खींचा जाए।","zh":"这颗 LED 在 3.3 V 和 GPIO2 之间，所以只有引脚被拉到 LOW 时才有电流流过。"}},{"answer":2,"id":"dnames","options":[{"de":"D4","en":"D4","es":"D4","fr":"D4","hi":"D4","zh":"D4"},{"de":"D3","en":"D3","es":"D3","fr":"D3","hi":"D3","zh":"D3"},{"de":"D2","en":"D2","es":"D2","fr":"D2","hi":"D2","zh":"D2"}],"q":{"de":"Welchen Pin der Stiftleiste treibt digitalWrite(4, HIGH) auf einem NodeMCU?","en":"digitalWrite(4, HIGH) on a NodeMCU drives which header pin?","es":"En una NodeMCU, ¿qué pin de la tira controla digitalWrite(4, HIGH)?","fr":"Sur une NodeMCU, digitalWrite(4, HIGH) pilote quelle broche du connecteur ?","hi":"NodeMCU पर digitalWrite(4, HIGH) कौन-सा हेडर पिन चलाता है?","zh":"在 NodeMCU 上，digitalWrite(4, HIGH) 驱动的是哪个排针引脚？"},"why":{"de":"Einfache Zahlen sind GPIO-Nummern. GPIO4 ist als D2 beschriftet; D4 ist GPIO2. Schreib sicherheitshalber D4 oder LED_BUILTIN.","en":"Plain numbers are GPIO numbers. GPIO4 is printed D2; D4 is GPIO2. Write D4 or LED_BUILTIN to be safe.","es":"Los números sin más son números de GPIO. GPIO4 está rotulado D2; D4 es GPIO2. Escribe D4 o LED_BUILTIN para ir sobre seguro.","fr":"Les nombres simples sont des numéros de GPIO. GPIO4 est imprimé D2 ; D4 est GPIO2. Écrivez D4 ou LED_BUILTIN pour être sûr.","hi":"सादी संख्याएँ GPIO नंबर हैं। GPIO4 पर D2 छपा है; D4, GPIO2 है। सुरक्षित रहने के लिए D4 या LED_BUILTIN लिखें।","zh":"纯数字是 GPIO 编号。GPIO4 印的是 D2；D4 是 GPIO2。为了稳妥，写 D4 或 LED_BUILTIN。"}},{"answer":0,"id":"resistor","options":[{"de":"Sie wird dunkler","en":"It gets dimmer","es":"Brilla menos","fr":"Elle faiblit","hi":"मद्धम हो जाती है","zh":"变暗"},{"de":"Sie wird heller","en":"It gets brighter","es":"Brilla más","fr":"Elle brille plus","hi":"तेज़ हो जाती है","zh":"变亮"},{"de":"Nichts: Der Pin legt den Strom fest","en":"Nothing: the pin sets the current","es":"Nada: el pin fija la corriente","fr":"Rien : la broche fixe le courant","hi":"कुछ नहीं: करंट पिन तय करता है","zh":"不变：电流由引脚决定"}],"q":{"de":"Du tauschst den 220-Ω-Widerstand gegen 1 kΩ. Was passiert mit der LED an D1?","en":"You swap the 220 Ω resistor for 1 kΩ. What happens to the LED on D1?","es":"Cambias la resistencia de 220 Ω por una de 1 kΩ. ¿Qué le pasa al LED de D1?","fr":"Vous remplacez la résistance de 220 Ω par une de 1 kΩ. Que devient la LED sur D1 ?","hi":"आप 220 Ω रेज़िस्टर की जगह 1 kΩ लगाते हैं। D1 वाली LED का क्या होता है?","zh":"你把 220 Ω 电阻换成 1 kΩ。D1 上的 LED 会怎样？"},"why":{"de":"Der Strom ist (3,3 V - 2,0 V) / R: etwa 6 mA mit 220 Ω und etwa 1,3 mA mit 1 kΩ. Weniger Strom, weniger Licht.","en":"The current is (3.3 V - 2.0 V) / R: about 6 mA with 220 Ω and about 1.3 mA with 1 kΩ. Less current, less light.","es":"La corriente es (3,3 V - 2,0 V) / R: unos 6 mA con 220 Ω y unos 1,3 mA con 1 kΩ. Menos corriente, menos luz.","fr":"Le courant vaut (3,3 V - 2,0 V) / R : environ 6 mA avec 220 Ω et environ 1,3 mA avec 1 kΩ. Moins de courant, moins de lumière.","hi":"करंट है (3.3 V - 2.0 V) / R: 220 Ω के साथ लगभग 6 mA और 1 kΩ के साथ लगभग 1.3 mA। कम करंट, कम रोशनी।","zh":"电流是 (3.3 V - 2.0 V) / R：220 Ω 时约 6 mA，1 kΩ 时约 1.3 mA。电流越小，光越弱。"}}]}],"serialSample":{"baud":115200,"lines":[]},"specs":[{"label":{"de":"LED-Strom","en":"LED current","es":"Corriente del LED","fr":"Courant de la LED","hi":"LED करंट","zh":"LED 电流"},"value":{"de":"etwa 6 mA mit 220 Ω","en":"about 6 mA with 220 Ω","es":"unos 6 mA con 220 Ω","fr":"environ 6 mA avec 220 Ω","hi":"220 Ω के साथ लगभग 6 mA","zh":"220 Ω 时约 6 mA"}},{"label":{"de":"Grenze des Pins","en":"Pin limit","es":"Límite del pin","fr":"Limite par broche","hi":"पिन की सीमा","zh":"引脚上限"},"value":{"de":"12 mA pro GPIO","en":"12 mA per GPIO","es":"12 mA por GPIO","fr":"12 mA par GPIO","hi":"हर GPIO पर 12 mA","zh":"每个 GPIO 12 mA"}},{"label":{"de":"LED_BUILTIN","en":"LED_BUILTIN","es":"LED_BUILTIN","fr":"LED_BUILTIN","hi":"LED_BUILTIN","zh":"LED_BUILTIN"},"value":{"de":"GPIO2 = D4, aktiv LOW","en":"GPIO2 = D4, active LOW","es":"GPIO2 = D4, activo en LOW","fr":"GPIO2 = D4, active à LOW","hi":"GPIO2 = D4, LOW पर सक्रिय","zh":"GPIO2 = D4，低电平有效"}}],"starter":{"source":"src_sketch","splices":{"ohms":{"1000":"1000","220":"220","330":"330"}},"template":"// Blink an LED on D1 and the blue LED on the module\n// R101 = {{p:ohms}} ohm: the LED current is (3.3 V - 2.0 V) / R101\nconst int LED_PIN = D1;          // D1 is GPIO5, quiet at boot\nconst int WAIT_MS = {{p:wait}};\n\nvoid setup() {\n  pinMode(LED_PIN, OUTPUT);\n  pinMode(LED_BUILTIN, OUTPUT);    // LED_BUILTIN is GPIO2 (D4), the blue LED on the ESP-12E\n}\n\nvoid loop() {\n  digitalWrite(LED_PIN, HIGH);     // HIGH lights the external LED\n  digitalWrite(LED_BUILTIN, LOW);  // LOW lights the blue LED: it is active low\n  delay(WAIT_MS);\n  digitalWrite(LED_PIN, LOW);\n  digitalWrite(LED_BUILTIN, HIGH);\n  delay(WAIT_MS);\n}\n"},"steps":[{"de":"Verbinde D1 über den 220-Ω-Widerstand mit dem langen Bein der LED und das kurze Bein mit GND.","en":"Wire D1 through the 220 Ω resistor to the LED's long leg, and the short leg to GND.","es":"Conecta D1 a través de la resistencia de 220 Ω a la pata larga del LED, y la pata corta a GND.","fr":"Reliez D1 à travers la résistance de 220 Ω à la patte longue de la LED, et la patte courte à GND.","hi":"D1 को 220 Ω रेज़िस्टर से होकर LED की लंबी टाँग से जोड़ें, और छोटी टाँग को GND से।","zh":"把 D1 经过 220 Ω 电阻接到 LED 的长脚，短脚接 GND。"},{"de":"Führ den Sketch aus: Die rote LED und die blaue LED auf dem Modul blinken zusammen.","en":"Run the sketch: the red LED and the blue LED on the module blink together.","es":"Ejecuta el sketch: el LED rojo y el LED azul del módulo parpadean a la vez.","fr":"Lancez le sketch : la LED rouge et la LED bleue du module clignotent ensemble.","hi":"स्केच चलाएँ: लाल LED और मॉड्यूल की नीली LED साथ ब्लिंक करती हैं।","zh":"运行程序：红色 LED 和模组上的蓝色 LED 一起闪烁。"},{"de":"Sieh dir den Code an: HIGH lässt die rote LED leuchten, aber LOW die blaue, weil sie zwischen 3,3 V und GPIO2 hängt.","en":"Look at the code: HIGH lights the red LED, but LOW lights the blue one, because it hangs between 3.3 V and GPIO2.","es":"Mira el código: HIGH enciende el LED rojo, pero LOW enciende el azul, porque cuelga entre 3,3 V y GPIO2.","fr":"Regardez le code : HIGH allume la LED rouge, mais c'est LOW qui allume la bleue, car elle est reliée entre le 3,3 V et GPIO2.","hi":"कोड देखें: HIGH लाल LED जलाता है, पर LOW नीली को जलाता है, क्योंकि वह 3.3 V और GPIO2 के बीच लगी है।","zh":"看看代码：HIGH 点亮红色 LED，而 LOW 点亮蓝色 LED，因为它挂在 3.3 V 和 GPIO2 之间。"},{"de":"Ändere die Wartezeit und probier dann 1 kΩ: Die LED wird dunkler, weil der Strom sinkt.","en":"Change the wait time, then try 1 kΩ: the LED gets dimmer as the current falls.","es":"Cambia el tiempo de espera y luego prueba 1 kΩ: el LED brilla menos al bajar la corriente.","fr":"Changez la durée d'attente, puis essayez 1 kΩ : la LED faiblit à mesure que le courant baisse.","hi":"इंतज़ार का समय बदलें, फिर 1 kΩ आज़माएँ: करंट घटने के साथ LED मद्धम होती जाती है।","zh":"改一下等待时间，然后试试 1 kΩ：电流变小，LED 变暗。"}],"title":{"de":"Zwei LEDs blinken lassen, eine davon verkehrt herum","en":"Blink two LEDs, one of them backwards","es":"Haz parpadear dos LED, uno de ellos al revés","fr":"Faire clignoter deux LED, dont une à l'envers","hi":"दो LED ब्लिंक करें, जिनमें से एक उल्टी","zh":"让两颗 LED 闪烁，其中一颗是反着来的"}},"history":{"baseChain":"7723303a0a61c412331c362b6db8c3c6871b7cff7c8f254abec6d621b1c43ee0","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_nodemcu-blink","license":{"spdx":"LicenseRef-iynk-pending"},"meta":{"createdAt":"2026-01-01T00:00:00.000Z","description":"Drive an LED on D1 and the module's blue LED on D4. The first lights on HIGH, the second on LOW.","kind":"template","locale":"en","tags":["nodemcu","lesson","io"],"title":"Blink two LEDs, one of them backwards","updatedAt":"2026-01-01T00:00:00.000Z"},"nets":[{"class":"signal","connections":[{"c":"brd_main","p":"D1"},{"c":"cmp_r101","p":"P1"}],"id":"net_d1","name":"D1"},{"class":"ground","connections":[{"c":"brd_main","p":"GND"},{"c":"cmp_led101","p":"K"}],"id":"net_gnd","name":"GND"},{"class":"signal","connections":[{"c":"cmp_led101","p":"A"},{"c":"cmp_r101","p":"P2"}],"id":"net_led101a_r101p2"}],"parameters":[{"id":"par_ohms","kind":"choice","label":{"de":"Widerstand","en":"Resistor","es":"Resistencia","fr":"Résistance","hi":"रेज़िस्टर","zh":"电阻"},"name":"ohms","options":[{"label":{"de":"220 Ω (etwa 6 mA)","en":"220 Ω (about 6 mA)","es":"220 Ω (unos 6 mA)","fr":"220 Ω (environ 6 mA)","hi":"220 Ω (लगभग 6 mA)","zh":"220 Ω（约 6 mA）"},"value":220},{"label":{"de":"330 Ω (etwa 4 mA)","en":"330 Ω (about 4 mA)","es":"330 Ω (unos 4 mA)","fr":"330 Ω (environ 4 mA)","hi":"330 Ω (लगभग 4 mA)","zh":"330 Ω（约 4 mA）"},"value":330},{"label":{"de":"1 kΩ (etwa 1,3 mA)","en":"1 kΩ (about 1.3 mA)","es":"1 kΩ (unos 1,3 mA)","fr":"1 kΩ (environ 1,3 mA)","hi":"1 kΩ (लगभग 1.3 mA)","zh":"1 kΩ（约 1.3 mA）"},"value":1000}],"value":220},{"id":"par_wait","kind":"number","label":{"de":"Warten (ms)","en":"Wait (ms)","es":"Espera (ms)","fr":"Attente (ms)","hi":"इंतज़ार (ms)","zh":"等待（ms）"},"max":2000,"min":100,"name":"wait","step":100,"value":500}],"provenance":{"contributors":[],"createdBy":"usr_iynk","createdWith":{"app":"iynk","version":"0.1.0"},"origin":{"kind":"template","template":"nodemcu-blink"},"thirdParty":[{"id":"tp1","kind":"text","review":"unchecked","source":{"title":"Third-party lesson sites named in D-017"},"what":"Lesson order, wording and timings may follow a third-party lesson site (F-197 review pending)"}]},"revision":0,"schemaVersion":"1.1","simulation":{"duration_ms":4000,"faults":[],"runtimes":[{"board":"brd_main","engine":"iynk-interp","id":"rtm_main"}],"seed":625341585,"solver":{"engine":"iynk-mna"},"world":{"inputs":[],"script":[]}},"sources":[{"board":"brd_main","content":"// Blink an LED on D1 and the blue LED on the module\n// R101 = 220 ohm: the LED current is (3.3 V - 2.0 V) / R101\nconst int LED_PIN = D1;          // D1 is GPIO5, quiet at boot\nconst int WAIT_MS = 500;\n\nvoid setup() {\n  pinMode(LED_PIN, OUTPUT);\n  pinMode(LED_BUILTIN, OUTPUT);    // LED_BUILTIN is GPIO2 (D4), the blue LED on the ESP-12E\n}\n\nvoid loop() {\n  digitalWrite(LED_PIN, HIGH);     // HIGH lights the external LED\n  digitalWrite(LED_BUILTIN, LOW);  // LOW lights the blue LED: it is active low\n  delay(WAIT_MS);\n  digitalWrite(LED_PIN, LOW);\n  digitalWrite(LED_BUILTIN, HIGH);\n  delay(WAIT_MS);\n}\n","id":"src_sketch","language":"arduino-cpp","path":"sketch.ino","role":"firmware"}],"tests":[{"checks":[{"id":"c1","kind":"runs","label":{"de":"Der Sketch läuft 3 Sekunden","en":"The sketch runs for 3 seconds","es":"El sketch funciona durante 3 segundos","fr":"Le sketch tourne pendant 3 secondes","hi":"स्केच 3 सेकंड तक चलता है","zh":"程序运行 3 秒"},"minMs":3000,"visibility":"visible"},{"id":"c2","kind":"pin-toggles","label":{"de":"D1 blinkt mit einer Periode von etwa 1 s","en":"D1 blinks with a period of about 1 s","es":"D1 parpadea con un periodo de alrededor de 1 s","fr":"D1 clignote avec une période d'environ 1 s","hi":"D1 लगभग 1 s के चक्र से ब्लिंक करता है","zh":"D1 以约 1 s 的周期闪烁"},"minCycles":3,"periodMs":[900,1100],"pin":"D1","visibility":"visible"},{"atMs":250,"id":"c3","kind":"pin-level","label":{"de":"Die blaue LED ist an (D4 LOW), während die rote an ist","en":"The blue LED is on (D4 LOW) while the red one is on","es":"El LED azul está encendido (D4 en LOW) mientras el rojo está encendido","fr":"La LED bleue est allumée (D4 à LOW) pendant que la rouge l'est","hi":"लाल LED जली रहने तक नीली LED जली है (D4 LOW)","zh":"红灯亮时蓝灯也亮（D4 为 LOW）"},"level":0,"pin":"D4","visibility":"visible"},{"atMs":750,"id":"c4","kind":"pin-level","label":{"de":"Die blaue LED ist in der anderen Hälfte aus (D4 HIGH)","en":"The blue LED is off (D4 HIGH) in the other half","es":"El LED azul está apagado (D4 en HIGH) en la otra mitad","fr":"La LED bleue est éteinte (D4 à HIGH) l'autre moitié du temps","hi":"दूसरे आधे हिस्से में नीली LED बुझी है (D4 HIGH)","zh":"另一半时间蓝灯灭（D4 为 HIGH）"},"level":1,"pin":"D4","visibility":"visible"}],"id":"main","name":{"de":"Zwei LEDs blinken lassen, eine davon verkehrt herum","en":"Blink two LEDs, one of them backwards","es":"Haz parpadear dos LED, uno de ellos al revés","fr":"Faire clignoter deux LED, dont une à l'envers","hi":"दो LED ब्लिंक करें, जिनमें से एक उल्टी","zh":"让两颗 LED 闪烁，其中一颗是反着来的"},"runMs":4000}],"views":[{"id":"vw_bb","kind":"breadboard","name":"Breadboard","placements":[{"c":"brd_main","x_mm":-90,"y_mm":0},{"c":"cmp_bb","x_mm":0,"y_mm":0},{"c":"cmp_led101","legs":{"A":"c14","K":"c15"},"x_mm":0,"y_mm":0},{"c":"cmp_r101","legs":{"P1":"b10","P2":"b14"},"x_mm":0,"y_mm":0}],"surface":"cmp_bb","wires":[{"color":"orange","from":{"c":"brd_main","kind":"pin","p":"D1"},"id":"wir_1","net":"net_d1","to":{"hole":"a10","kind":"hole","surface":"cmp_bb"}},{"color":"black","from":{"c":"brd_main","kind":"pin","p":"GND"},"id":"wir_2","net":"net_gnd","to":{"hole":"a15","kind":"hole","surface":"cmp_bb"}}]}]}
