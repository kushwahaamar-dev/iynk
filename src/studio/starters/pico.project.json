ss":"ground","designator":"GND","header":"edge","id":"edge_38","net":"GND","type":"ground"},{"class":"power","designator":"VSYS","header":"edge","id":"VSYS","net":"VSYS","type":"power_io"},{"class":"power","designator":"VBUS","header":"edge","id":"VBUS","net":"VBUS","type":"power_io"},{"class":"digital","designator":"SWCLK","header":"DEBUG","id":"SWCLK","net":"SWCLK","type":"digital_io"},{"class":"ground","designator":"GND","header":"DEBUG","id":"DEBUG_2","net":"GND","type":"ground"},{"class":"digital","designator":"SWDIO","header":"DEBUG","id":"SWDIO","net":"SWDIO","type":"digital_io"}],"role":"board"},"origin":"builtin","ref":"core.pico","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"}],"libraries":[]},"format":"iynk.project","guide":{"callouts":[{"target":"D2","text":{"de":"Die eigene LED des Boards","en":"The board's own LED","es":"El LED propio de la placa","fr":"La LED de la carte","hi":"बोर्ड की अपनी LED","zh":"板载 LED"}},{"target":"R1","text":{"de":"330 Ω ergeben etwa 4 mA","en":"330 Ω sets about 4 mA","es":"330 Ω fijan unos 4 mA","fr":"330 Ω fixent environ 4 mA","hi":"330 Ω लगभग 4 mA तय करता है","zh":"330 Ω 把电流设在约 4 mA"}}],"features":[{"icon":"led","text":{"de":"LED auf dem Board und externe LED zusammen","en":"On-board and external LED together","es":"El LED de la placa y uno externo a la vez","fr":"LED de la carte et LED externe ensemble","hi":"बोर्ड वाली और बाहरी LED एक साथ","zh":"板载 LED 和外接 LED 一起闪"}},{"icon":"code","text":{"de":"Derselbe Code auf allen vier Boards","en":"The same code on all four boards","es":"El mismo código en las cuatro placas","fr":"Le même code sur les quatre cartes","hi":"चारों बोर्ड पर एक ही कोड","zh":"四款板子用同一份代码"}},{"icon":"clock","text":{"de":"Eine Verzögerung, die du live ändern kannst","en":"A delay you can change live","es":"Un retardo que puedes cambiar en directo","fr":"Un délai modifiable en direct","hi":"चलते-चलते बदली जा सकने वाली देरी","zh":"可以实时修改的延时"}}],"hints":[{"de":"Auf dem Steckbrett tut sich nichts? Prüf, ob das lange Bein der LED (Anode) zum Widerstand zeigt.","en":"Nothing on the breadboard? Check that the LED's long leg (anode) faces the resistor.","es":"¿No pasa nada en la protoboard? Comprueba que la pata larga del LED (el ánodo) mira hacia la resistencia.","fr":"Rien sur la platine d'essai ? Vérifiez que la patte longue de la LED (anode) est du côté de la résistance.","hi":"ब्रेडबोर्ड पर कुछ नहीं? जाँचें कि LED की लंबी टाँग (एनोड) रेज़िस्टर की ओर है।","zh":"面包板上的灯不亮？检查 LED 的长脚（阳极）是否朝向电阻。"},{"de":"led.toggle() schaltet den Pin um; led.value(1) und led.value(0) setzen ihn.","en":"led.toggle() flips the pin; led.value(1) and led.value(0) set it.","es":"led.toggle() invierte el pin; led.value(1) y led.value(0) lo fijan.","fr":"led.toggle() inverse la broche ; led.value(1) et led.value(0) la règlent.","hi":"led.toggle() पिन को पलटता है; led.value(1) और led.value(0) उसे सेट करते हैं।","zh":"led.toggle() 翻转引脚；led.value(1) 和 led.value(0) 设置它。"},{"de":"Auf den W-Boards ist GP25 das Chip-Select des Funkteils, deshalb nutzt der Code den Namen \"LED\".","en":"On the W boards GP25 is the radio's chip select, which is why the code uses the name \"LED\".","es":"En las placas W, GP25 es el chip select de la radio, y por eso el código usa el nombre \"LED\".","fr":"Sur les cartes W, GP25 est le chip select de la radio : voilà pourquoi le code utilise le nom \"LED\".","hi":"W बोर्ड पर GP25 रेडियो का चिप सेलेक्ट है, इसीलिए कोड \"LED\" नाम इस्तेमाल करता है।","zh":"在 W 版上，GP25 是无线芯片的片选，所以代码用的是 \"LED\" 这个名字。"}],"kind":"lesson","lede":{"de":"Pin(\"LED\") findet auf allen vier Boards die eigene LED des Boards, und eine zweite LED an GP15 blinkt auf dem Steckbrett mit.","en":"Pin(\"LED\") finds the board's own LED on all four boards, and a second LED on GP15 blinks with it on the breadboard.","es":"Pin(\"LED\") encuentra el LED propio de la placa en las cuatro placas, y un segundo LED en GP15 parpadea con él en la protoboard.","fr":"Pin(\"LED\") trouve la LED de la carte sur les quatre modèles, et une seconde LED sur GP15 clignote avec elle sur la platine d'essai.","hi":"Pin(\"LED\") चारों बोर्ड पर बोर्ड की अपनी LED ढूँढ लेता है, और GP15 पर लगी दूसरी LED ब्रेडबोर्ड पर उसके साथ ब्लिंक करती है।","zh":"在全部四款板子上，Pin(\"LED\") 都能找到板载 LED，而面包板上 GP15 接的第二颗 LED 也会跟着它一起闪烁。"},"legacyFigure":{"circuit":"blink","page":"/figures/boards/pico.html","sheets":["board","breadboard","schematic","power"]},"level":"io","order":1,"pins":[{"color":"orange","pin":"GP15","role":{"de":"Digitaler Ausgang","en":"Digital output","es":"Salida digital","fr":"Sortie numérique","hi":"डिजिटल आउटपुट","zh":"数字输出"},"to":{"de":"330-Ω-Widerstand, dann die Anode der LED","en":"330 Ω resistor, then the LED's anode","es":"Resistencia de 330 Ω y luego el ánodo del LED","fr":"Résistance de 330 Ω, puis anode de la LED","hi":"330 Ω रेज़िस्टर, फिर LED का एनोड","zh":"330 Ω 电阻，再到 LED 的阳极"}},{"color":"black","pin":"GND","role":{"de":"Rückweg","en":"Return","es":"Retorno","fr":"Retour","hi":"वापसी","zh":"回路"},"to":{"de":"Kathode der LED","en":"LED cathode","es":"Cátodo del LED","fr":"Cathode de la LED","hi":"LED का कैथोड","zh":"LED 阴极"}}],"quizzes":[{"id":"blink","questions":[{"answer":1,"id":"q1","options":[{"de":"Pin(25) ist in MicroPython kein gültiger Pin","en":"Pin(25) is not a valid pin in MicroPython","es":"Pin(25) no es un pin válido en MicroPython","fr":"Pin(25) n'est pas une broche valide en MicroPython","hi":"MicroPython में Pin(25) कोई सही पिन नहीं है","zh":"Pin(25) 在 MicroPython 里不是有效的引脚"},{"de":"Auf den W-Boards gehört GP25 dem Funkteil, nicht der LED","en":"On the W boards GP25 belongs to the radio, not the LED","es":"En las placas W, GP25 es de la radio, no del LED","fr":"Sur les cartes W, GP25 appartient à la radio, pas à la LED","hi":"W बोर्ड पर GP25 रेडियो का है, LED का नहीं","zh":"在 W 版上，GP25 归无线芯片用，不接 LED"},{"de":"Pin(\"LED\") treibt die LED stärker","en":"Pin(\"LED\") drives the LED harder","es":"Pin(\"LED\") alimenta el LED con más fuerza","fr":"Pin(\"LED\") alimente la LED plus fort","hi":"Pin(\"LED\") LED को ज़्यादा ज़ोर से चलाता है","zh":"Pin(\"LED\") 驱动 LED 更用力"}],"q":{"de":"Warum nutzt der Code Pin(\"LED\") und nicht Pin(25)?","en":"Why does the code use Pin(\"LED\") and not Pin(25)?","es":"¿Por qué el código usa Pin(\"LED\") y no Pin(25)?","fr":"Pourquoi le code utilise-t-il Pin(\"LED\") et pas Pin(25) ?","hi":"कोड Pin(\"LED\") क्यों इस्तेमाल करता है, Pin(25) क्यों नहीं?","zh":"为什么代码用 Pin(\"LED\") 而不是 Pin(25)？"},"why":{"de":"Pico und Pico 2 haben die LED an GP25, auf Pico W und Pico 2 W ist sie das WL_GPIO0 des Funkteils. Der Name \"LED\" findet auf allen vier Boards die richtige.","en":"The Pico and Pico 2 have the LED on GP25, but on the Pico W and Pico 2 W it is the radio's WL_GPIO0. The name \"LED\" finds the right one on all four boards.","es":"La Pico y la Pico 2 tienen el LED en GP25, pero en la Pico W y la Pico 2 W es el WL_GPIO0 de la radio. El nombre \"LED\" encuentra el correcto en las cuatro placas.","fr":"La Pico et la Pico 2 ont la LED sur GP25, mais sur la Pico W et la Pico 2 W c'est le WL_GPIO0 de la radio. Le nom \"LED\" trouve la bonne sur les quatre cartes.","hi":"Pico और Pico 2 पर LED GP25 पर है, पर Pico W और Pico 2 W पर वह रेडियो का WL_GPIO0 है। \"LED\" नाम चारों बोर्ड पर सही LED ढूँढ लेता है।","zh":"Pico 和 Pico 2 的 LED 接在 GP25 上，而 Pico W 和 Pico 2 W 的 LED 是无线芯片的 WL_GPIO0。用 \"LED\" 这个名字，在四款板子上都能找到正确的那颗。"}},{"answer":0,"id":"q2","options":[{"de":"Er begrenzt den Strom auf etwa 4 mA, die der Pin liefern kann","en":"It limits the current to about 4 mA, which the pin can supply","es":"Limita la corriente a unos 4 mA, que el pin puede dar","fr":"Elle limite le courant à environ 4 mA, ce que la broche peut fournir","hi":"करंट को लगभग 4 mA पर रोकता है, जितना पिन दे सकता है","zh":"把电流限制在约 4 mA，引脚供得起"},{"de":"Er senkt die 5 V des Pins auf sichere 3,3 V","en":"It drops the pin's 5 V to a safe 3.3 V","es":"Baja los 5 V del pin a unos 3,3 V seguros","fr":"Elle abaisse les 5 V de la broche à 3,3 V sans danger","hi":"पिन के 5 V को सुरक्षित 3.3 V तक घटाता है","zh":"把引脚的 5 V 降到安全的 3.3 V"},{"de":"Er legt fest, wie schnell die LED blinkt","en":"It sets how fast the LED blinks","es":"Fija la velocidad del parpadeo","fr":"Elle règle la vitesse du clignotement","hi":"तय करता है कि LED कितनी तेज़ी से ब्लिंक करे","zh":"决定 LED 闪得多快"}],"q":{"de":"Was macht der 330-Ω-Widerstand vor der LED an GP15?","en":"What does the 330 Ω resistor in front of the GP15 LED do?","es":"¿Qué hace la resistencia de 330 Ω delante del LED de GP15?","fr":"À quoi sert la résistance de 330 Ω devant la LED de GP15 ?","hi":"GP15 वाली LED के आगे लगा 330 Ω रेज़िस्टर क्या करता है?","zh":"GP15 那颗 LED 前面的 330 Ω 电阻有什么用？"},"why":{"de":"(3,3 V - 2,0 V) / 330 Ω ≈ 4 mA, innerhalb der standardmäßigen 4 mA Treiberstärke des Pins. Die GPIOs haben auf jedem Pico 3,3 V, und ohne den Widerstand würde der Pin versuchen, weit mehr als 12 mA zu treiben.","en":"(3.3 V - 2.0 V) / 330 Ω ≈ 4 mA, within the pin's default 4 mA drive. GPIOs are 3.3 V on every Pico, and without the resistor the pin would try to drive far more than 12 mA.","es":"(3,3 V - 2,0 V) / 330 Ω ≈ 4 mA, dentro de los 4 mA de salida por defecto del pin. Los GPIO son de 3,3 V en todas las Pico, y sin la resistencia el pin intentaría dar mucho más de 12 mA.","fr":"(3,3 V - 2,0 V) / 330 Ω ≈ 4 mA, dans la limite des 4 mA par défaut de la broche. Les GPIO sont en 3,3 V sur toutes les Pico, et sans la résistance la broche essaierait de fournir bien plus de 12 mA.","hi":"(3.3 V - 2.0 V) / 330 Ω ≈ 4 mA, पिन की डिफ़ॉल्ट 4 mA ड्राइव के अंदर। हर Pico पर GPIO 3.3 V के हैं, और रेज़िस्टर के बिना पिन 12 mA से कहीं ज़्यादा देने की कोशिश करेगा।","zh":"(3.3 V - 2.0 V) / 330 Ω ≈ 4 mA，在引脚默认 4 mA 驱动能力之内。每款 Pico 的 GPIO 都是 3.3 V；没有电阻，引脚会试图输出远超 12 mA 的电流。"}},{"answer":2,"id":"q3","options":[{"de":"250 ms","en":"250 ms","es":"250 ms","fr":"250 ms","hi":"250 ms","zh":"250 ms"},{"de":"500 ms","en":"500 ms","es":"500 ms","fr":"500 ms","hi":"500 ms","zh":"500 ms"},{"de":"1 Sekunde","en":"1 second","es":"1 segundo","fr":"1 seconde","hi":"1 सेकंड","zh":"1 秒"}],"q":{"de":"Bei einer Verzögerung von 500 ms: Wie lang ist ein ganzes Blinken, an und aus?","en":"With the delay at 500 ms, how long is one full blink, on and off?","es":"Con el retardo en 500 ms, ¿cuánto dura un parpadeo completo, encendido y apagado?","fr":"Avec un délai de 500 ms, combien dure un clignotement complet, allumé puis éteint ?","hi":"देरी 500 ms हो, तो एक पूरा ब्लिंक, जलना और बुझना, कितना लंबा होता है?","zh":"延时设为 500 ms 时，完整闪一次（亮加灭）要多久？"},"why":{"de":"toggle() schaltet die LED einmal pro Verzögerung um, also ist sie 500 ms an und 500 ms aus: Die Periode ist doppelt so lang wie die Verzögerung.","en":"toggle() flips the LED once per delay, so it is on for 500 ms and off for 500 ms: the period is twice the delay.","es":"toggle() invierte el LED una vez por retardo, así que está 500 ms encendido y 500 ms apagado: el periodo es el doble del retardo.","fr":"toggle() bascule la LED une fois par délai : elle reste allumée 500 ms et éteinte 500 ms, la période vaut donc deux fois le délai.","hi":"toggle() हर देरी पर LED को एक बार पलटता है, इसलिए वह 500 ms जलती है और 500 ms बुझी रहती है: पूरा चक्र देरी का दोगुना है।","zh":"toggle() 每过一次延时就翻转一次 LED，所以它亮 500 ms、灭 500 ms：周期是延时的两倍。"}}]}],"serialSample":{"baud":115200,"lines":[]},"specs":[{"label":{"de":"LED-Strom","en":"LED current","es":"Corriente del LED","fr":"Courant de la LED","hi":"LED करंट","zh":"LED 电流"},"value":{"de":"(3,3 V - 2,0 V) / 330 Ω ≈ 4 mA","en":"(3.3 V - 2.0 V) / 330 Ω ≈ 4 mA","es":"(3,3 V - 2,0 V) / 330 Ω ≈ 4 mA","fr":"(3,3 V - 2,0 V) / 330 Ω ≈ 4 mA","hi":"(3.3 V - 2.0 V) / 330 Ω ≈ 4 mA","zh":"(3.3 V - 2.0 V) / 330 Ω ≈ 4 mA"}},{"label":{"de":"Blinkperiode","en":"Blink period","es":"Periodo del parpadeo","fr":"Période de clignotement","hi":"ब्लिंक का चक्र","zh":"闪烁周期"},"value":{"de":"2 x die Verzögerung: 1 s bei 500 ms","en":"2 x the delay: 1 s at 500 ms","es":"2 x el retardo: 1 s con 500 ms","fr":"2 x le délai : 1 s à 500 ms","hi":"देरी का 2 गुना: 500 ms पर 1 s","zh":"延时的 2 倍：500 ms 时为 1 s"}},{"label":{"de":"LED auf dem Board","en":"On-board LED","es":"LED de la placa","fr":"LED de la carte","hi":"बोर्ड वाली LED","zh":"板载 LED"},"value":{"de":"GP25, oder WL_GPIO0 auf den W-Boards","en":"GP25, or WL_GPIO0 on the W boards","es":"GP25, o WL_GPIO0 en las placas W","fr":"GP25, ou WL_GPIO0 sur les cartes W","hi":"GP25, या W बोर्ड पर WL_GPIO0","zh":"GP25，W 版上为 WL_GPIO0"}}],"starter":{"source":"src_main","template":"# Blink the on-board LED and an LED on GP15\nfrom machine import Pin\nimport time\n\nled = Pin(\"LED\", Pin.OUT)   # the board's LED, on any Pico\next = Pin(15, Pin.OUT)      # the LED on the breadboard\n\nwhile True:\n    led.toggle()\n    ext.toggle()\n    time.sleep_ms({{p:ms}})\n"},"steps":[{"de":"Verbinde GP15 (Pin 20) über einen 330-Ω-Widerstand mit dem langen Bein einer roten LED und ihr kurzes Bein mit GND.","en":"Wire GP15 (pin 20) through a 330 Ω resistor to the long leg of a red LED, and its short leg to GND.","es":"Conecta GP15 (pin 20) a través de una resistencia de 330 Ω a la pata larga de un LED rojo, y su pata corta a GND.","fr":"Reliez GP15 (broche 20) à travers une résistance de 330 Ω à la patte longue d'une LED rouge, et sa patte courte à GND.","hi":"GP15 (पिन 20) को 330 Ω रेज़िस्टर से होकर लाल LED की लंबी टाँग से जोड़ें, और उसकी छोटी टाँग को GND से।","zh":"把 GP15（第 20 脚）经过一个 330 Ω 电阻接到红色 LED 的长脚，短脚接 GND。"},{"de":"Führ das Programm aus: Beide LEDs wechseln jede halbe Sekunde.","en":"Run the program: both LEDs toggle every half second.","es":"Ejecuta el programa: los dos LED cambian cada medio segundo.","fr":"Lancez le programme : les deux LED basculent toutes les demi-secondes.","hi":"प्रोग्राम चलाएँ: दोनों LED हर आधे सेकंड पर पलटती हैं।","zh":"运行程序：两颗 LED 每半秒切换一次。"},{"de":"Ändere den Chip für die Verzögerung und führ es erneut aus: Kürzere Verzögerungen blinken schneller.","en":"Change the delay chip and run again: shorter delays blink faster.","es":"Cambia el botón del retardo y vuelve a ejecutarlo: con retardos más cortos parpadea más rápido.","fr":"Changez la pastille du délai et relancez : des délais plus courts clignotent plus vite.","hi":"देरी वाली चिप बदलें और फिर चलाएँ: कम देरी, तेज़ ब्लिंक।","zh":"改一下延时选项再运行：延时越短，闪得越快。"},{"de":"Stell die Variante auf Pico W: Pin(\"LED\") funktioniert weiterhin, Pin(25) dagegen nicht.","en":"Switch the variant to Pico W: Pin(\"LED\") still works, while Pin(25) would not.","es":"Cambia la variante a Pico W: Pin(\"LED\") sigue funcionando, mientras que Pin(25) no funcionaría.","fr":"Passez sur le modèle Pico W : Pin(\"LED\") fonctionne toujours, alors que Pin(25) ne marcherait pas.","hi":"वेरिएंट को Pico W पर बदलें: Pin(\"LED\") अब भी चलता है, जबकि Pin(25) नहीं चलेगा।","zh":"把型号切换到 Pico W：Pin(\"LED\") 仍然能用，而 Pin(25) 就不行了。"}],"title":{"de":"Die LED blinken lassen","en":"Blink the LED","es":"Haz parpadear el LED","fr":"Faire clignoter la LED","hi":"LED ब्लिंक करें","zh":"让 LED 闪烁"}},"history":{"baseChain":"6aa0573ff050a55daa3a8ceb7e82349f9c45580bd360fb5012ec44a76d7a1bdd","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_pico-blink","license":{"spdx":"LicenseRef-iynk-pending"},"meta":{"createdAt":"2026-01-01T00:00:00.000Z","description":"Pin(\"LED\") finds the board's own LED on all four boards, and a second LED on GP15 blinks with it on the breadboard.","kind":"template","locale":"en","tags":["pico","lesson","io"],"title":"Blink the LED","updatedAt":"2026-01-01T00:00:00.000Z"},"nets":[{"class":"ground","connections":[{"c":"brd_main","p":"GND"},{"c":"cmp_led1","p":"K"}],"id":"net_gnd","name":"GND"},{"class":"signal","connections":[{"c":"brd_main","p":"GP15"},{"c":"cmp_r1","p":"P1"}],"id":"net_gp15","name":"GP15"},{"clas