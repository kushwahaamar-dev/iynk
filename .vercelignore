# Files Vercel never uploads or builds (applies to CLI and Git deploys).
# Root paths start with "/": an unanchored name would also strip src/lib/server, src/components/solana, src/app/api/solana.
# Never list public/ or public/figures: the built figures are served from there.

# Secrets and local state
.env*
!.env.example
.vercel
*.pem
*.tsbuildinfo
next-env.d.ts
.DS_Store
*.log

# Dependencies and build output (Vercel installs and builds itself)
node_modules
/.next
/.next-*
/out
/build
/coverage
/test-results
/playwright-report
/blob-report

# Notes and research (nothing at runtime reads them)
/docs
/.audit
/HANDOFF.md
/scratch
/tmp

# Figure sources: the runtime needs public/figures and only the colorfigures licence (about page)
/figures/*
!/figures/vendor
/figures/vendor/*
!/figures/vendor/colorfigures
/figures/vendor/colorfigures/*
!/figures/vendor/colorfigures/LICENSE

# Other deployables with their own homes (realtime relay, Anchor program, migrations)
/solana
/server
/deploy
/db

# Scripts: the build needs only the content generator
/scripts/*
!/scripts/gen-content-index.mjs

# Tests (the build neither runs nor imports them)
/e2e
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.test.mjs
/playwright.config.ts
/vitest.config.mts
/vitest.setup.ts
