    "base": "prj_uno-r3-plant",
    "ops": [
      {
        "k": "net.connect",
        "net": "net_scl",
        "pin": {
          "c": "cmp_oled1",
          "p": "SDA"
        },
        "move": true
      },
      {
        "k": "net.connect",
        "net": "net_sda",
        "pin": {
          "c": "cmp_oled1",
          "p": "SCL"
