        "view": "vw_bb",
        "placement": {
          "c": "cmp_oled1",
          "x_mm": 0,
          "y_mm": 0,
          "legs": {
            "GND": "g4",
            "SCL": "g7",
            "SDA": "g6",
            "VCC": "g5"
