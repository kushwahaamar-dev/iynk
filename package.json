{
  "name": "iynk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#core/*": "./src/core/*.ts",
    "#protocol/*": "./src/protocol/*.ts",
    "#project/*": "./src/project/*.ts"
  },
  "scripts": {
    "content": "node -e \"for(const f of ['scripts/gen-content-index.mjs','scripts/gen-parts-index.mjs']){if(require('fs').existsSync(f))require('child_process').execFileSync(process.execPath,[f],{stdio:'inherit'});else console.log('skipped: '+f+' is not written yet')}\"",
    "content:check": "node scripts/gen-content-index.mjs --check && node -e \"const f='scripts/gen-parts-index.mjs';if(require('fs').existsSync(f))require('child_process').execFileSync(process.execPath,[f,'--check'],{stdio:'inherit'})\"",
    "labs:check": "node scripts/convert-labs.mjs --check",
    "parts:check": "node scripts/validate-part.mjs --all",
    "engines:build": "node scripts/build-engines.mjs --if-present",
    "schema:gen": "node scripts/schema-gen.mjs",
    "schema:check": "node scripts/schema-gen.mjs --check",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content && npm run engines:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --quiet",
    "typegen": "next typegen",
    "pretypecheck": "npm run content",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.portable.json",
    "typecheck:portable": "tsc -p tsconfig.portable.json",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:test": "npm --prefix server test && npm --prefix server/legacy test",
    "pretest": "npm run content && npm run engines:build",
    "test": "vitest run",
    "pretest:perf": "npm run content",
    "test:perf": "vitest run --config vitest.perf.config.mts",
    "e2e": "playwright test",
    "provenance:check": "node scripts/provenance-check.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:record": "node scripts/perf-budget.mjs --record",
    "corpus": "node scripts/convert-catalogue.mjs",
    "measure:apply": "node scripts/measure-apply.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "templates": "node scripts/build-templates.mjs --all",
    "templates:check": "node scripts/build-templates.mjs --all --check",
    "check": "npm run content:check && npm run labs:check && npm run templates:check && npm run schema:check && npm run parts:check && npm run typecheck && npm run lint && npm run ui:check && npm run server:typecheck && npm run server:test && npm run test && npm run test:perf && npm run e2e"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@yowasp/yosys": "0.71.188-dev.1267",
    "ajv": "8.17.1",
    "avr8js": "0.21.1",
    "digitaljs": "0.14.2",
    "eecircuit-engine": "1.9.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yosys2digitaljs": "0.10.3"
  }
}
