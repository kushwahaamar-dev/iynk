{
  "name": "iynk-realtime",
  "version": "1.0.0",
  "private": true,
  "description": "iynk room relay: a WebSocket server that orders shared lab actions and fans out chat, cursors, presence and flight poses (HX-CONTRACT H7).",
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "load": "node test/load.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
