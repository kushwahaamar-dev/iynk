e.led-5mm","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"}],"libraries":[]},"ext":{"x-iynk-guided":{"complete":["checks","edit","quiz"],"gates":[],"mode":"guided","rung":"lesson","skill":["input","esp32-devkitc"],"starterSubstanceHash":"178a33996160694a488bb80f4c517a7e178fe2e1e9d820e6c632839ccb2770c4","starterTokensSha256":"86f1f8d1d367dbdd19be50b55240bdf866eac25ae7af885d424f2563c901d4b1","tests":["main"],"v":1}},"format":"iynk.project","guide":{"callouts":[{"target":"LED1","text":{"de":"Leuchtet, solange der Draht berührt wird.","en":"Lights while the wire is touched.","es":"Se enciende mientras tocas el cable.","fr":"S'allume tant que le fil est touché.","hi":"तार छुआ रहने तक जलती है।","zh":"导线被摸着时亮。"}}],"features":[{"icon":"tip","text":{"de":"Keine zusätzlichen Bauteile: Ein Draht ist der Sensor","en":"No extra parts: a wire is the sensor","es":"Sin piezas extra: un cable es el sensor","fr":"Aucun composant en plus : un fil fait office de capteur","hi":"कोई अतिरिक्त पुर्ज़ा नहीं: एक तार ही सेंसर है","zh":"不需要额外元件：一根导线就是传感器"}},{"icon":"info","text":{"de":"Die Werte werden zehnmal pro Sekunde ausgegeben","en":"Values print ten times a second","es":"Los valores se imprimen diez veces por segundo","fr":"Les valeurs s'affichent dix fois par seconde","hi":"मान सेकंड में दस बार छपते हैं","zh":"数值每秒打印十次"}},{"icon":"warn","text":{"de":"Touch-Messwerte driften mit dem Raum: Leg deine eigene Schwelle fest","en":"Touch readings drift with the room: set your own threshold","es":"Las lecturas táctiles cambian con la habitación: fija tu propio umbral","fr":"Les lectures tactiles dérivent avec la pièce : réglez votre propre seuil","hi":"टच रीडिंग कमरे के साथ खिसकती है: अपना थ्रेशोल्ड खुद सेट करें","zh":"触摸读数会随环境漂移：自己设定阈值"}}],"hints":[{"de":"Niedriger heißt berührt. Gib zuerst die Werte aus und wähl dann eine Schwelle in der Mitte.","en":"Lower means touched. Print the values first, then pick a threshold halfway.","es":"Más bajo significa tocado. Imprime primero los valores y luego elige un umbral a medio camino.","fr":"Plus bas veut dire touché. Affichez d'abord les valeurs, puis choisissez un seuil à mi-chemin.","hi":"कम का मतलब छुआ हुआ। पहले मान छापें, फिर बीचोंबीच एक थ्रेशोल्ड चुनें।","zh":"数值越低表示被摸到。先把数值打印出来，再取中间值作为阈值。"},{"de":"T0 ist GPIO4. Der ESP32 hat zehn Touch-Kanäle, T0 bis T9.","en":"T0 is GPIO4. The ESP32 has ten touch channels, T0 to T9.","es":"T0 es GPIO4. El ESP32 tiene diez canales táctiles, de T0 a T9.","fr":"T0, c'est GPIO4. L'ESP32 a dix canaux tactiles, de T0 à T9.","hi":"T0, GPIO4 है। ESP32 में दस टच चैनल हैं, T0 से T9।","zh":"T0 就是 GPIO4。ESP32 有十个触摸通道，T0 到 T9。"}],"kind":"lesson","lede":{"de":"Der ESP32 kann einen Finger an einem blanken Draht spüren. touchRead() misst die Kapazität des Pins: Die Zahl sinkt, wenn du den Draht an GPIO4 berührst.","en":"The ESP32 can feel a finger on a bare wire. touchRead() measures the pin's capacitance: the number drops when you touch the wire on GPIO4.","es":"El ESP32 puede notar un dedo sobre un cable desnudo. touchRead() mide la capacidad del pin: el número baja cuando tocas el cable de GPIO4.","fr":"L'ESP32 peut sentir un doigt sur un fil nu. touchRead() mesure la capacité de la broche : le nombre baisse quand vous touchez le fil sur GPIO4.","hi":"ESP32 एक खुले तार पर उँगली महसूस कर सकता है। touchRead() पिन का कैपेसिटेंस नापता है: GPIO4 वाले तार को छूने पर संख्या गिर जाती है।","zh":"ESP32 能感觉到手指碰到一根裸线。touchRead() 测量引脚的电容：你摸到 GPIO4 上的导线时，这个数会下降。"},"legacyFigure":{"circuit":"touch","page":"/figures/boards/esp32-devkitc.html","sheets":["board","breadboard","schematic","power"]},"level":"input","order":3,"pins":[{"color":"blue","pin":"GPIO4","role":{"de":"Kapazitiver Touch-Eingang","en":"Capacitive touch input","es":"Entrada táctil capacitiva","fr":"Entrée tactile capacitive","hi":"कैपेसिटिव टच इनपुट","zh":"电容式触摸输入"},"to":{"de":"Blanke Steckbrücke (die Touch-Fläche)","en":"Bare jumper wire (the touch pad)","es":"Cable desnudo (el pad táctil)","fr":"Fil de liaison nu (la zone tactile)","hi":"खुला जंपर तार (टच पैड)","zh":"裸跳线（触摸板）"}},{"color":"orange","pin":"GPIO23","role":{"de":"Ausgang, der die LED schaltet","en":"Output that switches the LED","es":"Salida que enciende y apaga el LED","fr":"Sortie qui commute la LED","hi":"LED को स्विच करने वाला आउटपुट","zh":"开关 LED 的输出"},"to":{"de":"220-Ω-Widerstand, dann die Anode der LED","en":"220 Ω resistor, then the LED's anode","es":"Resistencia de 220 Ω y luego el ánodo del LED","fr":"Résistance de 220 Ω, puis anode de la LED","hi":"220 Ω रेज़िस्टर, फिर LED का एनोड","zh":"220 Ω 电阻，再到 LED 的阳极"}},{"color":"black","pin":"GND","role":{"de":"Rückweg","en":"Return path","es":"Camino de vuelta","fr":"Chemin de retour","hi":"वापसी का रास्ता","zh":"回路"},"to":{"de":"Kathode der LED","en":"LED cathode","es":"Cátodo del LED","fr":"Cathode de la LED","hi":"LED का कैथोड","zh":"LED 阴极"}}],"quizzes":[{"id":"touch","questions":[{"answer":0,"id":"q1","options":[{"de":"Die Zahl sinkt","en":"The number drops","es":"El número baja","fr":"Le nombre baisse","hi":"संख्या गिर जाती है","zh":"数值下降"},{"de":"Die Zahl steigt Richtung 4095","en":"The number rises toward 4095","es":"El número sube hacia 4095","fr":"Le nombre monte vers 4095","hi":"संख्या 4095 की ओर बढ़ती है","zh":"数值升向 4095"},{"de":"Sie springt von 0 auf 1","en":"It switches from 0 to 1","es":"Pasa de 0 a 1","fr":"Il passe de 0 à 1","hi":"यह 0 से 1 हो जाता है","zh":"从 0 变成 1"}],"q":{"de":"Was passiert mit touchRead(T0), wenn du den Draht an GPIO4 berührst?","en":"What happens to touchRead(T0) when you touch the wire on GPIO4?","es":"¿Qué le pasa a touchRead(T0) cuando tocas el cable de GPIO4?","fr":"Que devient touchRead(T0) quand vous touchez le fil sur GPIO4 ?","hi":"GPIO4 वाले तार को छूने पर touchRead(T0) का क्या होता है?","zh":"你摸到 GPIO4 上的导线时，touchRead(T0) 会怎样？"},"why":{"de":"touchRead() misst die Kapazität des Pins, und die Zahl sinkt, solange ein Finger am Draht ist: hier von etwa 72 auf etwa 12.","en":"touchRead() measures the pin's capacitance, and the number falls while a finger is on the wire: here from about 72 to about 12.","es":"touchRead() mide la capacidad del pin, y el número baja mientras hay un dedo en el cable: aquí, de unos 72 a unos 12.","fr":"touchRead() mesure la capacité de la broche, et le nombre baisse tant qu'un doigt est sur le fil : ici, d'environ 72 à environ 12.","hi":"touchRead() पिन का कैपेसिटेंस नापता है, और तार पर उँगली रहने तक संख्या गिरी रहती है: यहाँ लगभग 72 से लगभग 12।","zh":"touchRead() 测量引脚的电容，手指放在导线上时数值会下降：这里从约 72 降到约 12。"}},{"answer":2,"id":"q2","options":[{"de":"70","en":"70","es":"70","fr":"70","hi":"70","zh":"70"},{"de":"5","en":"5","es":"5","fr":"5","hi":"5","zh":"5"},{"de":"40","en":"40","es":"40","fr":"40","hi":"40","zh":"40"}],"q":{"de":"Unberührt liest der Draht etwa 72, berührt etwa 12. Welche Schwelle passt am besten?","en":"Untouched, the wire reads about 72; touched, about 12. Which threshold works best?","es":"Sin tocar, el cable marca unos 72; al tocarlo, unos 12. ¿Qué umbral funciona mejor?","fr":"Sans toucher, le fil lit environ 72 ; touché, environ 12. Quel seuil marche le mieux ?","hi":"बिना छुए तार लगभग 72 पढ़ता है; छूने पर लगभग 12। कौन-सा थ्रेशोल्ड सबसे अच्छा है?","zh":"不摸时导线读数约 72，摸着时约 12。哪个阈值最好？"},"why":{"de":"Die Mitte lässt auf beiden Seiten Luft. Bei 70 lässt schon eine kleine Drift die LED leuchten, ohne dass jemand den Draht berührt, und eine Berührung kommt nie unter 5.","en":"Halfway leaves room on both sides. At 70 a small drift lights the LED with nobody touching it, and a touch never reads below 5.","es":"A medio camino queda margen por los dos lados. Con 70, una pequeña deriva enciende el LED sin que nadie lo toque, y un toque nunca baja de 5.","fr":"À mi-chemin, il reste de la marge des deux côtés. À 70, une petite dérive allume la LED sans que personne ne touche, et un toucher ne descend jamais sous 5.","hi":"बीचोंबीच दोनों तरफ़ गुंजाइश छोड़ता है। 70 पर थोड़ा-सा बहाव भी बिना किसी के छुए LED जला देता है, और छूने पर रीडिंग कभी 5 से नीचे नहीं जाती।","zh":"取中间值，两边都留有余量。设成 70 时，读数稍一漂移，没人摸 LED 也会亮；而摸着时读数永远不会低于 5。"}},{"answer":1,"id":"q3","options":[{"de":"Den Pin mit der Aufschrift 0","en":"The pin printed 0","es":"Al pin rotulado 0","fr":"La broche marquée 0","hi":"जिस पिन पर 0 छपा है","zh":"印着 0 的引脚"},{"de":"Den Pin mit der Aufschrift 4","en":"The pin printed 4","es":"Al pin rotulado 4","fr":"La broche marquée 4","hi":"जिस पिन पर 4 छपा है","zh":"印着 4 的引脚"},{"de":"Den Pin mit der Aufschrift 23","en":"The pin printed 23","es":"Al pin rotulado 23","fr":"La broche marquée 23","hi":"जिस पिन पर 23 छपा है","zh":"印着 23 的引脚"}],"q":{"de":"Du willst auf dem echten Board den Touch-Kanal T0. An welchen Pin der Stiftleiste schließt du den blanken Draht an?","en":"You want touch channel T0 on the real board. Which header pin do you wire the bare wire to?","es":"Quieres el canal táctil T0 en la placa real. ¿A qué pin de la tira conectas el cable desnudo?","fr":"Vous voulez le canal tactile T0 sur la vraie carte. Sur quelle broche du connecteur câblez-vous le fil nu ?","hi":"आपको असली बोर्ड पर टच चैनल T0 चाहिए। खुला तार किस हेडर पिन से जोड़ेंगे?","zh":"你想在真实的板子上用触摸通道 T0。裸线应该接到哪个排针引脚？"},"why":{"de":"T0 ist GPIO4. Die Touch-Nummern folgen nicht den GPIO-Nummern: GPIO0 direkt daneben auf der Stiftleiste ist T1 und zugleich der Boot-Taster.","en":"T0 is GPIO4. The touch numbers don't follow the GPIO numbers: GPIO0, next to it on the header, is T1 and also the Boot button.","es":"T0 es GPIO4. Los números táctiles no siguen los números de GPIO: GPIO0, a su lado en la tira, es T1 y además el botón Boot.","fr":"T0, c'est GPIO4. Les numéros tactiles ne suivent pas les numéros de GPIO : GPIO0, juste à côté sur le connecteur, est T1 et aussi le bouton Boot.","hi":"T0, GPIO4 है। टच नंबर GPIO नंबरों के हिसाब से नहीं चलते: हेडर पर उसके बगल वाला GPIO0, T1 है और Boot बटन भी।","zh":"T0 就是 GPIO4。触摸通道的编号和 GPIO 编号不一致：排针上紧挨着它的 GPIO0 是 T1，同时也是 Boot 按钮。"}}]}],"serialSample":{"baud":115200,"lines":["72","72","12","12","72"]},"specs":[{"label":{"de":"Touch-Pin","en":"Touch pin","es":"Pin táctil","fr":"Broche tactile","hi":"टच पिन","zh":"触摸引脚"},"value":{"de":"T0 = GPIO4 (auch ADC2)","en":"T0 = GPIO4 (also ADC2)","es":"T0 = GPIO4 (también ADC2)","fr":"T0 = GPIO4 (aussi ADC2)","hi":"T0 = GPIO4 (ADC2 भी)","zh":"T0 = GPIO4（也属于 ADC2）"}},{"label":{"de":"Messwerte hier","en":"Readings here","es":"Lecturas aquí","fr":"Lectures ici","hi":"यहाँ की रीडिंग","zh":"这里的读数"},"value":{"de":"etwa 72 ohne Berührung, 12 mit Berührung; echte Werte hängen vom Draht ab","en":"about 72 untouched, 12 touched; real values depend on the wire","es":"unas 72 sin tocar, 12 tocado; los valores reales dependen del cable","fr":"environ 72 sans contact, 12 au toucher ; les vraies valeurs dépendent du fil","hi":"बिना छुए लगभग 72, छूने पर 12; असली मान तार पर निर्भर करते हैं","zh":"没摸时约 72，摸着时约 12；真实数值取决于导线"}}],"starter":{"source":"src_sketch","template":"// T0 is GPIO4: touchRead() drops when a finger is near\nconst int TOUCH_PIN = T0;\nconst int LED_PIN = 23;\nconst int THRESHOLD = {{p:threshold}};\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(LED_PIN, OUTPUT);\n}\n\nvoid loop() {\n  int value = touchRead(TOUCH_PIN);\n  Serial.println(value);\n  // A lower reading means a touch\n  digitalWrite(LED_PIN, value < THRESHOLD ? HIGH : LOW);\n  delay(100);\n}\n"},"steps":[{"de":"Steck eine Steckbrücke von GPIO4 in eine freie Reihe: Ihr freies Ende ist deine Touch-Fläche.","en":"Add a jumper from GPIO4 to an empty row: its free end is your touch pad.","es":"Pon un cable de GPIO4 a una fila vacía: su extremo libre es tu pad táctil.","fr":"Ajoutez un fil de liaison de GPIO4 vers une rangée vide : son extrémité libre est votre zone tactile.","hi":"GPIO4 से एक खाली कतार तक जंपर लगाएँ: उसका खुला सिरा आपका टच पैड है।","zh":"从 GPIO4 接一根跳线到一个空行：它空着的一端就是你的触摸板。"},{"de":"Führ den Sketch aus und berühr den Draht; sieh im seriellen Monitor zu, wie die Zahlen fallen.","en":"Run the sketch and touch the wire; watch the numbers fall in the serial monitor.","es":"Ejecuta el sketch y toca el cable; mira cómo bajan los números en el monitor serie.","fr":"Lancez le sketch et touchez le fil ; regardez les nombres baisser dans le moniteur série.","hi":"स्केच चलाएँ और तार छुएँ; सीरियल मॉनिटर में संख्याएँ गिरती देखें।","zh":"运行程序并摸一下导线；在串口监视器里看数字下降。"},{"de":"Schieb den Chip für die Schwelle zwischen die Werte mit und ohne Berührung.","en":"Move the threshold chip between the touched and untouched values.","es":"Mueve el botón del umbral entre los valores con y sin toque.","fr":"Placez la pastille du seuil entre les valeurs touchée et non touchée.","hi":"थ्रेशोल्ड वाली चिप को छुए और बिना छुए मानों के बीच ले जाएँ।","zh":"把阈值选项调到摸着和没摸时的数值之间。"}],"title":{"de":"Touch-Sensor an T0","en":"Touch sensor on T0","es":"Sensor táctil en T0","fr":"Capteur tactile sur T0","hi":"T0 पर टच सेंसर","zh":"T0 上的触摸传感器"}},"history":{"baseChain":"e204adeba27890900ca50eaab45d125d0961fb76885077e2f9263bb1d27051b7","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_esp32-devkitc-touch","license":{"spdx":"LicenseRef-iynk-pending"},"meta":{"createdAt":"2026-01-01T00:00:00.000Z","description":"The ESP32 can feel a finger on a bare wire. touchRead() measures the pin's capacitance: the number drops when you touch the wire on GPIO4.","kind":"lesson","locale":"en","tags":["esp32-devkitc","lesson","input"],"title":"Touch sensor on T0","updatedAt":"2026-01-01T00:00:00.000Z"},"nets":[{"class":"ground","connections":[{"c":"brd_main","p":"GND"},{"c":"cmp_led1","p":"K"}],"id":"net_gnd","name":"GND"},{"class":"signal","connections":[{"c":"brd_main","p":"GPIO23"},{"c":"cmp_r1","p":"P1"}],"id":"net_gpio23","name":"GPIO23"},{"class":"signal","connections":[{"c":"brd_main","p":"GPIO4"}],"id":"net_gpio4","name":"GPIO4"},{"class":"signal","connections":[{"c":"cmp_led1","p":"A"},{"c":"cmp_r1","p":"P2"}],"id":"net_led1a_r1p2"}],"parameters":[{"id":"par_threshold","kind":"number","label":{"de":"Schwelle","en":"Threshold","es":"Umbral","fr":"Seuil","hi":"थ्रेशोल्ड","zh":"阈值"},"max":70,"min":15,"name":"threshold","step":5,"value":40}],"provenance":{"contributors":[],"createdBy":"usr_iynk","createdWith":{"app":"iynk","version":"0.1.0"},"origin":{"at":"2026-01-01T00:00:00.000Z","catalogue":{"child":"touch","id":"esp32-devkitc","lab":"board"},"kind":"migration","tool":"iynk-catalogue-convert/0.1"},"thirdParty":[{"id":"tp1","kind":"text","review":"unchecked","source":{"title":"Third-party lesson sites named in D-017"},"what":"Lesson order, wording and timings may follow a third-party lesson site (F-197 review pending)"}]},"revision":0,"schemaVersion":"1.1","simulation":{"duration_ms":2500,"faults":[],"runtimes":[{"board":"brd_main","engine":"iynk-interp","id":"rtm_main"}],"seed":625341585,"solver":{"engine":"iynk-mna"},"world":{"inputs":[{"component":"brd_main","default":0,"device":{"kind":"switch"},"gesture":"tap","id":"finger","label":{"de":"Finger am Draht","en":"Finger on the wire","es":"Dedo en el cable","fr":"Doigt sur le fil","hi":"तार पर उँगली","zh":"手指碰导线"},"max":1,"min":0,"pins":[{"c":"brd_main","p":"GPIO4"}],"quantity":"touch","step":1}],"script":[{"input":"finger","t":1000,"value":1},{"input":"finger","t":1600,"value":0}]}},"sources":[{"board":"brd_main","content":"// T0 is GPIO4: touchRead() drops when a finger is near\nconst int TOUCH_PIN = T0;\nconst int LED_PIN = 23;\nconst int THRESHOLD = 40;\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(LED_PIN, OUTPUT);\n}\n\nvoid loop() {\n  int value = touchRead(TOUCH_PIN);\n  Serial.println(value);\n  // A lower reading means a touch\n  digitalWrite(LED_PIN, value < THRESHOLD ? HIGH : LOW);\n  delay(100);\n}\n","id":"src_sketch","language":"arduino-cpp","path":"sketch.ino","role":"firmware"}],"tests":[{"checks":[{"after":{"input":"finger","t":1000,"value":1},"id":"c1","kind":"responds","label":{"de":"Eine Berührung des Drahts lässt die LED leuchten","en":"Touching the wire lights the LED","es":"Tocar el cable enciende el LED","fr":"Toucher le fil allume la LED","hi":"तार छूने पर LED जलती है","zh":"摸导线时 LED 亮起"},"mode":"out","pin":"GPIO23","v":[1,1],"visibility":"visible","withinMs":250},{"atMs":2200,"id":"c2","kind":"pin-level","label":{"de":"Loslassen schaltet sie aus","en":"Letting go turns it off","es":"Al soltarlo se apaga","fr":"Le lâcher l'éteint","hi":"छोड़ने पर वह बुझ जाती है","zh":"松开时它熄灭"},"level":0,"pin":"GPIO23","visibility":"visible"},{"id":"c3","kind":"serial","label":{"de":"Die Messwerte laufen in den seriellen Monitor","en":"The readings stream to the serial monitor","es":"Las lecturas llegan sin parar al monitor serie","fr":"Les lectures défilent dans le moniteur série","hi":"रीडिंग लगातार सीरियल मॉनिटर में आती हैं","zh":"读数持续输出到串口监视器"},"match":"^\\d+$","minCount":10,"regex":true,"visibility":"visible"}],"id":"main","name":{"de":"Touch-Sensor an T0","en":"Touch sensor on T0","es":"Sensor táctil en T0","fr":"Capteur tactile sur T0","hi":"T0 पर टच सेंसर","zh":"T0 上的触摸传感器"},"runMs":2500}],"views":[{"id":"vw_bb","kind":"breadboard","name":"Breadboard","placements":[{"c":"brd_main","x_mm":-90,"y_mm":0},{"c":"cmp_bb","x_mm":0,"y_mm":0},{"c":"cmp_led1","legs":{"A":"c14","K":"c15"},"x_mm":0,"y_mm":0},{"c":"cmp_r1","legs":{"P1":"b10","P2":"b14"},"x_mm":0,"y_mm":0}],"surface":"cmp_bb","wires":[{"color":"orange","from":{"c":"brd_main","kind":"pin","p":"GPIO23"},"id":"wir_1","net":"net_gpio23","to":{"hole":"a10","kind":"hole","surface":"cmp_bb"}},{"color":"black","from":{"c":"brd_main","kind":"pin","p":"GND"},"id":"wir_2","net":"net_gnd","to":{"hole":"a15","kind":"hole","surface":"cmp_bb"}},{"color":"blue","from":{"c":"brd_main","kind":"pin","p":"GPIO4"},"id":"wir_3","net":"net_gpio4","to":{"hole":"a3","kind":"hole","surface":"cmp_bb"}}]}]}
