e.led-5mm","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"}],"libraries":[]},"ext":{"x-iynk-guided":{"complete":["checks","edit","quiz"],"gates":[],"mode":"guided","rung":"lesson","skill":["input","esp32-devkitc"],"starterSubstanceHash":"b96c90a22ec7a0723e3c9f35d38b6a5c7077ec57cc369c1578f106e3da7c7c9e","starterTokensSha256":"d6df47bdd1e00bc79e2fe3029b61719dc6161bc046798a4b5a3e831f6c4e2a87","tests":["main"],"v":1}},"format":"iynk.project","guide":{"callouts":[{"target":"SW1","text":{"de":"Boot-Taster: Drück ihn, während der Sketch läuft.","en":"Boot button: press it while the sketch runs.","es":"Botón Boot: púlsalo mientras se ejecuta el sketch.","fr":"Bouton Boot : appuyez dessus pendant que le sketch tourne.","hi":"Boot बटन: स्केच चलते समय इसे दबाएँ।","zh":"Boot 按钮：程序运行时按它。"}},{"target":"LED1","text":{"de":"Schaltet bei jedem Druck um.","en":"Toggles on every press.","es":"Cambia con cada pulsación.","fr":"Bascule à chaque appui.","hi":"हर दबाव पर पलटती है।","zh":"每按一次就切换一次。"}}],"features":[{"icon":"board","text":{"de":"Nutzt den Taster, der schon auf dem Board sitzt","en":"Uses the button already on the board","es":"Usa el botón que ya está en la placa","fr":"Utilise le bouton déjà présent sur la carte","hi":"बोर्ड पर पहले से लगा बटन इस्तेमाल करता है","zh":"用板上现成的按钮"}},{"icon":"tip","text":{"de":"Entprellt mit millis(), ohne delay()","en":"Debounced with millis(), no delay()","es":"Antirrebote con millis(), sin delay()","fr":"Anti-rebond avec millis(), sans delay()","hi":"millis() से डिबाउंस, delay() के बिना","zh":"用 millis() 消抖，不用 delay()"}},{"icon":"warn","text":{"de":"GPIO0 ist auch ein Strapping-Pin","en":"GPIO0 is also a strapping pin","es":"GPIO0 también es un pin de arranque","fr":"GPIO0 est aussi une broche de strapping","hi":"GPIO0 एक स्ट्रैपिंग पिन भी है","zh":"GPIO0 也是启动配置引脚"}}],"hints":[{"de":"Gedrückt liest LOW: Der Taster verbindet GPIO0 mit GND, sonst hält ihn der Pull-up auf HIGH.","en":"Pressed reads LOW: the button connects GPIO0 to GND and the pull-up holds it HIGH otherwise.","es":"Pulsado lee LOW: el botón conecta GPIO0 a GND y, si no, la pull-up lo mantiene en HIGH.","fr":"Un appui se lit LOW : le bouton relie GPIO0 à GND, et le pull-up le maintient à HIGH le reste du temps.","hi":"दबाने पर LOW पढ़ता है: बटन GPIO0 को GND से जोड़ता है और वरना पुल-अप उसे HIGH रखता है।","zh":"按下时读到 LOW：按钮把 GPIO0 接到 GND，否则上拉电阻让它保持 HIGH。"},{"de":"Hältst du Boot gedrückt, während du EN drückst, passiert etwas anderes: Der Chip wartet auf einen Upload, statt deinen Sketch auszuführen.","en":"Holding Boot while you press EN does something else: the chip waits for an upload instead of running your sketch.","es":"Mantener Boot mientras pulsas EN hace otra cosa: el chip espera una carga en lugar de ejecutar tu sketch.","fr":"Maintenir Boot pendant que vous appuyez sur EN fait autre chose : la puce attend un téléversement au lieu de lancer votre sketch.","hi":"EN दबाते समय Boot दबाए रखने से कुछ और होता है: चिप आपका स्केच चलाने के बजाय अपलोड का इंतज़ार करती है।","zh":"按住 Boot 的同时按 EN 就是另一回事了：芯片会等待上传，而不是运行你的程序。"}],"kind":"lesson","lede":{"de":"Boot ist mit GPIO0 verdrahtet. Sobald der Sketch läuft, ist er ein gewöhnlicher Taster: Lies ihn mit INPUT_PULLUP, entprell ihn mit millis() und schalte die LED um.","en":"Boot is wired to GPIO0. Once the sketch is running it is an ordinary button: read it with INPUT_PULLUP, debounce it with millis() and toggle the LED.","es":"Boot está conectado a GPIO0. Con el sketch en marcha es un botón normal: léelo con INPUT_PULLUP, quítale los rebotes con millis() y cambia el LED.","fr":"Boot est câblé sur GPIO0. Une fois le sketch lancé, c'est un bouton ordinaire : lisez-le avec INPUT_PULLUP, filtrez ses rebonds avec millis() et basculez la LED.","hi":"Boot, GPIO0 से जुड़ा है। स्केच चलने के बाद यह एक आम बटन है: इसे INPUT_PULLUP से पढ़ें, millis() से डिबाउंस करें और LED को पलटें।","zh":"Boot 接在 GPIO0 上。程序运行起来之后，它就是一个普通按钮：用 INPUT_PULLUP 读取它，用 millis() 消抖，并切换 LED。"},"legacyFigure":{"circuit":"boot-button","page":"/figures/boards/esp32-devkitc.html","sheets":["board","breadboard","schematic","power"]},"level":"input","order":2,"pins":[{"color":"yellow","pin":"GPIO0","role":{"de":"Eingang mit internem Pull-up","en":"Input with the internal pull-up","es":"Entrada con la pull-up interna","fr":"Entrée avec le pull-up interne","hi":"अंदर वाले पुल-अप के साथ इनपुट","zh":"使用内部上拉的输入"},"to":{"de":"Boot-Taster (auf dem Board)","en":"Boot button (on the board)","es":"Botón Boot (en la placa)","fr":"Bouton Boot (sur la carte)","hi":"Boot बटन (बोर्ड पर)","zh":"Boot 按钮（在板上）"}},{"color":"orange","pin":"GPIO23","role":{"de":"Ausgang, der die LED schaltet","en":"Output that switches the LED","es":"Salida que enciende y apaga el LED","fr":"Sortie qui commute la LED","hi":"LED को स्विच करने वाला आउटपुट","zh":"开关 LED 的输出"},"to":{"de":"220-Ω-Widerstand, dann die Anode der LED","en":"220 Ω resistor, then the LED's anode","es":"Resistencia de 220 Ω y luego el ánodo del LED","fr":"Résistance de 220 Ω, puis anode de la LED","hi":"220 Ω रेज़िस्टर, फिर LED का एनोड","zh":"220 Ω 电阻，再到 LED 的阳极"}},{"color":"black","pin":"GND","role":{"de":"Rückweg","en":"Return path","es":"Camino de vuelta","fr":"Chemin de retour","hi":"वापसी का रास्ता","zh":"回路"},"to":{"de":"Kathode der LED","en":"LED cathode","es":"Cátodo del LED","fr":"Cathode de la LED","hi":"LED का कैथोड","zh":"LED 阴极"}}],"quizzes":[{"id":"boot-button","questions":[{"answer":1,"id":"q1","options":[{"de":"HIGH","en":"HIGH","es":"HIGH","fr":"HIGH","hi":"HIGH","zh":"HIGH"},{"de":"LOW","en":"LOW","es":"LOW","fr":"LOW","hi":"LOW","zh":"LOW"},{"de":"Zufällig eins von beiden: Der Pin ist offen","en":"Either, at random: the pin floats","es":"Cualquiera, al azar: el pin está al aire","fr":"L'un ou l'autre, au hasard : la broche est flottante","hi":"कोई भी, बेतरतीब: पिन खुला है","zh":"随机二者之一：引脚悬空"}],"q":{"de":"Dein Sketch setzt GPIO0 auf INPUT_PULLUP. Was liefert digitalRead(0), solange du Boot gedrückt hältst?","en":"Your sketch sets GPIO0 to INPUT_PULLUP. What does digitalRead(0) return while you hold Boot down?","es":"Tu sketch pone GPIO0 en INPUT_PULLUP. ¿Qué devuelve digitalRead(0) mientras mantienes pulsado Boot?","fr":"Votre sketch configure GPIO0 en INPUT_PULLUP. Que renvoie digitalRead(0) tant que vous maintenez Boot ?","hi":"आपका स्केच GPIO0 को INPUT_PULLUP पर सेट करता है। Boot दबाए रखने पर digitalRead(0) क्या लौटाता है?","zh":"你的程序把 GPIO0 设为 INPUT_PULLUP。按住 Boot 时 digitalRead(0) 返回什么？"},"why":{"de":"Der Pull-up hält GPIO0 auf HIGH, und der Taster verbindet ihn mit GND, also liest gedrückt LOW.","en":"The pull-up holds GPIO0 HIGH, and the button connects it to GND, so pressed reads LOW.","es":"La pull-up mantiene GPIO0 en HIGH, y el botón lo conecta a GND, así que pulsado lee LOW.","fr":"Le pull-up maintient GPIO0 à HIGH et le bouton le relie à GND : un appui se lit donc LOW.","hi":"पुल-अप GPIO0 को HIGH रखता है, और बटन उसे GND से जोड़ता है, इसलिए दबाने पर LOW पढ़ता है।","zh":"上拉电阻让 GPIO0 保持 HIGH，按钮把它接到 GND，所以按下时读到 LOW。"}},{"answer":2,"id":"q2","options":[{"de":"Die LED schaltet einmal um","en":"The LED toggles once","es":"El LED cambia una vez","fr":"La LED bascule une fois","hi":"LED एक बार पलटती है","zh":"LED 切换一次"},{"de":"Der Sketch startet neu","en":"The sketch starts again","es":"El sketch vuelve a empezar","fr":"Le sketch redémarre","hi":"स्केच फिर से शुरू होता है","zh":"程序重新开始"},{"de":"Der Chip wartet auf einen Upload","en":"The chip waits for an upload","es":"El chip espera una carga","fr":"La puce attend un téléversement","hi":"चिप अपलोड का इंतज़ार करती है","zh":"芯片等待上传"}],"q":{"de":"Du hältst Boot gedrückt und tippst kurz auf EN. Was passiert dann?","en":"You hold Boot and tap EN. What happens next?","es":"Mantienes Boot y das un toque a EN. ¿Qué pasa después?","fr":"Vous maintenez Boot et appuyez brièvement sur EN. Que se passe-t-il ensuite ?","hi":"आप Boot दबाए रखते हैं और EN को एक बार दबाते हैं। आगे क्या होता है?","zh":"你按住 Boot，再点一下 EN。接下来会怎样？"},"why":{"de":"GPIO0 ist ein Strapping-Pin: LOW beim Reset wählt den Download-Modus. Lass Boot los und tipp noch einmal auf EN, damit dein Sketch läuft.","en":"GPIO0 is a strapping pin: LOW at reset selects download mode. Release Boot and tap EN again to run your sketch.","es":"GPIO0 es un pin de arranque: LOW en el reinicio elige el modo de descarga. Suelta Boot y vuelve a tocar EN para ejecutar tu sketch.","fr":"GPIO0 est une broche de strapping : LOW au reset sélectionne le mode téléchargement. Relâchez Boot et appuyez de nouveau sur EN pour lancer votre sketch.","hi":"GPIO0 एक स्ट्रैपिंग पिन है: रीसेट पर LOW डाउनलोड मोड चुनता है। अपना स्केच चलाने के लिए Boot छोड़ें और फिर EN दबाएँ।","zh":"GPIO0 是启动配置引脚：复位时为 LOW 就会进入下载模式。松开 Boot，再点一下 EN，你的程序才会运行。"}},{"answer":0,"id":"q3","options":[{"de":"Die Kontakte prellen beim Schließen","en":"The contacts bounce as they close","es":"Los contactos rebotan al cerrarse","fr":"Les contacts rebondissent en se fermant","hi":"बंद होते समय कॉन्टैक्ट उछलते हैं","zh":"触点闭合时会抖动"},{"de":"Der Pull-up ist zu schwach","en":"The pull-up is too weak","es":"La pull-up es demasiado débil","fr":"Le pull-up est trop faible","hi":"पुल-अप बहुत कमज़ोर है","zh":"上拉电阻太弱"},{"de":"GPIO0 ist ein Strapping-Pin","en":"GPIO0 is a strapping pin","es":"GPIO0 es un pin de arranque","fr":"GPIO0 est une broche de strapping","hi":"GPIO0 एक स्ट्रैपिंग पिन है","zh":"GPIO0 是启动配置引脚"}],"q":{"de":"Ohne Entprellung zählt ein Druck manchmal zwei- oder dreimal. Warum?","en":"Without the debounce, one press sometimes counts two or three times. Why?","es":"Sin el antirrebote, una pulsación a veces cuenta dos o tres veces. ¿Por qué?","fr":"Sans l'anti-rebond, un appui compte parfois deux ou trois fois. Pourquoi ?","hi":"डिबाउंस के बिना एक दबाव कभी-कभी दो या तीन बार गिना जाता है। क्यों?","zh":"没有消抖时，按一次有时会被计两三次。为什么？"},"why":{"de":"Metallkontakte flattern beim Schließen ein paar Millisekunden lang. Der Sketch zählt eine Änderung erst, wenn der Messwert 30 ms lang still steht, gemessen mit millis().","en":"Metal contacts chatter for a few milliseconds as they close. The sketch only counts a change once the reading has held still for 30 ms, timed with millis().","es":"Los contactos metálicos vibran unos milisegundos al cerrarse. El sketch solo cuenta un cambio cuando la lectura lleva 30 ms quieta, medidos con millis().","fr":"Des contacts métalliques vibrent pendant quelques millisecondes en se fermant. Le sketch ne compte un changement qu'une fois la lecture stable pendant 30 ms, mesurées avec millis().","hi":"धातु के कॉन्टैक्ट बंद होते समय कुछ मिलीसेकंड तक कंपकंपाते हैं। स्केच कोई बदलाव तभी गिनता है जब रीडिंग 30 ms तक स्थिर रहे, जिसे millis() से मापा जाता है।","zh":"金属触点闭合时会抖动几毫秒。程序只在读数稳定 30 ms 之后才计一次变化，用 millis() 计时。"}}]}],"serialSample":{"baud":115200,"lines":["Press Boot to toggle the LED","Press 1: LED on","Press 2: LED off"]},"specs":[{"label":{"de":"Boot-Taster","en":"Boot button","es":"Botón Boot","fr":"Bouton Boot","hi":"Boot बटन","zh":"Boot 按钮"},"value":{"de":"GPIO0 nach GND; gedrückt = LOW","en":"GPIO0 to GND; pressed = LOW","es":"GPIO0 a GND; pulsado = LOW","fr":"GPIO0 vers GND ; appuyé = LOW","hi":"GPIO0 से GND; दबाने पर = LOW","zh":"GPIO0 接 GND；按下 = LOW"}},{"label":{"de":"Entprellen","en":"Debounce","es":"Antirrebote","fr":"Anti-rebond","hi":"डिबाउंस","zh":"消抖"},"value":{"de":"30 ms nach der letzten Änderung","en":"30 ms after the last change","es":"30 ms después del último cambio","fr":"30 ms après le dernier changement","hi":"आखिरी बदलाव के 30 ms बाद","zh":"最后一次变化后 30 ms"}}],"starter":{"source":"src_sketch","template":"// Boot is GPIO0: it reads LOW while pressed\nconst int BUTTON_PIN = 0;\nconst int LED_PIN = 23;\nconst unsigned long DEBOUNCE_MS = {{p:debounce}};\n\nbool ledOn = false;\nint lastReading = HIGH;\nint stableLevel = HIGH;\nunsigned long lastChange = 0;\nint presses = 0;\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(BUTTON_PIN, INPUT_PULLUP);\n  pinMode(LED_PIN, OUTPUT);\n  Serial.println(\"Press Boot to toggle the LED\");\n}\n\nvoid loop() {\n  int reading = digitalRead(BUTTON_PIN);\n  if (reading != lastReading) {\n    // The contacts bounce: wait until the reading stops changing\n    lastChange = millis();\n    lastReading = reading;\n  }\n  if (millis() - lastChange > DEBOUNCE_MS && reading != stableLevel) {\n    stableLevel = reading;\n    if (stableLevel == LOW) {\n      ledOn = !ledOn;\n      digitalWrite(LED_PIN, ledOn ? HIGH : LOW);\n      presses++;\n      Serial.print(\"Press \");\n      Serial.print(presses);\n      Serial.println(ledOn ? \": LED on\" : \": LED off\");\n    }\n  }\n}\n"},"steps":[{"de":"Behalte die LED an GPIO23 aus der ersten Lektion.","en":"Keep the LED on GPIO23 from the first lesson.","es":"Deja el LED en GPIO23 de la primera lección.","fr":"Gardez la LED sur GPIO23 de la première leçon.","hi":"पहले पाठ वाली GPIO23 की LED लगी रहने दें।","zh":"保留第一节课里接在 GPIO23 上的 LED。"},{"de":"Führ den Sketch aus und drück dann Boot auf dem Board (oder im Inspektor).","en":"Run the sketch, then press Boot on the board (or in the inspector).","es":"Ejecuta el sketch y luego pulsa Boot en la placa (o en el inspector).","fr":"Lancez le sketch, puis appuyez sur Boot sur la carte (ou dans l'inspecteur).","hi":"स्केच चलाएँ, फिर बोर्ड पर (या इंस्पेक्टर में) Boot दबाएँ।","zh":"运行程序，然后按板上（或检查器里）的 Boot。"},{"de":"Jeder Druck schaltet die LED um und gibt die Anzahl aus.","en":"Each press toggles the LED and prints the count.","es":"Cada pulsación cambia el LED e imprime la cuenta.","fr":"Chaque appui bascule la LED et affiche le compte.","hi":"हर दबाव LED को पलटता है और गिनती छापता है।","zh":"每按一次，LED 切换一次，并打印次数。"}],"title":{"de":"Den Boot-Taster lesen","en":"Read the Boot button","es":"Lee el botón Boot","fr":"Lire le bouton Boot","hi":"Boot बटन पढ़ें","zh":"读取 Boot 按钮"}},"history":{"baseChain":"0f724d5942395bdd7acc39f2cd0bbd0b66c9ead554a354075f17f08a8ec393ad","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_esp32-devkitc-boot-button","license":{"spdx":"LicenseRef-iynk-pending"},"meta":{"createdAt":"2026-01-01T00:00:00.000Z","description":"Boot is wired to GPIO0. Once the sketch is running it is an ordinary button: read it with INPUT_PULLUP, debounce it with millis() and toggle the LED.","kind":"lesson","locale":"en","tags":["esp32-devkitc","lesson","input"],"title":"Read the Boot button","updatedAt":"2026-01-01T00:00:00.000Z"},"nets":[{"class":"ground","connections":[{"c":"brd_main","p":"GND"},{"c":"cmp_led1","p":"K"}],"id":"net_gnd","name":"GND"},{"class":"signal","connections":[{"c":"brd_main","p":"GPIO23"},{"c":"cmp_r1","p":"P1"}],"id":"net_gpio23","name":"GPIO23"},{"class":"signal","connections":[{"c":"cmp_led1","p":"A"},{"c":"cmp_r1","p":"P2"}],"id":"net_led1a_r1p2"}],"parameters":[{"id":"par_debounce","kind":"number","label":{"de":"Entprellzeit","en":"Debounce time","es":"Tiempo de antirrebote","fr":"Durée d'anti-rebond","hi":"डिबाउंस का समय","zh":"消抖时间"},"max":200,"min":5,"name":"debounce","step":5,"value":30}],"provenance":{"contributors":[],"createdBy":"usr_iynk","createdWith":{"app":"iynk","version":"0.1.0"},"origin":{"at":"2026-01-01T00:00:00.000Z","catalogue":{"child":"boot-button","id":"esp32-devkitc","lab":"board"},"kind":"migration","tool":"iynk-catalogue-convert/0.1"},"thirdParty":[{"id":"tp1","kind":"text","review":"unchecked","source":{"title":"Third-party lesson sites named in D-017"},"what":"Lesson order, wording and timings may follow a third-party lesson site (F-197 review pending)"}]},"revision":0,"schemaVersion":"1.1","simulation":{"duration_ms":3000,"faults":[],"runtimes":[{"board":"brd_main","engine":"iynk-interp","id":"rtm_main"}],"seed":625341585,"solver":{"engine":"iynk-mna"},"world":{"inputs":[{"component":"brd_main","default":0,"device":{"bounceMs":5,"kind":"button","pull":"internal-up"},"gesture":"press","id":"boot","label":{"de":"Boot-Taster","en":"Boot button","es":"Botón Boot","fr":"Bouton Boot","hi":"Boot बटन","zh":"Boot 按钮"},"max":1,"min":0,"pins":[{"c":"brd_main","p":"GPIO0"}],"quantity":"button","step":1}],"script":[{"input":"boot","t":1000,"value":1},{"input":"boot","t":1300,"value":0},{"input":"boot","t":2000,"value":1},{"input":"boot","t":2300,"value":0}]}},"sources":[{"board":"brd_main","content":"// Boot is GPIO0: it reads LOW while pressed\nconst int BUTTON_PIN = 0;\nconst int LED_PIN = 23;\nconst unsigned long DEBOUNCE_MS = 30;\n\nbool ledOn = false;\nint lastReading = HIGH;\nint stableLevel = HIGH;\nunsigned long lastChange = 0;\nint presses = 0;\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(BUTTON_PIN, INPUT_PULLUP);\n  pinMode(LED_PIN, OUTPUT);\n  Serial.println(\"Press Boot to toggle the LED\");\n}\n\nvoid loop() {\n  int reading = digitalRead(BUTTON_PIN);\n  if (reading != lastReading) {\n    // The contacts bounce: wait until the reading stops changing\n    lastChange = millis();\n    lastReading = reading;\n  }\n  if (millis() - lastChange > DEBOUNCE_MS && reading != stableLevel) {\n    stableLevel = reading;\n    if (stableLevel == LOW) {\n      ledOn = !ledOn;\n      digitalWrite(LED_PIN, ledOn ? HIGH : LOW);\n      presses++;\n      Serial.print(\"Press \");\n      Serial.print(presses);\n      Serial.println(ledOn ? \": LED on\" : \": LED off\");\n    }\n  }\n}\n","id":"src_sketch","language":"arduino-cpp","path":"sketch.ino","role":"firmware"}],"tests":[{"checks":[{"after":{"input":"boot","t":1000,"value":1},"id":"c1","kind":"responds","label":{"de":"Der erste Druck schaltet die LED ein","en":"The first press turns the LED on","es":"La primera pulsación enciende el LED","fr":"Le premier appui allume la LED","hi":"पहला दबाव LED जलाता है","zh":"第一次按下让 LED 亮起"},"mode":"out","pin":"GPIO23","v":[1,1],"visibility":"visible","withinMs":250},{"atMs":2800,"id":"c2","kind":"pin-level","label":{"de":"Der zweite Druck schaltet sie wieder aus","en":"The second press turns it off again","es":"La segunda lo vuelve a apagar","fr":"Le deuxième appui l'éteint à nouveau","hi":"दूसरा दबाव उसे फिर बुझाता है","zh":"第二次按下让它再次熄灭"},"level":0,"pin":"GPIO23","visibility":"visible"},{"id":"c3","kind":"serial","label":{"de":"Jeder Druck wird genau einmal gezählt","en":"Every press is counted once","es":"Cada pulsación se cuenta una sola vez","fr":"Chaque appui est compté une seule fois","hi":"हर दबाव एक ही बार गिना जाता है","zh":"每次按下只计一次"},"match":"Press 2: LED off","minCount":1,"regex":false,"visibility":"visible"},{"id":"c4","kind":"code","label":{"de":"Nutzt INPUT_PULLUP und millis() zum Entprellen","en":"Uses INPUT_PULLUP and millis() for debouncing","es":"Usa INPUT_PULLUP y millis() para el antirrebote","fr":"Utilise INPUT_PULLUP et millis() pour l'anti-rebond","hi":"डिबाउंस के लिए INPUT_PULLUP और millis() इस्तेमाल करता है","zh":"用 INPUT_PULLUP 和 millis() 消抖"},"must":["INPUT_PULLUP","millis()"],"mustNot":[],"visibility":"visible"}],"id":"main","name":{"de":"Den Boot-Taster lesen","en":"Read the Boot button","es":"Lee el botón Boot","fr":"Lire le bouton Boot","hi":"Boot बटन पढ़ें","zh":"读取 Boot 按钮"},"runMs":3000}],"views":[{"id":"vw_bb","kind":"breadboard","name":"Breadboard","placements":[{"c":"brd_main","x_mm":-90,"y_mm":0},{"c":"cmp_bb","x_mm":0,"y_mm":0},{"c":"cmp_led1","legs":{"A":"c14","K":"c15"},"x_mm":0,"y_mm":0},{"c":"cmp_r1","legs":{"P1":"b10","P2":"b14"},"x_mm":0,"y_mm":0}],"surface":"cmp_bb","wires":[{"color":"orange","from":{"c":"brd_main","kind":"pin","p":"GPIO23"},"id":"wir_1","net":"net_gpio23","to":{"hole":"a10","kind":"hole","surface":"cmp_bb"}},{"color":"black","from":{"c":"brd_main","kind":"pin","p":"GND"},"id":"wir_2","net":"net_gnd","to":{"hole":"a15","kind":"hole","surface":"cmp_bb"}}]}]}
