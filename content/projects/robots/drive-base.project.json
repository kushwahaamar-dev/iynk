  "sources": [
    {
      "board": "brd_uno",
      "content": "// Open-loop drive base: forward for 2 s, turn left 90 degrees, stop. No sensors, so the timings are the whole plan.\nconst int PWMA = 5, AIN1 = 7, AIN2 = 8;      // left motor\nconst int PWMB = 6, BIN1 = 10, BIN2 = 4;     // right motor\nconst int STBY = 9;\n\nconst int CRUISE = 120;              // out of 255; the pack is 7.4 V and the motors are 6 V\nconst int SPIN = 120;                // each wheel at this speed, in opposite directions\nconst unsigned long FORWARD_MS = 2000;\nconst unsigned long TURN_MS = 300;   // about 90 degrees at SPIN (iynk estimate; tune it on the floor)\n\nvoid wheel(int in1, int in2, int pwm, int speed) {\n  digitalWrite(in1, speed >= 0 ? HIGH : LOW);\n  digitalWrite(in2, speed >= 0 ? LOW : HIGH);\n  analogWrite(pwm, constrain(abs(speed), 0, 255));\n}\n\nvoid drive(int left, int right) {\n  wheel(AIN1, AIN2, PWMA, left);\n  wheel(BIN1, BIN2, PWMB, right);\n}\n\nvoid setup() {\n  Serial.begin(9600);\n  for (int p = 4; p <= 10; p++) pinMode(p, OUTPUT);\n  digitalWrite(STBY, HIGH);\n  Serial.println(\"drive: forward 2 s, turn 90, stop\");\n\n  drive(CRUISE, CRUISE);\n  delay(FORWARD_MS);\n  drive(-SPIN, SPIN);\n  delay(TURN_MS);\n  drive(0, 0);\n  Serial.println(\"done\");\n}\n\nvoid loop() {\n}\n",
      "id": "src_drive",
      "language": "arduino-cpp",
      "path": "drive.ino",
      "role": "firmware"
    }
  ],
