yellow","green","blue","white"]}],"pins":[{"class":"passive","designator":"A","id":"A","type":"passive"},{"class":"passive","designator":"K","id":"K","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.led-5mm","version":"1.0.0"},{"interface":{"groups":[{"id":"g_a","kind":"internal-short","pins":["P1","P2"]},{"id":"g_b","kind":"internal-short","pins":["P3","P4"]}],"params":[],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"},{"class":"passive","designator":"3","id":"P3","type":"passive"},{"class":"passive","designator":"4","id":"P4","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.push-button-6mm","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"},{"interface":{"groups":[{"id":"g_D11","kind":"internal-short","pins":["D11","ICSP_4"]},{"id":"g_D12","kind":"internal-short","pins":["D12","ICSP_1"]},{"id":"g_D13","kind":"internal-short","pins":["D13","ICSP_3"]},{"id":"g_GND","kind":"internal-short","pins":["GND","POWER_6","POWER_7","ICSP_6","ICSP1_6"]},{"id":"g_RESET","kind":"internal-short","pins":["RESET","ICSP_5"]},{"id":"g_P5V","kind":"internal-short","pins":["P5V","ICSP_2","ICSP1_2"]}],"params":[],"pins":[{"class":"digital","designator":"D0","header":"IOL","id":"D0","net":"D0","type":"digital_io"},{"class":"digital","designator":"D1","header":"IOL","id":"D1","net":"D1","type":"digital_io"},{"class":"digital","designator":"D2","header":"IOL","id":"D2","net":"D2","type":"digital_io"},{"class":"digital","designator":"~D3","header":"IOL","id":"D3","net":"D3","type":"digital_io"},{"class":"digital","designator":"D4","header":"IOL","id":"D4","net":"D4","type":"digital_io"},{"class":"digital","designator":"~D5","header":"IOL","id":"D5","net":"D5","type":"digital_io"},{"class":"digital","designator":"~D6","header":"IOL","id":"D6","net":"D6","type":"digital_io"},{"class":"digital","designator":"D7","header":"IOL","id":"D7","net":"D7","type":"digital_io"},{"class":"digital","designator":"D8","header":"IOH","id":"D8","net":"D8","type":"digital_io"},{"class":"digital","designator":"~D9","header":"IOH","id":"D9","net":"D9","type":"digital_io"},{"class":"digital","designator":"~D10","header":"IOH","id":"D10","net":"D10","type":"digital_io"},{"class":"digital","designator":"~D11","header":"IOH","id":"D11","net":"D11","type":"digital_io"},{"class":"digital","designator":"D12","header":"IOH","id":"D12","net":"D12","type":"digital_io"},{"class":"digital","designator":"D13","header":"IOH","id":"D13","net":"D13","type":"digital_io"},{"class":"ground","designator":"GND","header":"IOH","id":"GND","net":"GND","type":"ground"},{"class":"analog","designator":"AREF","header":"IOH","id":"AREF","net":"AREF","type":"analog_in"},{"class":"digital","designator":"SDA","header":"IOH","id":"SDA","net":"SDA","type":"digital_io"},{"class":"digital","designator":"SCL","header":"IOH","id":"SCL","net":"SCL","type":"digital_io"},{"class":"nc","designator":"NC","header":"POWER","id":"NC","net":"NC","type":"nc"},{"class":"power","designator":"IOREF","header":"POWER","id":"IOREF","net":"IOREF","type":"power_io"},{"class":"digital","designator":"RESET","header":"POWER","id":"RESET","net":"RESET","type":"digital_io"},{"class":"power","designator":"3V3","header":"POWER","id":"P3V3","net":"3V3","type":"power_io"},{"class":"power","designator":"5V","header":"POWER","id":"P5V","net":"5V","type":"power_io"},{"class":"ground","designator":"GND","header":"POWER","id":"POWER_6","net":"GND","type":"ground"},{"class":"ground","designator":"GND","header":"POWER","id":"POWER_7","net":"GND","type":"ground"},{"class":"power","designator":"VIN","header":"POWER","id":"VIN","net":"VIN","type":"power_io"},{"class":"digital","designator":"A0","header":"AD","id":"A0","net":"A0","type":"digital_io"},{"class":"digital","designator":"A1","header":"AD","id":"A1","net":"A1","type":"digital_io"},{"class":"digital","designator":"A2","header":"AD","id":"A2","net":"A2","type":"digital_io"},{"class":"digital","designator":"A3","header":"AD","id":"A3","net":"A3","type":"digital_io"},{"class":"digital","designator":"A4","header":"AD","id":"A4","net":"A4","type":"digital_io"},{"class":"digital","designator":"A5","header":"AD","id":"A5","net":"A5","type":"digital_io"},{"class":"digital","designator":"MISO","header":"ICSP","id":"ICSP_1","net":"D12","type":"digital_io"},{"class":"power","designator":"5V","header":"ICSP","id":"ICSP_2","net":"5V","type":"power_io"},{"class":"digital","designator":"SCK","header":"ICSP","id":"ICSP_3","net":"D13","type":"digital_io"},{"class":"digital","designator":"MOSI","header":"ICSP","id":"ICSP_4","net":"D11","type":"digital_io"},{"class":"digital","designator":"RESET","header":"ICSP","id":"ICSP_5","net":"RESET","type":"digital_io"},{"class":"ground","designator":"GND","header":"ICSP","id":"ICSP_6","net":"GND","type":"ground"},{"class":"digital","designator":"MISO2","header":"ICSP1","id":"MISO2","net":"MISO2","type":"digital_io"},{"class":"power","designator":"5V","header":"ICSP1","id":"ICSP1_2","net":"5V","type":"power_io"},{"class":"digital","designator":"SCK2","header":"ICSP1","id":"SCK2","net":"SCK2","type":"digital_io"},{"class":"digital","designator":"MOSI2","header":"ICSP1","id":"MOSI2","net":"MOSI2","type":"digital_io"},{"class":"digital","designator":"RESET2","header":"ICSP1","id":"RESET2","net":"RESET2","type":"digital_io"},{"class":"ground","designator":"GND","header":"ICSP1","id":"ICSP1_6","net":"GND","type":"ground"}],"role":"board"},"origin":"builtin","ref":"core.uno-r3","version":"1.0.0"}],"libraries":[]},"ext":{"x-iynk-solution":"// pin 13: the L LED and the LED on the breadboard; D2: button to GND\nconst int LED = 13;\nconst int BTN = 2;\n\nvolatile unsigned long fellAt = 0;\nvolatile bool fell = false;\n\nunsigned long goAt = 0;\nunsigned long litAt = 0;\nunsigned long pressAt = 0;\nbool lit = false;\nbool pending = false;\n\n// keep an interrupt short: note the time and set a flag\nvoid onFall() {\n  fellAt = millis();\n  fell = true;\n}\n\nvoid newRound() {\n  digitalWrite(LED, LOW);\n  lit = false;\n  goAt = millis() + random(1000, 3001);\n}\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(LED, OUTPUT);\n  pinMode(BTN, INPUT_PULLUP);\n  randomSeed(analogRead(A0));              // A0 floats, so every game is different\n  attachInterrupt(digitalPinToInterrupt(BTN), onFall, FALLING);\n  newRound();\n}\n\nvoid loop() {\n  if (!lit && (long)(millis() - goAt) >= 0) {\n    digitalWrite(LED, HIGH);\n    litAt = millis();\n    lit = true;\n  }\n\n  noInterrupts();\n  bool got = fell;\n  unsigned long at = fellAt;\n  fell = false;\n  interrupts();\n  if (got && !pending) {\n    pending = true;\n    pressAt = at;\n  }\n\n  // debounce: count the edge only if the button is still down 20 ms later\n  if (pending && millis() - pressAt >= 20) {\n    pending = false;\n    if (digitalRead(BTN) == LOW) {\n      if (lit) {\n        Serial.print(\"Reaction: \");\n        Serial.print(pressAt - litAt);\n        Serial.println(\" ms\");\n      } else {\n        Serial.println(\"Too soon!\");\n      }\n      newRound();\n    }\n  }\n}\n"},"format":"iynk.project","guide":{"hints":[{"de":"attachInterrupt(digitalPinToInterrupt(2), onFall, FALLING) führt onFall in dem Moment aus, in dem D2 fällt. Halt die Interrupt-Routine kurz: millis() in einer volatile-Variablen merken und ein Flag setzen.","en":"attachInterrupt(digitalPinToInterrupt(2), onFall, FALLING) runs onFall the moment D2 falls. Keep the interrupt routine short: note millis() in a volatile variable and set a flag.","es":"attachInterrupt(digitalPinToInterrupt(2), onFall, FALLING) ejecuta onFall en el instante en que D2 baja. Haz corta la rutina de interrupción: apunta millis() en una variable volatile y activa una bandera.","fr":"attachInterrupt(digitalPinToInterrupt(2), onFall, FALLING) exécute onFall dès que D2 descend. Gardez la routine d'interruption courte : notez millis() dans une variable volatile et levez un drapeau.","hi":"attachInterrupt(digitalPinToInterrupt(2), onFall, FALLING), D2 के गिरते ही onFall चलाता है। इंटरप्ट रूटीन को छोटा रखें: एक volatile वेरिएबल में millis() लिखें और एक फ़्लैग सेट करें।","zh":"attachInterrupt(digitalPinToInterrupt(2), onFall, FALLING) 会在 D2 下降的那一刻运行 onFall。中断程序要短：把 millis() 记到一个 volatile 变量里，再设置一个标志。"},{"de":"Kontakte prellen beim Drücken ein paar Millisekunden lang und beim Loslassen noch einmal. Zähl eine Flanke nur, wenn der Pin 20 ms später immer noch LOW liest.","en":"Contacts bounce for a few milliseconds when pressed and again when released. Count an edge only if the pin still reads LOW 20 ms later.","es":"Los contactos rebotan durante unos milisegundos al pulsar y otra vez al soltar. Cuenta un flanco solo si el pin sigue leyendo LOW 20 ms después.","fr":"Les contacts rebondissent pendant quelques millisecondes à l'appui, puis de nouveau au relâchement. Ne comptez un front que si la broche lit encore LOW 20 ms plus tard.","hi":"दबाते समय और छोड़ते समय कॉन्टैक्ट कुछ मिलीसेकंड तक उछलते हैं। किसी एज को तभी गिनें जब 20 ms बाद भी पिन LOW पढ़े।","zh":"触点在按下时和松开时都会抖动几毫秒。只有 20 ms 后引脚仍然读到 LOW，才算一次边沿。"},{"de":"Kein delay(): Speicher, wann die LED angehen soll, millis() + random(1000, 3001), und vergleich in loop() mit (long)(millis() - goAt) >= 0, was auch den Überlauf von millis() übersteht.","en":"No delay(): store when the LED should light, millis() + random(1000, 3001), and compare in loop() with (long)(millis() - goAt) >= 0, which survives the millis() roll-over.","es":"Sin delay(): guarda cuándo debe encenderse el LED, millis() + random(1000, 3001), y compara en loop() con (long)(millis() - goAt) >= 0, que sobrevive al desbordamiento de millis().","fr":"Pas de delay() : enregistrez le moment où la LED doit s'allumer, millis() + random(1000, 3001), et comparez dans loop() avec (long)(millis() - goAt) >= 0, qui résiste au débordement de millis().","hi":"delay() नहीं: यह सहेजें कि LED कब जलनी चाहिए, millis() + random(1000, 3001), और loop() में (long)(millis() - goAt) >= 0 से तुलना करें, जो millis() के रोल-ओवर में भी सही रहता है।","zh":"不用 delay()：记下 LED 应该亮起的时间 millis() + random(1000, 3001)，并在 loop() 里用 (long)(millis() - goAt) >= 0 来比较，这样即使 millis() 溢出也没问题。"},{"de":"Kopier, was der Interrupt schreibt, bei ausgeschalteten Interrupts (noInterrupts() … interrupts()): Ein unsigned long hat 4 Bytes, und der AVR liest ihn Byte für Byte.","en":"Copy what the interrupt writes with interrupts off (noInterrupts() … interrupts()): an unsigned long is 4 bytes, and the AVR reads it one byte at a time.","es":"Copia lo que escribe la interrupción con las interrupciones desactivadas (noInterrupts() … interrupts()): un unsigned long ocupa 4 bytes, y el AVR lo lee byte a byte.","fr":"Copiez ce qu'écrit l'interruption avec les interruptions coupées (noInterrupts() … interrupts()) : un unsigned long fait 4 octets, et l'AVR le lit un octet à la fois.","hi":"इंटरप्ट जो लिखता है उसे इंटरप्ट बंद करके कॉपी करें (noInterrupts() … interrupts()): unsigned long 4 बाइट का है, और AVR उसे एक-एक बाइट पढ़ता है।","zh":"关掉中断后再复制中断写入的数据（noInterrupts() … interrupts()）：unsigned long 有 4 个字节，而 AVR 一次只读一个字节。"}],"kind":"challenge","lede":{"de":"Bau auf dem Board, das du gerade gebaut hast, ein Reaktionsspiel. Die LED an Pin 13 leuchtet nach zufälligen 1 bis 3 s auf; der Spieler drückt so schnell er kann den Taster an D2 (nach GND verdrahtet), und die Zeit von der LED bis zum Druck wird ausgegeben, zum Beispiel als Reaction: 312 ms. Ein Druck vor der LED gibt Too soon! aus. Nach jedem Druck geht die LED aus, und eine neue Runde beginnt. Fang den Druck mit einem Interrupt an D2 ab, entprell ihn und miss alle Zeiten mit millis(), niemals mit delay().","en":"Build a reaction-timer game on the board you just built. The LED on pin 13 lights after a random 1 to 3 s; the player presses the button on D2 (wired to GND) as fast as they can, and the time from the LED to the press prints as, for example, Reaction: 312 ms. A press before the LED prints Too soon!. After every press the LED goes out and a new round starts. Catch the press with an interrupt on D2, debounce it, and time everything with millis(), never delay().","es":"Construye un juego de reflejos en la placa que acabas de montar. El LED del pin 13 se enciende tras una espera al azar de 1 a 3 s; el jugador pulsa lo más rápido que pueda el botón de D2 (conectado a GND), y el tiempo desde el LED hasta la pulsación se imprime como, por ejemplo, Reaction: 312 ms. Una pulsación antes del LED imprime Too soon!. Después de cada pulsación el LED se apaga y empieza una ronda nueva. Captura la pulsación con una interrupción en D2, quítale los rebotes y mide todo con millis(), nunca con delay().","fr":"Créez un jeu de réflexes sur la carte que vous venez de monter. La LED de la broche 13 s'allume après une attente aléatoire de 1 à 3 s ; le joueur appuie le plus vite possible sur le bouton de D2 (relié à GND), et le temps entre la LED et l'appui s'affiche, par exemple, sous la forme Reaction: 312 ms. Un appui avant la LED affiche Too soon!. Après chaque appui, la LED s'éteint et une nouvelle manche commence. Captez l'appui avec une interruption sur D2, filtrez les rebonds, et chronométrez tout avec millis(), jamais avec delay().","hi":"अभी बनाए बोर्ड पर एक रिएक्शन-टाइमर गेम बनाएँ। पिन 13 वाली LED 1 से 3 s के किसी बेतरतीब समय के बाद जलती है; खिलाड़ी D2 वाला बटन (GND से जुड़ा) जितनी जल्दी हो सके दबाता है, और LED जलने से दबाने तक का समय इस तरह छपता है, उदाहरण के लिए Reaction: 312 ms। LED जलने से पहले दबाने पर Too soon! छपता है। हर दबाव के बाद LED बुझ जाती है और नया दौर शुरू होता है। दबाव को D2 पर इंटरप्ट से पकड़ें, उसे डिबाउंस करें, और सारा समय millis() से नापें, कभी delay() से नहीं।","zh":"在你刚组装好的板子上做一个反应计时游戏。13 号引脚上的 LED 在随机的 1 到 3 s 后亮起；玩家尽快按下 D2 上的按钮（接到 GND），从 LED 亮到按下的时间被打印出来，例如 Reaction: 312 ms。在 LED 亮之前按下则打印 Too soon!。每次按下后 LED 熄灭，开始新的一轮。用 D2 上的中断捕捉按下，做消抖，所有计时都用 millis()，永远不要用 delay()。"},"legacyFigure":{"circuit":"reaction-timer","page":"/figures/boards/uno-r3.html","sheets":["board","breadboard","schematic","power"]},"starter":{"source":"src_sketch","template":"// This works, but it is blind: delay() and a polling loop miss presses\nconst int LED = 13;   // pin 13: the L LED and the LED on the breadboard; D2: button to GND\nconst int BTN = 2;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(LED, OUTPUT);\n  pinMode(BTN, INPUT_PULLUP);\n}\n\nvoid loop() {\n  digitalWrite(LED, LOW);\n  delay(random(1000, 3001));               // blocks: a press now goes unseen\n  digitalWrite(LED, HIGH);\n  unsigned long litAt = millis();\n  while (digitalRead(BTN) == HIGH) {       // polling: it waits here, no interrupt\n  }\n  Serial.print(\"Reaction: \");\n  Serial.print(millis() - litAt);\n  Serial.println(\" ms\");\n}\n"},"title":{"de":"Reaktionstest","en":"Reaction timer","es":"Medidor de reflejos","fr":"Chronomètre de réflexes","hi":"रिएक्शन टाइमर","zh":"反应计时器"}},"history":{"baseChain":"f4f7e4e2d187ea9ebb6dd19cfc1c6a126d2ad33ed99b302a33448b1f83f51017","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_robotics-uno-r3-build-reaction-timer","license":{"spdx":"LicenseRef-iynk-pending"},"meta":{"createdAt":"2026-01-01T00:00:00.000Z","description":"Build a reaction-timer game on the board you just built. The LED on pin 13 lights after a random 1 to 3 s; the player presses the button on D2 (wired to GND) as fast as they can, and the time from the LED to the press prints as, for example, Reaction: 312 ms. A press before the LED prints Too soon!. After every press the LED goes out and a new round starts. Catch the press with an interrupt on D2, debounce it, and time everything with millis(), never delay().","kind":"challenge","locale":"en","tags":["uno-r3-build","challenge","uno-r3"],"title":"Reaction timer","updatedAt":"2026-01-01T00:00:00.000Z"},"nets":[{"class":"signal","connections":[{"c":"brd_main","p":"D13"},{"c":"cmp_r3","p":"P1"}],"id":"net_d13","name":"D13"},{"class":"signal","connections":[{"c":"brd_main","p":"D2"},{"c":"cmp_sw1","p":"P1"}],"id":"net_d2","name":"D2"},{"class":"ground","connections":[{"c":"brd_main","p":"GND"},{"c":"cmp_led1","p":"K"},{"c":"cmp_sw1","p":"P3"}],"id":"net_gnd","name":"GND"},{"class":"signal","connections":[{"c":"cmp_led1","p":"A"},{"c":"cmp_r3","p":"P2"}],"id":"net_led1a_r3p2"}],"parameters":[],"provenance":{"contributors":[],"createdBy":"usr_iynk","createdWith":{"app":"iynk","version":"0.1.0"},"origin":{"at":"2026-01-01T00:00:00.000Z","catalogue":{"child":"reaction-timer","id":"uno-r3-build","lab":"robotics"},"kind":"migration","tool":"iynk-catalogue-convert/0.1"},"thirdParty":[{"id":"tp1","kind":"text","review":"unchecked","source":{"title":"Third-party lesson sites named in D-017"},"what":"Task wording, checks and timings may follow a third-party exercise site (F-197 review pending)"}]},"revision":0,"schemaVersion":"1.1","simulation":{"duration_ms":8000,"faults":[],"runtimes":[{"board":"brd_main","engine":"iynk-interp","id":"rtm_main"}],"seed":625341585,"solver":{"engine":"iynk-mna"},"world":{"inputs":[{"component":"cmp_sw1","default":0,"device":{"bounceMs":8,"kind":"button","pull":"internal-up"},"gesture":"press","id":"button","label":{"de":"Taster an D2","en":"Button on D2","es":"Botón en D2","fr":"Bouton sur D2","hi":"D2 पर बटन","zh":"D2 上的按钮"},"max":1,"min":0,"pins":[{"c":"brd_main","p":"D2"}],"quantity":"button","step":1}],"script":[{"input":"button","t":3400,"value":1},{"input":"button","t":3520,"value":0},{"input":"button","t":3700,"value":1},{"input":"button","t":3820,"value":0},{"input":"button","t":7500,"value":1},{"input":"button","t":7620,"value":0}]}},"sources":[{"board":"brd_main","content":"// This works, but it is blind: delay() and a polling loop miss presses\nconst int LED = 13;   // pin 13: the L LED and the LED on the breadboard; D2: button to GND\nconst int BTN = 2;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(LED, OUTPUT);\n  pinMode(BTN, INPUT_PULLUP);\n}\n\nvoid loop() {\n  digitalWrite(LED, LOW);\n  delay(random(1000, 3001));               // blocks: a press now goes unseen\n  digitalWrite(LED, HIGH);\n  unsigned long litAt = millis();\n  while (digitalRead(BTN) == HIGH) {       // polling: it waits here, no interrupt\n  }\n  Serial.print(\"Reaction: \");\n  Serial.print(millis() - litAt);\n  Serial.println(\" ms\");\n}\n","id":"src_sketch","language":"arduino-cpp","path":"sketch.ino","role":"firmware"}],"tests":[{"checks":[{"id":"c1","kind":"code","label":{"de":"Nutzt attachInterrupt, INPUT_PULLUP und millis() und niemals delay()","en":"Uses attachInterrupt, INPUT_PULLUP and millis(), and never delay()","es":"Usa attachInterrupt, INPUT_PULLUP y millis(), y nunca delay()","fr":"Utilise attachInterrupt, INPUT_PULLUP et millis(), et jamais delay()","hi":"attachInterrupt, INPUT_PULLUP और millis() इस्तेमाल करता है, और कभी delay() नहीं","zh":"使用了 attachInterrupt、INPUT_PULLUP 和 millis()，从不使用 delay()"},"must":["attachInterrupt","INPUT_PULLUP","millis()"],"mustNot":["delay("],"visibility":"visible"},{"atMs":500,"id":"c2","kind":"pin-level","label":{"de":"Die LED bleibt zuerst dunkel","en":"The LED stays dark at first","es":"Al principio el LED sigue apagado","fr":"La LED reste d'abord éteinte","hi":"शुरुआत में LED बुझी रहती है","zh":"LED 一开始保持熄灭"},"level":0,"pin":"D13","visibility":"visible"},{"atMs":3050,"id":"c3","kind":"pin-level","label":{"de":"Die LED leuchtet innerhalb von 3 s","en":"The LED lights within 3 s","es":"El LED se enciende en menos de 3 s","fr":"La LED s'allume en moins de 3 s","hi":"LED 3 s के अंदर जलती है","zh":"LED 在 3 s 内亮起"},"level":1,"pin":"D13","visibility":"visible"},{"after":{"input":"button","t":3400,"value":1},"id":"c4","kind":"responds","label":{"de":"Ein Druck schaltet die LED sofort aus und startet eine neue Runde","en":"A press puts the LED out at once and starts a new round","es":"Una pulsación apaga el LED al instante y empieza una ronda nueva","fr":"Un appui éteint aussitôt la LED et lance une nouvelle manche","hi":"दबाने पर LED तुरंत बुझती है और नया दौर शुरू होता है","zh":"按下后 LED 立即熄灭，并开始新的一轮"},"mode":"out","pin":"D13","v":[0,0],"visibility":"visible","withinMs":60},{"byMs":3500,"id":"c5","kind":"serial","label":{"de":"Gibt die Reaktionszeit aus, zum Beispiel Reaction: 312 ms","en":"Prints the reaction time, for example Reaction: 312 ms","es":"Imprime el tiempo de reacción, por ejemplo Reaction: 312 ms","fr":"Affiche le temps de réaction, par exemple Reaction: 312 ms","hi":"रिएक्शन टाइम छापता है, उदाहरण के लिए Reaction: 312 ms","zh":"打印反应时间，例如 Reaction: 312 ms"},"match":"^Reaction: \\d+ ms$","minCount":1,"regex":true,"visibility":"visible"},{"byMs":3800,"id":"c6","kind":"serial","label":{"de":"Ein Druck vor der LED gibt Too soon! aus","en":"A press before the LED prints Too soon!","es":"Una pulsación antes del LED imprime Too soon!","fr":"Un appui avant la LED affiche Too soon!","hi":"LED से पहले दबाने पर Too soon! छापता है","zh":"在 LED 亮起之前按下会打印 Too soon!"},"match":"Too soon!","minCount":1,"regex":false,"visibility":"visible"}],"id":"main","name":{"de":"Reaktionstest","en":"Reaction timer","es":"Medidor de reflejos","fr":"Chronomètre de réflexes","hi":"रिएक्शन टाइमर","zh":"反应计时器"},"runMs":8000}],"views":[{"id":"vw_bb","kind":"breadboard","name":"Breadboard","placements":[{"c":"brd_main","x_mm":-90,"y_mm":0},{"c":"cmp_bb","x_mm":0,"y_mm":0},{"c":"cmp_led1","legs":{"A":"c14","K":"c15"},"x_mm":0,"y_mm":0},{"c":"cmp_r3","legs":{"P1":"b10","P2":"b14"},"x_mm":0,"y_mm":0},{"c":"cmp_sw1","legs":{"P1":"e20","P2":"f20","P3":"e22","P4":"f22"},"x_mm":0,"y_mm":0}],"surface":"cmp_bb","wires":[{"color":"orange","from":{"c":"brd_main","kind":"pin","p":"D13"},"id":"wir_1","net":"net_d13","to":{"hole":"a10","kind":"hole","surface":"cmp_bb"}},{"color":"