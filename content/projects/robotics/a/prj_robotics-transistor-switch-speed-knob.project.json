digital","designator":"A1","header":"J2","id":"A1","net":"A1","type":"digital_io"},{"class":"digital","designator":"A0","header":"J2","id":"A0","net":"A0","type":"digital_io"},{"class":"digital","designator":"REF","header":"J2","id":"AREF","net":"AREF","type":"digital_io"},{"class":"power","designator":"3.3V","header":"J2","id":"P3V3","net":"3V3","type":"power_io"},{"class":"digital","designator":"D13","header":"J2","id":"D13","net":"D13","type":"digital_io"},{"class":"digital","designator":"MISO","header":"J4","id":"J4_1","net":"D12","type":"digital_io"},{"class":"power","designator":"5V","header":"J4","id":"J4_2","net":"5V","type":"power_io"},{"class":"digital","designator":"SCK","header":"J4","id":"J4_3","net":"D13","type":"digital_io"},{"class":"digital","designator":"MOSI","header":"J4","id":"J4_4","net":"D11","type":"digital_io"},{"class":"digital","designator":"RESET","header":"J4","id":"J4_5","net":"RESET","type":"digital_io"},{"class":"ground","designator":"GND","header":"J4","id":"J4_6","net":"GND","type":"ground"}],"role":"board"},"origin":"builtin","ref":"core.nano","version":"1.0.0"},{"interface":{"params":[{"default":10000,"id":"ohms","max":1000000,"min":1000,"type":"number","unit":"ohm"},{"default":0.5,"id":"pos","max":1,"min":0,"type":"number","unit":"1"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"W","id":"W","type":"passive"},{"class":"passive","designator":"3","id":"P3","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.potentiometer-10k","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"},{"interface":{"params":[],"pins":[{"class":"passive","designator":"B","id":"B","type":"passive"},{"class":"passive","designator":"C","id":"C","type":"passive"},{"class":"passive","designator":"E","id":"E","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.tip120","version":"1.0.0"},{"interface":{"params":[],"pins":[{"class":"passive","designator":"+","id":"PLUS","type":"passive"},{"class":"passive","designator":"-","id":"MINUS","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.tt-motor","version":"1.0.0"}],"libraries":[]},"ext":{"x-iynk-solution":"const int POT = A0;\nconst int MOTOR = 9;\nconst int MIN_DUTY = 40;\n\nvoid setup() {\n  pinMode(MOTOR, OUTPUT);\n}\n\nvoid loop() {\n  int raw = analogRead(POT);\n  int duty = map(raw, 0, 1023, 0, 255);\n  if (duty < MIN_DUTY) {\n    duty = 0;\n  }\n  analogWrite(MOTOR, duty);\n}\n"},"format":"iynk.project","guide":{"hints":[{"de":"map(raw, 0, 1023, 0, 255) skaliert den Messwert.","en":"map(raw, 0, 1023, 0, 255) scales the reading.","es":"map(raw, 0, 1023, 0, 255) escala la lectura.","fr":"map(raw, 0, 1023, 0, 255) met la lecture à l'échelle.","hi":"map(raw, 0, 1023, 0, 255) रीडिंग का पैमाना बदलता है।","zh":"map(raw, 0, 1023, 0, 255) 缩放读数。"},{"de":"if (duty < 40) duty = 0; ergibt das Totband.","en":"if (duty < 40) duty = 0; gives the dead band.","es":"if (duty < 40) duty = 0; da la zona muerta.","fr":"if (duty < 40) duty = 0; donne la zone morte.","hi":"if (duty < 40) duty = 0; डेड बैंड देता है।","zh":"if (duty < 40) duty = 0; 就是死区。"},{"de":"analogWrite(9, 0) und analogWrite(9, 255) ergeben ein stetiges LOW und HIGH.","en":"analogWrite(9, 0) and analogWrite(9, 255) give a steady LOW and HIGH.","es":"analogWrite(9, 0) y analogWrite(9, 255) dan un LOW y un HIGH fijos.","fr":"analogWrite(9, 0) et analogWrite(9, 255) donnent un LOW et un HIGH stables.","hi":"analogWrite(9, 0) और analogWrite(9, 255) स्थिर LOW और HIGH देते हैं।","zh":"analogWrite(9, 0) 和 analogWrite(9, 255) 给出稳定的 LOW 和 HIGH。"}],"kind":"challenge","lede":{"de":"Ein 10-kΩ-Potentiometer an A0 stellt die Motordrehzahl ein. Bilde seinen Messwert von 0-1023 auf 0-255 für analogWrite() ab und schalte den Motor unter einem Tastverhältnis von 40 ganz ab, wo der TT-Motor nur brummt und heiß wird, statt sich zu drehen.","en":"A 10 kΩ potentiometer on A0 sets the motor speed. Map its 0-1023 reading onto 0-255 for analogWrite(), and switch the motor fully off below a duty of 40, where the TT motor only hums and heats instead of turning.","es":"Un potenciómetro de 10 kΩ en A0 fija la velocidad del motor. Convierte su lectura de 0-1023 a 0-255 para analogWrite(), y apaga del todo el motor por debajo de un ciclo de trabajo de 40, donde el motor TT solo zumba y se calienta en lugar de girar.","fr":"Un potentiomètre de 10 kΩ sur A0 règle la vitesse du moteur. Convertissez sa lecture de 0-1023 en 0-255 pour analogWrite(), et coupez complètement le moteur sous un rapport cyclique de 40, où le moteur TT ne fait que bourdonner et chauffer au lieu de tourner.","hi":"A0 पर एक 10 kΩ पोटेंशियोमीटर मोटर की गति तय करता है। analogWrite() के लिए उसकी 0-1023 रीडिंग को 0-255 पर मैप करें, और 40 से कम ड्यूटी पर मोटर को पूरी तरह बंद करें, जहाँ TT मोटर घूमने के बजाय बस भनभनाती और गरम होती है।","zh":"接在 A0 上的 10 kΩ 电位器设定电机转速。把它 0-1023 的读数映射到 analogWrite() 的 0-255，并在占空比低于 40 时把电机完全关掉，因为在那里 TT 电机只会嗡嗡响、发热，而不会转动。"},"legacyFigure":{"circuit":"speed-knob","page":"/figures/boards/nano.html","sheets":["board","breadboard","schematic","power"]},"starter":{"source":"src_sketch","template":"// Set the motor speed from the knob on A0\nconst int POT = A0;\nconst int MOTOR = 9;\n\nvoid setup() {\n  pinMode(MOTOR, OUTPUT);\n}\n\nvoid loop() {\n  int raw = analogRead(POT);   // 0 to 1023\n  // scale raw to a duty, add a dead band, then analogWrite() it\n}\n"},"title":{"de":"Drehzahlknopf","en":"Speed knob","es":"Mando de velocidad","fr":"Molette de vitesse","hi":"गति का नॉब","zh":"调速旋钮"}},"history":{"baseChain":"76eccbeb2ed978a16e0a99ffaed16f542e480eacef3da7b3ee5ffb87f999f073","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_robotics-tran