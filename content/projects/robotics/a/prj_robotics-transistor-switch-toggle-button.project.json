2","id":"A1","net":"A1","type":"digital_io"},{"class":"digital","designator":"A0","header":"J2","id":"A0","net":"A0","type":"digital_io"},{"class":"digital","designator":"REF","header":"J2","id":"AREF","net":"AREF","type":"digital_io"},{"class":"power","designator":"3.3V","header":"J2","id":"P3V3","net":"3V3","type":"power_io"},{"class":"digital","designator":"D13","header":"J2","id":"D13","net":"D13","type":"digital_io"},{"class":"digital","designator":"MISO","header":"J4","id":"J4_1","net":"D12","type":"digital_io"},{"class":"power","designator":"5V","header":"J4","id":"J4_2","net":"5V","type":"power_io"},{"class":"digital","designator":"SCK","header":"J4","id":"J4_3","net":"D13","type":"digital_io"},{"class":"digital","designator":"MOSI","header":"J4","id":"J4_4","net":"D11","type":"digital_io"},{"class":"digital","designator":"RESET","header":"J4","id":"J4_5","net":"RESET","type":"digital_io"},{"class":"ground","designator":"GND","header":"J4","id":"J4_6","net":"GND","type":"ground"}],"role":"board"},"origin":"builtin","ref":"core.nano","version":"1.0.0"},{"interface":{"groups":[{"id":"g_a","kind":"internal-short","pins":["P1","P2"]},{"id":"g_b","kind":"internal-short","pins":["P3","P4"]}],"params":[],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"},{"class":"passive","designator":"3","id":"P3","type":"passive"},{"class":"passive","designator":"4","id":"P4","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.push-button-6mm","version":"1.0.0"},{"interface":{"params":[{"default":220,"id":"ohms","max":1000000000,"min":0.001,"type":"number","unit":"ohm"}],"pins":[{"class":"passive","designator":"1","id":"P1","type":"passive"},{"class":"passive","designator":"2","id":"P2","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.resistor","version":"1.0.0"},{"interface":{"params":[],"pins":[{"class":"passive","designator":"B","id":"B","type":"passive"},{"class":"passive","designator":"C","id":"C","type":"passive"},{"class":"passive","designator":"E","id":"E","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.tip120","version":"1.0.0"},{"interface":{"params":[],"pins":[{"class":"passive","designator":"+","id":"PLUS","type":"passive"},{"class":"passive","designator":"-","id":"MINUS","type":"passive"}],"role":"part"},"origin":"builtin","ref":"core.tt-motor","version":"1.0.0"}],"libraries":[]},"ext":{"x-iynk-solution":"const int BUTTON = 2;\nconst int MOTOR = 9;\nconst unsigned long DEBOUNCE_MS = 30;\nbool motorOn = false;\nint lastReading = HIGH;\nint stableState = HIGH;\nunsigned long lastChange = 0;\n\nvoid setup() {\n  pinMode(BUTTON, INPUT_PULLUP);\n  pinMode(MOTOR, OUTPUT);\n}\n\nvoid loop() {\n  int reading = digitalRead(BUTTON);\n  if (reading != lastReading) {\n    lastChange = millis();\n    lastReading = reading;\n  }\n  if (millis() - lastChange > DEBOUNCE_MS && reading != stableState) {\n    stableState = reading;\n    if (stableState == LOW) {\n      motorOn = !motorOn;\n      digitalWrite(MOTOR, motorOn ? HIGH : LOW);\n    }\n  }\n}\n"},"format":"iynk.project","guide":{"hints":[{"de":"Notier die Zeit, wann immer sich der rohe Messwert ändert.","en":"Note the time whenever the raw reading changes.","es":"Apunta la hora cada vez que cambie la lectura en bruto.","fr":"Notez l'heure chaque fois que la lecture brute change.","hi":"जब भी कच्ची रीडिंग बदले, समय नोट करें।","zh":"每当原始读数变化时，记下时间。"},{"de":"Übernimm einen neuen Zustand erst, wenn der Messwert 30 ms lang gleich geblieben ist.","en":"Accept a new state only after the reading has stayed the same for 30 ms.","es":"Acepta un estado nuevo solo después de que la lectura se haya mantenido igual durante 30 ms.","fr":"N'acceptez un nouvel état qu'une fois que la lecture est restée la même pendant 30 ms.","hi":"नई स्थिति तभी मानें जब रीडिंग 30 ms तक एक-सी रही हो।","zh":"只有当读数保持不变达到 30 ms 后，才接受新的状态。"},{"de":"Schalte nur beim Wechsel auf LOW um: Das ist das Drücken, nicht das Loslassen.","en":"Toggle on the change to LOW only: that is the press, not the release.","es":"Conmuta solo en el cambio a LOW: eso es la pulsación, no la suelta.","fr":"Ne basculez que sur le passage à LOW : c'est l'appui, pas le relâchement.","hi":"सिर्फ़ LOW में बदलने पर पलटें: वही दबाव है, छोड़ना नहीं।","zh":"只在变为 LOW 时切换：那是按下，而不是松开。"}],"kind":"challenge","lede":{"de":"Ein Taster von D2 nach Masse (INPUT_PULLUP) schaltet den Motor um: einmal drücken für an, noch einmal für aus. Die Kontakte prellen ein paar Millisekunden lang, und der Starter-Sketch zählt jedes Prellen als Druck. Entprell ihn mit millis().","en":"A push button from D2 to ground (INPUT_PULLUP) toggles the motor: press once for on, again for off. The contacts bounce for a few milliseconds, and the starter sketch counts every bounce as a press. Debounce it with millis().","es":"Un pulsador de D2 a tierra (INPUT_PULLUP) conmuta el motor: pulsa una vez para encenderlo y otra para apagarlo. Los contactos rebotan durante unos milisegundos, y el sketch inicial cuenta cada rebote como una pulsación. Ponle antirrebote con millis().","fr":"Un bouton-poussoir de D2 vers la masse (INPUT_PULLUP) fait basculer le moteur : un appui pour le mettre en marche, un autre pour l'arrêter. Les contacts rebondissent pendant quelques millisecondes, et le sketch de départ compte chaque rebond comme un appui. Ajoutez un anti-rebond avec millis().","hi":"D2 से ग्राउंड तक एक पुश बटन (INPUT_PULLUP) मोटर को पलटता है: एक बार दबाएँ तो चालू, फिर दबाएँ तो बंद। कॉन्टैक्ट कुछ मिलीसेकंड तक उछलते हैं, और शुरुआती स्केच हर उछाल को एक दबाव गिनता है। millis() से इसे डिबाउंस करें।","zh":"一个从 D2 接到地的按钮（INPUT_PULLUP）切换电机：按一次打开，再按一次关闭。触点会抖动几毫秒，起始程序把每一次抖动都算作一次按下。用 millis() 给它消抖。"},"legacyFigure":{"circuit":"toggle-button","page":"/figures/boards/nano.html","sheets":["board","breadboard","schematic","power"]},"starter":{"source":"src_sketch","template":"// Each press should toggle the motor once. Bouncing contacts break this.\nconst int BUTTON = 2;\nconst int MOTOR = 9;\nbool motorOn = false;\nint last = HIGH;\n\nvoid setup() {\n  pinMode(BUTTON, INPUT_PULLUP);   // pressed = LOW\n  pinMode(MOTOR, OUTPUT);\n}\n\nvoid loop() {\n  int now = digitalRead(BUTTON);\n  if (last == HIGH && now == LOW) {  // a bounce looks exactly like another press\n    motorOn = !motorOn;\n    digitalWrite(MOTOR, motorOn ? HIGH : LOW);\n  }\n  last = now;\n}\n"},"title":{"de":"Umschalttaster mit Entprellung","en":"Toggle button with debounce","es":"Botón conmutador con antirrebote","fr":"Bouton bascule avec anti-rebond","hi":"डिबाउंस वाला टॉगल बटन","zh":"带消抖的切换按钮"}},"history":{"baseChain":"abd22bb49963b8875f9d806b1d6642b0f8ab6a78c60b83b7b767479bd9148c5c","baseRevision":0,"checkpoints":[],"ops":[]},"id":"prj_robotics-transistor-switch-toggle-button","license":{"spdx":"LicenseRef-iynk-pending"},"meta":{"createdAt":"2026-01-01T00:00:00.000Z","description":"A push button from D2 to ground (INPUT_PULLUP) toggles the motor: press once for on, again for off. The contacts bounce for a few milliseconds, and the starter sketch counts every bounce as a press. Debounce it with millis().","kind":"challenge","locale":"en","tags":["transistor-switch","challenge","nano"],"title":"Toggle button with debounce","updatedAt":"2026-01-01T00:00:00.000Z"},"nets":[{"class":"signal","connections":[{"c":"cmp_bt1","p":"PLUS"},{"c":"cmp_d1","p":"K"},{"c":"cmp_m1","p":"PLUS"}],"id":"net_bt1plus_d1k_m1plus"},{"class":"signal","connections":[{"c":"cmp_d1","p":"A"},{"c":"cmp_m1","p":"MINUS"},{"c":"cmp_q1","p":"C"}],"id":"net_d1a_m1minus_q1c"},{"class":"signal","connections":[{"c":"brd_main","p":"D2"},{"c":"cmp_sw1","p":"P1"}],"id":"net_d2","name":"D2"},{"class":"signal","connections":[{"c":"brd_main","p":"D9"},{"c":"cmp_r1","p":"P1"},{"c":"cmp_r2","p":"P2"}],"id":"net_d9","name":"D9"},{"class":"ground","connections":[{"c":"brd_main","p":"GND"},{"c":"cmp_bt1","p":"MINUS"},{"c":"cmp_led1","p":"K"},{"c":"cmp_q1","p":"E"},{"c":"cmp_sw1","p":"P