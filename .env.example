# SimLab server settings (HX-CONTRACT H1). Copy to .env.local and fill in what you have.
# Every variable is optional: a feature without its key shows "not set up on this deployment".
# Only NEXT_PUBLIC_* values reach the browser. Never commit real keys.

# Meta Model API key from dev.meta.ai/api-keys (Muse Spark chat, vision, audio; Muse Image; Voice Transcribe).
META_API_KEY=
# Meta's OpenAI-compatible base URL.
META_API_BASE=https://api.meta.ai/v1
# Chat, vision and audio-input model id.
META_MODEL=muse-spark-1.1
# Muse Image model id for POST /v1/images/generations.
META_IMAGE_MODEL=muse-image-1.0
# Muse Voice Transcribe model id for POST /v1/asr/transcribe.
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Optional second provider for text when Meta fails (Gemini's OpenAI-compatible endpoint).
GEMINI_API_KEY=
# Gemini model used for that fallback.
GEMINI_MODEL=gemini-3.8-flash

# SerpApi key for live prices, places, events, videos and datasheets.
SERPAPI_KEY=
# Uncached SerpApi searches allowed per server process before refusing new ones.
SERPAPI_MONTHLY_BUDGET=200

# Server-side Solana RPC (devnet only).
SOLANA_RPC_URL=https://api.devnet.solana.com
# Issuer, fee payer and faucet treasury: a JSON array of 64 numbers (solana-keygen output). Devnet only.
SOLANA_ISSUER_KEYPAIR=
# Solana cluster shown to the browser; SimLab only runs on devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Browser-side Solana RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Deployed simlab_passport program id (docs/hacktx/SOLANA.md).
NEXT_PUBLIC_SOLANA_PROGRAM_ID=

# Tiger Data (Postgres + Timescale) connection string for telemetry, leaderboards and buddies.
DATABASE_URL=

# wss://…/ws address of the realtime relay; without it rooms fall back to tabs in one browser.
NEXT_PUBLIC_REALTIME_URL=
# Public origin for share links, the MCP connector and OpenAPI servers.
# Unset or blank: http://localhost:3000 (server code and share links built off the
# browser). A link built in the browser uses that page's origin. On a public
# deploy, set the https origin with no trailing slash before the build.
# NEXT_PUBLIC_* is inlined at build time and does not change on next start.
# Canonical, hreflang and metadataBase use siteUrl(), not this name: SITE_URL,
# else https://$VERCEL_PROJECT_PRODUCTION_URL, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deploy scripts only; the app never reads these.
VULTR_API_KEY=
VULTR_HOST=
