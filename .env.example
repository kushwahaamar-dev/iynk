# iynk settings. Copy this file to .env.local; every variable is optional.
# This file holds names only. Never commit keys.

# Meta Model API: chat, vision, audio.
META_API_BASE=
META_MODEL=
META_TRANSCRIBE_MODEL=

# Gemini model, used when IYNK_AI_PROVIDER is gemini.
GEMINI_MODEL=

# wss address of the realtime relay. Without it, rooms stay inside one browser.
NEXT_PUBLIC_REALTIME_URL=

# Public origin for share links and canonical URLs, no trailing slash.
# NEXT_PUBLIC_SITE_URL is inlined at build time.
NEXT_PUBLIC_SITE_URL=
SITE_URL=

# Server token, at least 32 random bytes, for example: openssl rand -base64 48
IYNK_SERVER_TOKEN=
# 1 turns the module on. Default off. People bring their own keys.
IYNK_AI_ENABLE=
IYNK_SEARCH_ENABLE=
# Which provider the AI module talks to: meta or gemini. Default meta.
IYNK_AI_PROVIDER=
# Tokens one key may use per day, and searches per month. 0 allows none.
IYNK_AI_DAILY_TOKENS=
IYNK_SEARCH_MONTHLY=
# Folder for local server data. Default .iynk-data
IYNK_DATA_DIR=
# Comma separated origins the browser may connect to, besides this site.
IYNK_CONNECT_ORIGINS=
# Public address of this server, when a client is hosted elsewhere.
IYNK_SERVER_URL=
# 1 only behind a proxy you control.
IYNK_TRUST_PROXY=
# Development only: 1 lets a build skip the type check.
IYNK_BUILD_SKIP_TYPECHECK=
