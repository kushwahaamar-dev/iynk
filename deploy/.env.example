# Copy to deploy/.env and set your own values. Nothing here is a secret; keep it that way.

# The domain Caddy gets a certificate for. Point its DNS at this machine first.
IYNK_DOMAIN=iynk.example.com

# How people join the server: "code" needs an enrolment code, "closed" admits nobody new.
IYNK_ENROL=code

# debug, info, warn or error.
IYNK_LOG_LEVEL=info

# Ports Caddy listens on.
IYNK_HTTP_PORT=80
IYNK_HTTPS_PORT=443
