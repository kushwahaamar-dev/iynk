# Files that stay on this machine.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js (agents build into .next-<label>/ with NEXT_DIST_DIR)
/.next/
.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode from the figure tools
__pycache__/
