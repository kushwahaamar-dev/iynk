  "behaviour": {
    "summary": {
      "en": "A register-level I2C slave at 0x68 or 0x69. It wakes asleep and reads zero until the host clears the sleep bit. Readings are the world's acceleration, rate and temperature scaled by the selected range, plus a constant gyro bias."
    },
    "layers": [
      {
        "id": "ldo",
        "domain": "power",
        "reads": ["VCC"],
        "drives": ["V3V3"],
        "summary": {"en": "662K regulator: 3.3 V from VCC."},
        "model": {
          "kind": "builtin",
          "ref": "power:linear-regulator@1",
          "params": {
            "output": {"from_rating": "ldo_output", "pick": "typ"},
            "dropout": {"from_rating": "ldo_dropout", "pick": "max"},
            "input_max": {"from_rating": "vcc_abs_max", "pick": "max"}
          }
        }
      },
      {
        "id": "imu",
        "domain": "protocol",
        "reads": ["SCL", "SDA", "AD0", "accel", "gyro", "die_temp", "no_cpout_cap"],
        "drives": ["SDA", "INT"],
        "summary": {"en": "Register map of the MPU-6050 for the sample registers, range selects, sleep and reset bits and WHO_AM_I."},
        "model": {
          "kind": "builtin",
          "ref": "device:mpu6050@1",
          "params": {
            "accel_lsb_per_g_fs0": {
              "value": 16384,
              "unit": "1",
              "source": {"src": "ps_mpu", "loc": "Accelerometer sensitivity scale factor, AFS_SEL = 0"},
              "rationale": {"en": "Datasheet value. The other ranges halve it: 8192, 4096, 2048."}
            },
            "gyro_lsb_per_dps_fs0": {
              "value": 131,
              "unit": "1",
              "source": {"src": "ps_mpu", "loc": "Gyroscope sensitivity scale factor, FS_SEL = 0"},
              "rationale": {
                "en": "Datasheet value. The other ranges halve it; the code uses 131 / 2^n where the datasheet prints 65.5, 32.8 and 16.4."
              }
            },
            "temp_lsb_per_degc": {
              "value": 340,
              "unit": "1",
              "source": {"src": "rm_mpu", "loc": "TEMP_OUT: T = TEMP_OUT / 340 + 36.53"},
              "rationale": {"en": "Register map formula."}
            },
            "temp_offset": {
              "value": 36.53,
              "unit": "degC",
              "source": {"src": "rm_mpu", "loc": "TEMP_OUT"},
              "rationale": {"en": "Register map formula."}
            },
            "gyro_bias_x": {
              "value": 0.6,
              "unit": "deg_per_s",
              "source": {"src": "devicets", "loc": "src/lib/interp/devices.ts: gyroBias"},
              "rationale": {
                "en": "A constant bias chosen inside the datasheet's plus or minus 20 deg/s tolerance, so integrating the raw rate drifts as a real part does."
              }
            },
            "gyro_bias_y": {
              "value": -0.4,
              "unit": "deg_per_s",
              "source": {"src": "devicets", "loc": "src/lib/interp/devices.ts: gyroBias"},
              "rationale": {"en": "As gyro_bias_x."}
            },
            "gyro_bias_z": {
              "value": 0.25,
              "unit": "deg_per_s",
              "source": {"src": "devicets", "loc": "src/lib/interp/devices.ts: gyroBias"},
              "rationale": {"en": "As gyro_bias_x."}
            }
          },
          "implementation": {
            "path": "src/lib/interp/devices.ts",
            "note": "class Mpu6050, lines 21-102. Implements I2CDevice. The figure's separate sample text lives in figures/modules/mpu6050.js and is not this model."
          }
        }
      },
      {
        "id": "power_led",
        "domain": "optical",
        "reads": ["VCC"],
        "summary": {"en": "The red power LED lights when the regulator output is live."},
        "model": {
          "kind": "builtin",
          "ref": "indicator:rail-led@1",
          "params": {
            "series_ohms": {"from_rating": "power_led_series_ohms", "pick": "value"},
            "colour": {
              "value": "red",
              "rationale": {"en": "Assumed red. The photo shows the LED unlit and the original simulation used green."}
            }
          },
          "implementation": {"path": "figures/modules/mpu6050.js", "note": "Part D1, led: { rail: '3V3', via: ['R201'] }."}
        }
      }
    ]
  },
  "failure_modes": [
    {
      "id": "supply_too_high",
      "name": {"en": "Regulator over-voltage"},
      "cause_id": "x-mpu6050.supply-too-high",
      "symptom_ids": ["part-dead", "part-hot"],
      "when": [{"measure": "pin_voltage", "target": "VCC", "op": ">", "threshold": {"rating": "vcc_abs_max", "pick": "max"}}],
      "effect": {"state": "burnt", "latched": true, "recovers_when": "the board is replaced"},
      "derivation": {
        "en": "The 662K regulator's maximum input is 6 V on the Torex excerpt (8 V on a second source). The model takes the lower figure."
      },
      "basis": "manufacturer",
      "source": {"src": "modulejs", "loc": "figures/modules/mpu6050.js: elec.pins.VCC max: 6"},
      "implemented_as": "threshold"
    },
    {
      "id": "reversed_supply_burn",
      "name": {"en": "Reversed supply"},
      "cause_id": "reverse-polarity",
      "symptom_ids": ["part-dead", "part-hot"],
      "when": [{"measure": "pin_voltage_reverse", "target": "VCC", "op": ">", "threshold": {"literal": {"unit": "V", "value": 0.7}}}],
      "effect": {"state": "burnt", "latched": true, "recovers_when": "the board is replaced"},
      "derivation": {
        "en": "There is no protection diode, so current flows backwards through the regulator and the chip's ESD diodes above one diode drop (0.7 V, an iynk estimate). The fact sheet says a few seconds at 5 V usually kills the regulator and can kill the sensor."
      },
      "basis": "simulation-assumption",
      "source": {"src": "factsheet", "loc": "section 6, reverse polarity"},
      "implemented_as": "scripted"
    },
    {
      "id": "five_volt_on_logic_pin",
      "name": {"en": "5 V on a 3.3 V logic pin"},
      "cause_id": "x-mpu6050.5v-on-logic-pin",
      "symptom_ids": ["x-i2c-odd-currents", "x-sensor-latent-damage"],
      "when": [{"measure": "pin_voltage", "target": "AD0", "op": ">", "threshold": {"rating": "logic_input_abs_max", "pick": "max"}}],
      "effect": {
        "state": "degraded",
        "latched": true,
        "detail": {
          "en": "Current flows into the pin's protection diode and back-powers the 3.3 V rail. The sensor often still works at first."
        }
      },
      "derivation": {
        "en": "The pins are limited to VDD + 0.5 V, 3.8 V. Wiring AD0 to 5 V to pick 0x69 is the usual way to exceed it; the same holds for SDA and SCL pulled to 5 V."
      },
      "basis": "manufacturer",
      "source": {"src": "ps_mpu", "loc": "Absolute maximum ratings"},
      "implemented_as": "not-implemented"
    }
