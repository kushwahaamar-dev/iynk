  "simulation": {
    "tier": "T1",
    "status": "partly-modelled",
    "what_it_models": [
      {"en": "The truth table of each channel: drive, brake and coast, with the enable as a duty from 0 to 1."},
      {
        "en": "The voltage lost in the switches, fitted to the datasheet typical totals at 1 A and 2 A, so the motor sees about 4.85 V from a 7.4 V pack at 1 A."
      },
      {"en": "The 5V-EN regulator: 5 V output, or the supply minus 2 V when the supply is low."},
      {"en": "Heat in the chip and the temperature rise to a steady state."},
      {"en": "Over-voltage and under-voltage thresholds that the board is known to have."}
    ],
    "not_modelled": [
      {"en": "Motor back-EMF, inductance and the flyback current through the eight diodes."},
      {"en": "Switching loss, PWM frequency limits and ripple."},
      {"en": "Damage above 2 A, shorted outputs and any current limit."},
      {"en": "Thermal time constants: temperature jumps to its steady value."},
      {"en": "The analog level on the inputs: a pin is read as 0 or 1 from the program."},
      {"en": "Clone chips and part-to-part variation."}
    ],
    "validity": [
