    "generic": true,
    "kind": "discrete",
    "category": "semiconductor",
    "description": {
      "i18n_key": "parts.led-5mm.description",
      "en": "A 5 mm through-hole light-emitting diode in red, yellow, green, blue or white. The longer leg is the anode."
    },
    "legacy_ids": ["led"],
    "tags": ["led", "diode", "indicator", "breadboard"]
  },
  "sources": [
    {
      "id": "factsheet",
      "kind": "fact-sheet",
      "title": "Board Lab components fact sheet, section 4: 5 mm LEDs",
      "publisher": "iynk",
      "revision": "2026-10-24",
      "reliability": "secondary",
      "note": "docs/facts/la-components.md. It says typical colour values and that maker datasheets vary, and marks the 20 to 30 mA ceiling unverified."
    },
    {
      "id": "partjs",
      "kind": "own-estimate",
      "title": "figures/parts/led.js: forward voltage per colour, 20 mA continuous, brightness curve",
      "publisher": "iynk",
      "reliability": "unverified",
      "note": "The header comment cites the Learn Arduino lesson for the brightness curve."
    },
    {
      "id": "solverjs",
      "kind": "own-estimate",
      "title": "figures/engine/bench-solve.js: LED dynamic resistance and burn rule",
      "publisher": "iynk",
