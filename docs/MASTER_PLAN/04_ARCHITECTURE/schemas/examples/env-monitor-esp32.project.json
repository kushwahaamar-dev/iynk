  "sources": [
    {
      "board": "brd_esp",
      "content": "#pragma once\n#include <Adafruit_SSD1306.h>\n\nstatic Adafruit_SSD1306 oled(128, 64, &Wire, -1);\n\ninline void displayBegin() {\n  oled.begin(SSD1306_SWITCHCAPVCC, 0x3C);\n  oled.clearDisplay();\n}\n\ninline void displayShow(float t, float h) {\n  oled.clearDisplay();\n  oled.setTextSize(2);\n  oled.setTextColor(SSD1306_WHITE);\n  oled.setCursor(0, 0);\n  oled.print(t, 1);\n  oled.println(\" C\");\n  oled.print(h, 0);\n  oled.println(\" %\");\n  oled.display();\n}\n",
      "id": "src_display",
      "language": "cpp",
      "path": "display.h",
      "role": "firmware"
    },
    {
      "board": "brd_esp",
      "content": "#include <Wire.h>\n#include <Adafruit_BME280.h>\n#include \"display.h\"\n\nAdafruit_BME280 bme;\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial.println(\"boot\");\n  Wire.begin(21, 22);\n  if (!bme.begin(0x76)) {\n    Serial.println(\"BME280 not found\");\n    while (true) delay(1000);\n  }\n  displayBegin();\n}\n\nvoid loop() {\n  float t = bme.readTemperature();\n  float h = bme.readHumidity();\n  Serial.print(\"T=\");\n  Serial.print(t, 1);\n  Serial.print(\" H=\");\n  Serial.println(h, 0);\n  displayShow(t, h);\n  delay(1000);\n}\n",
      "id": "src_main",
      "language": "arduino-cpp",
      "path": "monitor.ino",
      "role": "firmware"
    },
    {
      "content": "# Environmental monitor\n\nI2C addresses: BME280 0x76 (SDO to GND), SSD1306 0x3C.\n",
