  "format": "iynk.project",
  "guide": {
    "callouts": [
      {
        "target": "BTN1",
        "text": {
          "de": "Ein Druck verbindet Spalte 8 (5 V) mit Spalte 10 (D2).",
          "en": "Pressing joins column 8 (5 V) to column 10 (D2).",
          "es": "Al pulsar se une la columna 8 (5 V) con la columna 10 (D2).",
          "fr": "Un appui relie la colonne 8 (5 V) à la colonne 10 (D2).",
          "hi": "दबाने पर कॉलम 8 (5 V) कॉलम 10 (D2) से जुड़ जाता है।",
          "zh": "按下时把第 8 列（5 V）和第 10 列（D2）连通。"
        }
      },
      {
        "target": "RES1",
        "text": {
          "de": "Pull-down: Ohne ihn hängt D2 in der Luft und liest Zufallswerte.",
          "en": "Pull-down: without it D2 floats and reads at random.",
          "es": "Pull-down: sin ella, D2 queda flotando y lee valores al azar.",
          "fr": "Pull-down : sans elle, D2 flotte et lit n'importe quoi.",
          "hi": "पुल-डाउन: इसके बिना D2 तैरता रहता है और बेतरतीब मान पढ़ता है।",
          "zh": "下拉电阻：没有它，D2 处于悬空状态，读数是随机的。"
        }
      },
      {
        "target": "LED1",
        "text": {
          "de": "Leuchtet über D13.",
          "en": "Lit by D13.",
          "es": "Lo enciende D13.",
          "fr": "Allumée par D13.",
          "hi": "D13 से जलती है।",
          "zh": "由 D13 点亮。"
        }
      },
      {
        "target": "IOL",
        "text": {
          "de": "D2 liegt auf der rechten Buchsenleiste.",
          "en": "D2 is on the right-hand header.",
          "es": "D2 está en el conector de la derecha.",
          "fr": "D2 est sur le connecteur de droite.",
          "hi": "D2 दाईं ओर वाले हेडर पर है।",
          "zh": "D2 在右侧的排针上。"
        }
      }
    ],
    "features": [
      {
        "icon": "play",
        "text": {
          "de": "Drück den Taster in der Abbildung, während der Code läuft",
          "en": "Press the button in the figure while the code runs",
          "es": "Pulsa el botón en la figura mientras se ejecuta el código",
          "fr": "Appuyez sur le bouton dans la figure pendant que le code tourne",
          "hi": "कोड चलते समय चित्र में बटन दबाएँ",
          "zh": "代码运行时，在图上按下按钮"
        }
      },
      {
        "icon": "info",
        "text": {
          "de": "Warum ein offener Eingang Unsinn liest",
          "en": "Why a floating input reads nonsense",
          "es": "Por qué una entrada flotante lee tonterías",
          "fr": "Pourquoi une entrée flottante lit n'importe quoi",
          "hi": "तैरता हुआ इनपुट बेतुकी रीडिंग क्यों देता है",
          "zh": "为什么悬空的输入会读出乱七八糟的值"
        }
      },
      {
        "icon": "tip",
        "text": {
          "de": "Halten oder umschalten: Ein Chip ändert die Logik",
          "en": "Hold or toggle: one chip changes the logic",
          "es": "Mantener o alternar: una opción cambia la lógica",
          "fr": "Maintien ou bascule : une pastille change la logique",
          "hi": "दबाए रखें या टॉगल करें: एक चिप लॉजिक बदल देती है",
          "zh": "按住还是切换：一个开关就能改变逻辑"
        }
      }
    ],
    "hints": [
      {
        "de": "Nimm den Pull-down heraus, und D2 fängt Störungen von deinem Finger ein: Die LED flackert von selbst.",
        "en": "Take the pull-down out and D2 picks up noise from your finger: the LED flickers on its own.",
        "es": "Quita la pull-down y D2 capta el ruido de tu dedo: el LED parpadea solo.",
        "fr": "Retirez le pull-down et D2 capte le bruit de votre doigt : la LED vacille toute seule.",
        "hi": "पुल-डाउन निकाल दें तो D2 आपकी उँगली से नॉइज़ पकड़ लेता है: LED अपने-आप टिमटिमाने लगती है।",
        "zh": "拿掉下拉电阻，D2 会从你的手指上拾取噪声：LED 自己就闪起来了。"
      },
      {
        "de": "Kontakte prellen ein paar ms lang. Ohne die 30 ms Wartezeit kann ein einziger Druck die LED mehrmals umschalten.",
        "en": "Contacts bounce for a few ms. Without the 30 ms wait, one press can toggle the LED several times.",
        "es": "Los contactos rebotan durante unos ms. Sin la espera de 30 ms, una sola pulsación puede cambiar el LED varias veces.",
        "fr": "Les contacts rebondissent pendant quelques ms. Sans l'attente de 30 ms, un seul appui peut inverser la LED plusieurs fois.",
        "hi": "कॉन्टैक्ट कुछ ms तक उछलते हैं। 30 ms के इंतज़ार के बिना एक ही दबाव LED को कई बार पलट सकता है।",
        "zh": "触点会抖动几毫秒。没有 30 ms 的等待，按一次可能让 LED 切换好几次。"
      },
      {
        "de": "Mit INPUT_PULLUP könntest du den Widerstand weglassen, aber dann liest ein Druck LOW.",
        "en": "INPUT_PULLUP would let you skip the resistor, but then pressed reads LOW.",
        "es": "Con INPUT_PULLUP te ahorrarías la resistencia, pero entonces pulsado lee LOW.",
        "fr": "INPUT_PULLUP vous éviterait la résistance, mais alors un appui se lit LOW.",
        "hi": "INPUT_PULLUP से आप रेज़िस्टर छोड़ सकते हैं, लेकिन तब दबाने पर LOW पढ़ा जाता है।",
        "zh": "用 INPUT_PULLUP 可以省掉电阻，但那样按下时读到的是 LOW。"
      }
    ],
    "kind": "lesson",
    "lede": {
      "de": "Endlich ein Eingang: Ein Taster an D2 entscheidet, wann die LED an D13 leuchtet. Halt ihn gedrückt, damit die LED leuchtet, oder stell den Code so um, dass jeder Druck sie umschaltet.",
      "en": "An input at last: a push button on D2 decides when the LED on D13 lights. Hold it to light the LED, or switch the code so each press toggles it.",
      "es": "Por fin una entrada: un pulsador en D2 decide cuándo se enciende el LED de D13. Mantenlo pulsado para encender el LED, o cambia el código para que cada pulsación lo encienda o lo apague.",
      "fr": "Enfin une entrée : un bouton-poussoir sur D2 décide quand la LED de D13 s'allume. Maintenez-le pour allumer la LED, ou modifiez le code pour que chaque appui l'inverse.",
      "hi": "आखिरकार एक इनपुट: D2 पर लगा पुश बटन तय करता है कि D13 वाली LED कब जले। LED जलाने के लिए उसे दबाए रखें, या कोड बदलें ताकि हर बार दबाने पर LED पलट जाए।",
      "zh": "终于有输入了：D2 上的按钮决定 D13 上的 LED 何时点亮。按住它点亮 LED，或者切换代码，让每按一次就切换一次。"
    },
