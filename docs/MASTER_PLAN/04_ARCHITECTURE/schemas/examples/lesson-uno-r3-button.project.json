  "sources": [
    {
      "board": "brd_uno",
      "content": "const int BUTTON = 2;\nconst int LED = 13;\n\nint last = LOW;    // the reading from the last loop\nbool lit = false;  // is the LED on? (toggle mode)\n\nvoid setup() {\n  pinMode(BUTTON, INPUT);  // the 10 kΩ pull-down holds D2 LOW\n  pinMode(LED, OUTPUT);\n}\n\nvoid loop() {\n  int now = digitalRead(BUTTON);\n  digitalWrite(LED, now);\n  last = now;\n}\n",
      "id": "src_sketch",
      "language": "arduino-cpp",
      "path": "sketch.ino",
      "role": "firmware"
    }
  ],
